    {
      "schema_stable_id": "archeology_scan_large:column:processing:flowstage",
      "name": "flowstage",
      "label": "Processing Stage"
    }
  ],
  "derived_fields": [
    {
      "hkb_stable_id": "archeology_scan_large:hkb:0",
      "sql": "CASE WHEN ${scan_resolution_mm} > 0 AND ${point_density} > 0 AND ${point_density} <> 1 THEN 5.0 * LN(${scan_resolution_mm} * 1000.0) / NULLIF(LN(${point_density}), 0) END"
    },
    {
      "hkb_stable_id": "archeology_scan_large:hkb:1",
      "sql": "${coverage_pct} * (1.0 + (${overlap_pct} / 100.0) * (1.0 - ${coverage_pct} / 100.0))"
    },
    {
      "hkb_stable_id": "archeology_scan_large:hkb:3",
      "sql": "CASE WHEN ${scan_resolution_index} > 0 THEN POWER(10.0 / ${scan_resolution_index}, 1.5) * (${scan_coverage_effectiveness} / 100.0) * POWER(1.0 - ${noise_db} / 30.0, 2.0) END"
    },
    {
      "hkb_stable_id": "archeology_scan_large:hkb:4",
      "sql": "CASE WHEN ${mesh_vertices} <> 0 AND ${mesh_resolution_mm} <> 0 THEN ${mesh_faces} / (${mesh_vertices} * POWER(${mesh_resolution_mm}, 2.0)) * 1000.0 END"
    },
    {
      "hkb_stable_id": "archeology_scan_large:hkb:5",
      "sql": "CASE WHEN ${mesh_faces} > 0 AND ${mesh_resolution_mm} <> 0 THEN ${texture_size_px} / (SQRT(${mesh_faces}) * ${mesh_resolution_mm}) * 0.01 END"
    },
    {
      "hkb_stable_id": "archeology_scan_large:hkb:6",
      "sql": "${mesh_complexity_ratio} * (${texture_density_index} / 10.0) * (1.0 + EXP(-${geometric_accuracy_mm}))"
    },
    {
      "hkb_stable_id": "archeology_scan_large:hkb:7",
      "sql": "CASE WHEN ${light_lux} <> -100 THEN 100.0 - 2.5 * ABS(${ambient_temperature_c} - 20.0) - POWER(ABS((${relative_humidity_pct} - 50.0) / 2.0), 1.5) - 600.0 / (${light_lux} + 100.0) END"
    },
    {
      "hkb_stable_id": "archeology_scan_large:hkb:10",
      "sql": "${scan_resolution_mm} <= 1.0 AND ${point_density} >= 1000.0"
    },
    {
      "hkb_stable_id": "archeology_scan_large:hkb:11",
      "sql": "${coverage_pct} >= 95.0 AND ${overlap_pct} >= 30.0"
    },
    {
      "hkb_stable_id": "archeology_scan_large:hkb:12",
      "sql": "${is_high_resolution_scan} AND ${has_comprehensive_coverage} AND ${scan_quality_score} > 7.5"
    },
    {
      "hkb_stable_id": "archeology_scan_large:hkb:13",
      "sql": "${mesh_complexity_ratio} > 5.0 AND ${mesh_resolution_mm} < 1.0 AND ${geometric_accuracy_mm} < 0.5"
    },
    {
      "hkb_stable_id": "archeology_scan_large:hkb:15",
      "sql": "${environmental_suitability_index} > 85.0"
    },
    {
      "hkb_stable_id": "archeology_scan_large:hkb:18",
      "sql": "${registration_accuracy_mm} < 1.0 AND ${error_value_mm} < 2.0"
    },
    {
      "hkb_stable_id": "archeology_scan_large:hkb:50",
      "sql": "CASE WHEN ${environmental_suitability_index} IS NULL THEN NULL WHEN ${is_optimal_scanning_condition} THEN 'Optimal Scanning Conditions' WHEN ${environmental_suitability_index} >= 70.0 THEN 'Good Scanning Conditions' WHEN ${environmental_suitability_index} >= 50.0 THEN 'Acceptable Scanning Conditions' ELSE 'Challenging Scanning Conditions' END"
    }
  ]
}
