  "derived_fields": [
    {
      "hkb_stable_id": "museum_artifact_large:hkb:10",
      "sql": "(${average_daily_visitors} * CASE ${visitor_flow} WHEN 'Low' THEN 1.0 WHEN 'Medium' THEN 3.0 WHEN 'High' THEN 5.0 ELSE NULL END * ${average_dwell_minutes}) / 1000.0"
    },
    {
      "hkb_stable_id": "museum_artifact_large:hkb:55",
      "sql": "${insurance_value_usd} > 1000000.0"
    },
    {
      "hkb_stable_id": "museum_artifact_large:hkb:61",
      "sql": "CURRENT_DATE - ${scheduled_next_cleaning_date}"
