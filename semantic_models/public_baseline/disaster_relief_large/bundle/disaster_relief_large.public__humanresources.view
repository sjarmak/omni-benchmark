label: Human Resources
description: Human-resource records with row-level staff and volunteer footprint semantics.
catalog: disaster_relief_large
schema: public
table_name: humanresources
dimensions:
  total_staff:
    description: 'BIGINT. Total number of staff. **NULL means staff count not recorded.**. Example: 234.0.'
    label: Total Staff
    sql: CAST(${staffing_details} -> 'staff_counts' ->> 'total' AS DOUBLE PRECISION)
  volunteer_count:
    description: 'BIGINT. Total number of volunteers. Example: 435.0.'
    label: Volunteer Count
    sql: CAST(${staffing_details} -> 'staff_counts' ->> 'volunteers' AS DOUBLE PRECISION)
  total_humanitarian_footprint:
    label: Total Humanitarian Footprint (THF)
    description: A measure of the total personnel involved in the response, including staff and volunteers.
    sql: COALESCE(${total_staff}, 0.0) + COALESCE(${volunteer_count}, 0.0)
    ai_context: Use this modeled field for Total Humanitarian Footprint (THF); do not reconstruct its formula.
