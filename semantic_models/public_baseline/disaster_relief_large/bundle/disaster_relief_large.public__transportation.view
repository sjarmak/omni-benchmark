label: Transportation
description: Transportation records with row-level capacity, vehicle throughput, and last-mile status semantics.
catalog: disaster_relief_large
schema: public
table_name: transportation
dimensions:
  daily_tons:
    description: 'REAL. Daily delivery tonnage. Example: 227.'
    label: Daily Delivery Tonnage
    sql: '-- DO NOT PARSE

      CAST(${delivery_metrics} -> ''delivery_capacity'' ->> ''daily_tons'' AS DOUBLE PRECISION)'
  vehicle_count:
    description: 'BIGINT. Number of vehicles available. **NULL means vehicle count not recorded.**. Example: 141.0.'
    label: Vehicle Count
    sql: ${vehiclecount}
  last_mile_status:
    description: 'TEXT. Status of the last-mile delivery. Possible values: Delayed, On Track, Suspended.'
    label: Last-Mile Delivery Status
    sql: ${lastmilestatus}
    ai_context: 'Last-Mile Delivery Status: ''On Track'': Deliveries are proceeding as planned. ''Delayed'': Deliveries are facing obstacles and are behind schedule. ''Suspended'': Deliveries have been halted due to safety, access, or other critical issues.'
  logistical_throughput_per_vehicle:
    label: Logistical Throughput per Vehicle (LTV)
    description: Measures the average daily delivery capacity in tons per available transport vehicle.
    sql: ${daily_tons} / NULLIF(${vehicle_count}, 0)
    ai_context: Use this modeled field for Logistical Throughput per Vehicle (LTV); do not reconstruct its formula.
