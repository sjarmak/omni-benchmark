  "derived_fields": [
    {"hkb_stable_id":"disaster_relief_large:hkb:0","sql":"CASE WHEN ${affected_population} <> 0 THEN ${casualties} * 100.0 / ${affected_population} END"},
    {"hkb_stable_id":"disaster_relief_large:hkb:1","sql":"CASE WHEN ${affected_population} <> 0 THEN ${displaced_population} * 100.0 / ${affected_population} END"},
    {"hkb_stable_id":"disaster_relief_large:hkb:2","sql":"(COALESCE(${infrastructure_damage_pct}, 0.0) + COALESCE(${power_outage_pct}, 0.0) + COALESCE(${water_damage_pct}, 0.0)) / 3.0"},
    {"hkb_stable_id":"disaster_relief_large:hkb:6","sql":"${daily_tons} / NULLIF(${vehicle_count}, 0)"},
    {"hkb_stable_id":"disaster_relief_large:hkb:8","sql":"10.0 * COALESCE(${casualties}, 0.0) + 3.0 * COALESCE(${injured_population}, 0.0) + 2.0 * COALESCE(${missing_population}, 0.0) + COALESCE(${displaced_population}, 0.0)"},
    {"hkb_stable_id":"disaster_relief_large:hkb:15","sql":"(${report_compliance} + ${stakeholder_satisfaction} * 20.0 + ${data_quality_value} * 20.0) / 3.0"},
    {"hkb_stable_id":"disaster_relief_large:hkb:16","sql":"0.6 * ${population_impact_score} + 0.4 * ${infrastructure_damage_index}"},
    {"hkb_stable_id":"disaster_relief_large:hkb:17","sql":"COALESCE(${total_staff}, 0.0) + COALESCE(${volunteer_count}, 0.0)"},
    {"hkb_stable_id":"disaster_relief_large:hkb:30","sql":"${overall_disaster_severity_index} BETWEEN 500000.0 AND 2000000.0"},
    {"hkb_stable_id":"disaster_relief_large:hkb:33","sql":"${emergency_level} IN ('Red', 'Black')"},
    {"hkb_stable_id":"disaster_relief_large:hkb:34","sql":"${community_engagement_level} = 'High' AND ${distribution_equity_index} > 0.9"},
    {"hkb_stable_id":"disaster_relief_large:hkb:38","sql":"${compliance_state} = 'Compliant' AND ${audit_state} = 'Completed' AND ${quality_control_steps} = 'Strong'"},
    {"hkb_stable_id":"disaster_relief_large:hkb:51","sql":"${overall_disaster_severity_index} > 15000.0"},
    {"hkb_stable_id":"disaster_relief_large:hkb:56","sql":"(${hub_utilization_pct} / 100.0) + (${stock_turn_rate} / 10.0) > 1.5"}
