  "derived_fields": [
    {
      "hkb_stable_id": "labor_certification_applications_large:hkb:11",
      "sql": "CASE WHEN ${prevailing_annual_wage_usd} <> 0 THEN ((${offered_annual_wage_usd} - ${prevailing_annual_wage_usd}) / ${prevailing_annual_wage_usd}) * 100.0 END"
    },
    {
      "hkb_stable_id": "labor_certification_applications_large:hkb:16",
      "sql": "CASE WHEN ${worksite_count} <> 0 THEN CAST(${worker_positions} AS DOUBLE PRECISION) / ${worksite_count} END"
    },
    {
      "hkb_stable_id": "labor_certification_applications_large:hkb:40",
      "sql": "${wage_differential_rate} > 20.0"
    },
    {
      "hkb_stable_id": "labor_certification_applications_large:hkb:48",
      "sql": "CASE WHEN ${wage_differential_rate} IS NULL THEN NULL WHEN ${wage_differential_rate} < 0.0 THEN 'Below-Market' WHEN ${wage_differential_rate} <= 10.0 THEN 'Market-Competitive' ELSE 'Premium' END"
    }
