label: Quality Assessment
description: Inspection rows with public item-condition semantics.
catalog: reverse_logistics_large
schema: public
table_name: quality_assessment
dimensions:
  item_condition:
    description: 'TEXT. Condition of the item during inspection. Possible values: Damaged, Like New, New, Used.'
    label: Item Condition
    sql: ${assessment_summary} -> 'condition' ->> 'item_condition'
    ai_context: 'Item Condition States: There are 4 different states: ''New'', ''Like New'', ''Used'' and ''Damaged''.'
