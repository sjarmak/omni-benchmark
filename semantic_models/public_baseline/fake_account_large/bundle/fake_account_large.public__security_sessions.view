label: Security Sessions
description: Account-level security-session telemetry with public IP-reputation context.
catalog: fake_account_large
schema: public
table_name: security_sessions
dimensions:
  ip_reputation_score:
    description: 'REAL. IP reputation score. Example: 0.729.'
    label: IP Reputation Score
    sql: 'CAST(${session_telemetry} #>> ''{ip_reputation,ip_reputation_score}'' AS DOUBLE PRECISION)'
    ai_context: 'reputation scoring: Ranges from 0 to 1. Scores above 0.8 indicate trusted IPs, while scores below 0.3 suggest potentially malicious or compromised IPs.'
