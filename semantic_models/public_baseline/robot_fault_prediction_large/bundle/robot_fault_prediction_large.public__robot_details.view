label: robot_details
description: Public semantic view for robot_details.
catalog: robot_fault_prediction_large
schema: public
table_name: robot_details
dimensions:
  rd_installation_date:
    description: 'DATE. Installation date of the robot. Example: 10 Jun 2023.'
    label: RD.installation_date
  rd_reach_mm:
    description: 'BIGINT. Reach distance of the robot in millimeters. Example: 1592.'
    label: RD.reach_mm
  rd_payload_capacity_kg:
    description: 'REAL. Payload capacity of the robot in kilograms. Possible values: 3, 5, 10, 20, 50, 100, 200.'
    label: RD.payload_capacity_kg
    ai_context: 'Payload Capacity Class: Classes are: ''Light-Duty'' (< 20 kg), ''Medium-Duty'' (20-150 kg), or ''Heavy-Duty'' (>= 150 kg).'
  rd_firmware_version:
    description: 'TEXT. Firmware version of the robot. Example: 9.6.6.'
    label: RD.firmware_version
    ai_context: 'Firmware Lifecycle Stage: Stages are: ''Current'' (latest stable release), ''Supported'' (previous but supported), or ''End-of-Life'' (unsupported and a potential risk). All firmware versions starting with ''3.'' are considered End-of-Life.'
  rd_robot_type:
    description: 'text. Type of the robot (e.g., industrial, collaborative). Possible values: Articulated, Cartesian, Collaborative, Delta, SCARA.'
    label: RD.robot_type
    ai_context: 'Robot Architectures: Core robot architectures include: ''Articulated'', ''SCARA'', ''Delta'', and ''Cartesian''.'
  hkb_0:
    label: Robot Age
    description: Calculates the operational age of a robot in days since its commissioning date.
    sql: CURRENT_DATE - ${rd_installation_date}
    ai_context: Use this modeled field for Robot Age; do not reconstruct its formula.
  hkb_54:
    label: Legacy Robot
    description: Identifies a robot that is old and may be a candidate for replacement or major overhaul.
    sql: ${hkb_0} > 3650
    ai_context: Use this modeled field for Legacy Robot; do not reconstruct its formula.
