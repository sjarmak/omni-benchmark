label: joint_condition
description: Public semantic view for joint_condition.
catalog: robot_fault_prediction_large
schema: public
table_name: joint_condition
dimensions:
  jc_j1_temp:
    description: 'REAL. Joint 1 temperature value in Celsius. Example: 20.57.'
    label: JC.J1_temp
    sql: '${joint_health} #>> ''{J1,temperature_C}'''
  jc_j2_temp:
    description: 'REAL. Joint 2 temperature value in Celsius. Example: 39.54.'
    label: JC.J2_temp
    sql: '${joint_health} #>> ''{J2,temperature_C}'''
  jc_j3_temp:
    description: 'REAL. Joint 3 temperature value in Celsius. Example: 42.16.'
    label: JC.J3_temp
    sql: '${joint_health} #>> ''{J3,temperature_C}'''
  jc_j4_temp:
    description: 'REAL. Joint 4 temperature value in Celsius. Example: 34.88.'
    label: JC.J4_temp
    sql: '${joint_health} #>> ''{J4,temperature_C}'''
  jc_j5_temp:
    description: 'REAL. Joint 5 temperature value in Celsius. Example: 70.15.'
    label: JC.J5_temp
    sql: '${joint_health} #>> ''{J5,temperature_C}'''
  jc_j6_temp:
    description: 'REAL. Joint 6 temperature value in Celsius. Example: 64.39.'
    label: JC.J6_temp
    sql: '${joint_health} #>> ''{J6,temperature_C}'''
  jc_j1_vibration:
    description: 'REAL. Joint 1 vibration value in mm/s. Example: 1.14.'
    label: JC.J1_vibration
    sql: '${joint_health} #>> ''{J1,vibration_mmps}'''
  jc_j2_vibration:
    description: 'REAL. Joint 2 vibration value in mm/s. Example: 1.636.'
    label: JC.J2_vibration
    sql: '${joint_health} #>> ''{J2,vibration_mmps}'''
  jc_j3_vibration:
    description: 'REAL. Joint 3 vibration value in mm/s. Example: 1.687.'
    label: JC.J3_vibration
    sql: '${joint_health} #>> ''{J3,vibration_mmps}'''
  jc_j4_vibration:
    description: 'REAL. Joint 4 vibration value in mm/s. Example: 3.264.'
    label: JC.J4_vibration
    sql: '${joint_health} #>> ''{J4,vibration_mmps}'''
  jc_j5_vibration:
    description: 'REAL. Joint 5 vibration value in mm/s. Example: 2.052.'
    label: JC.J5_vibration
    sql: '${joint_health} #>> ''{J5,vibration_mmps}'''
  jc_j6_vibration:
    description: 'REAL. Joint 6 vibration value in mm/s. Example: 6.422.'
    label: JC.J6_vibration
    sql: '${joint_health} #>> ''{J6,vibration_mmps}'''
  jc_j1_backlash:
    description: 'REAL. Joint 1 backlash value in mm. Example: 0.0352.'
    label: JC.J1_backlash
    sql: '${joint_health} #>> ''{J1,backlash_deg}'''
  jc_j2_backlash:
    description: 'REAL. Joint 2 backlash value in mm. Example: 0.0272.'
    label: JC.J2_backlash
    sql: '${joint_health} #>> ''{J2,backlash_deg}'''
  jc_j3_backlash:
    description: 'REAL. Joint 3 backlash value in mm. Example: 0.0946.'
    label: JC.J3_backlash
    sql: '${joint_health} #>> ''{J3,backlash_deg}'''
  jc_j4_backlash:
    description: 'REAL. Joint 4 backlash value in mm. Example: 0.056.'
    label: JC.J4_backlash
    sql: '${joint_health} #>> ''{J4,backlash_deg}'''
  jc_j5_backlash:
    description: 'REAL. Joint 5 backlash value in mm. Example: 0.0907.'
    label: JC.J5_backlash
    sql: '${joint_health} #>> ''{J5,backlash_deg}'''
  jc_j6_backlash:
    description: 'REAL. Joint 6 backlash value in mm. Example: 0.046.'
    label: JC.J6_backlash
    sql: '${joint_health} #>> ''{J6,backlash_deg}'''
  hkb_15:
    label: Average Backlash
    description: Calculates the average mechanical backlash across all of the robot's joints, an indicator of gear wear.
    sql: (CAST(${jc_j1_backlash} AS DOUBLE PRECISION) + CAST(${jc_j2_backlash} AS DOUBLE PRECISION) + CAST(${jc_j3_backlash} AS DOUBLE PRECISION) + CAST(${jc_j4_backlash} AS DOUBLE PRECISION) + CAST(${jc_j5_backlash} AS DOUBLE PRECISION) + CAST(${jc_j6_backlash} AS DOUBLE PRECISION)) / 6.0
    ai_context: Use this modeled field for Average Backlash; do not reconstruct its formula.
  hkb_5:
    label: Average Joint Vibration
    description: Calculates the average vibration level across all of the robot's joints.
    sql: (CAST(${jc_j1_vibration} AS DOUBLE PRECISION) + CAST(${jc_j2_vibration} AS DOUBLE PRECISION) + CAST(${jc_j3_vibration} AS DOUBLE PRECISION) + CAST(${jc_j4_vibration} AS DOUBLE PRECISION) + CAST(${jc_j5_vibration} AS DOUBLE PRECISION) + CAST(${jc_j6_vibration} AS DOUBLE PRECISION)) / 6.0
    ai_context: Use this modeled field for Average Joint Vibration; do not reconstruct its formula.
  hkb_18:
    label: Mechanical Wear Score
    description: A calculated indicator that combines vibration and backlash data to estimate overall mechanical degradation.
    sql: 0.6 * ${hkb_5} + 0.4 * ${hkb_15}
    ai_context: Use this modeled field for Mechanical Wear Score; do not reconstruct its formula.
  hkb_34:
    label: Backlash Severity
    description: Categorizes joint backlash measurements into severity levels.
    sql: CASE WHEN ${hkb_15} < 0.01 THEN 'Low' WHEN ${hkb_15} <= 0.05 THEN 'Medium' ELSE 'High' END
    ai_context: Use this modeled field for Backlash Severity; do not reconstruct its formula.
  hkb_4:
    label: Average Joint Temperature
    description: Calculates the average temperature across all of the robot's joints.
    sql: (CAST(${jc_j1_temp} AS DOUBLE PRECISION) + CAST(${jc_j2_temp} AS DOUBLE PRECISION) + CAST(${jc_j3_temp} AS DOUBLE PRECISION) + CAST(${jc_j4_temp} AS DOUBLE PRECISION) + CAST(${jc_j5_temp} AS DOUBLE PRECISION) + CAST(${jc_j6_temp} AS DOUBLE PRECISION)) / 6.0
    ai_context: Use this modeled field for Average Joint Temperature; do not reconstruct its formula.
  hkb_9:
    label: Joint Temperature Differential
    description: Measures the temperature difference between the hottest and coolest joints, which can indicate localized issues.
    sql: GREATEST(CAST(${jc_j1_temp} AS DOUBLE PRECISION), CAST(${jc_j2_temp} AS DOUBLE PRECISION), CAST(${jc_j3_temp} AS DOUBLE PRECISION), CAST(${jc_j4_temp} AS DOUBLE PRECISION), CAST(${jc_j5_temp} AS DOUBLE PRECISION), CAST(${jc_j6_temp} AS DOUBLE PRECISION)) - LEAST(CAST(${jc_j1_temp} AS DOUBLE PRECISION), CAST(${jc_j2_temp} AS DOUBLE PRECISION), CAST(${jc_j3_temp} AS DOUBLE PRECISION), CAST(${jc_j4_temp} AS DOUBLE PRECISION), CAST(${jc_j5_temp} AS DOUBLE PRECISION), CAST(${jc_j6_temp} AS DOUBLE PRECISION))
    ai_context: Use this modeled field for Joint Temperature Differential; do not reconstruct its formula.
  hkb_43:
    label: Thermal Anomaly
    description: Identifies a potential thermal issue in a robot's joints based on temperature deviations.
    sql: ${hkb_4} > 75.0 OR ${hkb_9} > 15.0
    ai_context: Use this modeled field for Thermal Anomaly; do not reconstruct its formula.
  hkb_47:
    label: Mechanical Degradation Alert
    description: A composite alert for significant mechanical wear based on multiple indicators.
    sql: ${hkb_34} = 'High' OR ${hkb_5} > 3.0
    ai_context: Use this modeled field for Mechanical Degradation Alert; do not reconstruct its formula.
  hkb_62:
    label: Critical Condition Robot
    description: A robot that is simultaneously at risk from both thermal and mechanical issues.
    sql: ${hkb_43} AND ${hkb_47}
    ai_context: Use this modeled field for Critical Condition Robot; do not reconstruct its formula.
