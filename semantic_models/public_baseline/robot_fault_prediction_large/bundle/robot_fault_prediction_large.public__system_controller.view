label: system_controller
description: Public semantic view for system_controller.
catalog: robot_fault_prediction_large
schema: public
table_name: system_controller
dimensions:
  sc_overseer_load:
    description: 'REAL. Load value of the system overseer. Example: 0.99.'
    label: SC.overseer_load
    sql: overseerloadvalue
    ai_context: 'CPU Load Levels: CPU load is ''Normal'' if < 70%, ''High'' if 70%-90%, or ''Critical'' if > 90% (risks performance degradation).'
  sc_memory_usage:
    description: 'REAL. Memory usage of the system overseer. Example: 32.07.'
    label: SC.memory_usage
    sql: memuseval
  sc_cabinet_humidity:
    description: 'TEXT. Humidity level in the cabinet of the system overseer. Example: 47%.'
    label: SC.cabinet_humidity
    sql: cabhumiditylevel
    ai_context: 'Cabinet Humidity Risk: Humidity is ''Safe'' if < 60%, a ''Warning'' if 60%-80% (corrosion risk), or ''Danger'' if > 80% (risk of electrical faults).'
  hkb_6:
    label: Controller Stress Score
    description: A combined score representing the current processing and memory load on the system controller.
    sql: (${sc_overseer_load} + ${sc_memory_usage}) / 2.0
    ai_context: Use this modeled field for Controller Stress Score; do not reconstruct its formula.
