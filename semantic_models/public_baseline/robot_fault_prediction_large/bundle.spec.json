{
  "catalog": "robot_fault_prediction_large",
  "database": "robot_fault_prediction_large",
  "derived_fields": [
    {
      "hkb_stable_id": "robot_fault_prediction_large:hkb:0",
      "sql": "CURRENT_DATE - ${rd_installation_date}"
    },
    {
      "hkb_stable_id": "robot_fault_prediction_large:hkb:4",
      "sql": "(${jc_j1_temp} + ${jc_j2_temp} + ${jc_j3_temp} + ${jc_j4_temp} + ${jc_j5_temp} + ${jc_j6_temp}) / 6.0"
    },
    {
      "hkb_stable_id": "robot_fault_prediction_large:hkb:5",
      "sql": "(${jc_j1_vibration} + ${jc_j2_vibration} + ${jc_j3_vibration} + ${jc_j4_vibration} + ${jc_j5_vibration} + ${jc_j6_vibration}) / 6.0"
    },
    {
      "hkb_stable_id": "robot_fault_prediction_large:hkb:6",
      "sql": "(${sc_overseer_load} + ${sc_memory_usage}) / 2.0"
    },
    {
      "hkb_stable_id": "robot_fault_prediction_large:hkb:9",
      "sql": "GREATEST(${jc_j1_temp},${jc_j2_temp},${jc_j3_temp},${jc_j4_temp},${jc_j5_temp},${jc_j6_temp}) - LEAST(${jc_j1_temp},${jc_j2_temp},${jc_j3_temp},${jc_j4_temp},${jc_j5_temp},${jc_j6_temp})"
    },
    {
      "hkb_stable_id": "robot_fault_prediction_large:hkb:10",
      "sql": "${mf_rul_hours} / 24.0"
    },
    {
      "hkb_stable_id": "robot_fault_prediction_large:hkb:12",
      "sql": "60.0 / NULLIF(${o_cycle_time_seconds}, 0)"
    },
    {
      "hkb_stable_id": "robot_fault_prediction_large:hkb:15",
      "sql": "(${jc_j1_backlash} + ${jc_j2_backlash} + ${jc_j3_backlash} + ${jc_j4_backlash} + ${jc_j5_backlash} + ${jc_j6_backlash}) / 6.0"
    },
    {
      "hkb_stable_id": "robot_fault_prediction_large:hkb:17",
      "sql": "(1000.0 / (${mf_rul_hours} + 1.0)) + (${mf_fault_prediction_score} * 10.0)"
    },
    {
      "hkb_stable_id": "robot_fault_prediction_large:hkb:18",
      "sql": "0.6 * ${hkb_5} + 0.4 * ${hkb_15}"
    },
    {
      "hkb_stable_id": "robot_fault_prediction_large:hkb:34",
      "sql": "CASE WHEN ${hkb_15} < 0.01 THEN 'Low' WHEN ${hkb_15} <= 0.05 THEN 'Medium' ELSE 'High' END"
    },
    {
      "hkb_stable_id": "robot_fault_prediction_large:hkb:43",
      "sql": "${hkb_4} > 75.0 OR ${hkb_9} > 15.0"
    },
    {
      "hkb_stable_id": "robot_fault_prediction_large:hkb:47",
      "sql": "${hkb_34} = 'High' OR ${hkb_5} > 3.0"
    },
    {
      "hkb_stable_id": "robot_fault_prediction_large:hkb:48",
      "sql": "${hkb_17} > 50.0"
    },
    {
      "hkb_stable_id": "robot_fault_prediction_large:hkb:53",
    "sql": "${hkb_10} < 7.0 OR ${mf_upkeep_due_days} <= 0"
    },
    {
      "hkb_stable_id": "robot_fault_prediction_large:hkb:54",
      "sql": "${hkb_0} > 3650"
    },
    {
      "hkb_stable_id": "robot_fault_prediction_large:hkb:62",
      "sql": "${hkb_43} AND ${hkb_47}"
    },
    {
      "hkb_stable_id": "robot_fault_prediction_large:hkb:63",
      "sql": "3600.0 / NULLIF(${o_cycle_time_seconds}, 0)"
    }
  ],
