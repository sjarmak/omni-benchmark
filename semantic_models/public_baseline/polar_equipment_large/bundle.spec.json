  "derived_fields": [
    {
      "hkb_stable_id": "polar_equipment_large:hkb:1",
      "sql": "CASE WHEN ${maintenance_cycle_hours} <> 0 AND ${operational_status} = 'Active' THEN 10.0 * (1.0 - ${operational_hours} / ${maintenance_cycle_hours}) WHEN ${maintenance_cycle_hours} <> 0 AND ${operational_status} = 'Standby' THEN 5.0 * (1.0 - ${operational_hours} / ${maintenance_cycle_hours}) ELSE 0.0 END"
    },
    {
      "hkb_stable_id": "polar_equipment_large:hkb:2",
      "sql": "${energy_efficiency_percent} * CASE WHEN ${power_source} IN ('Solar', 'Wind', 'Hybrid') THEN 1.5 WHEN ${power_source} = 'Battery' THEN 1.0 WHEN ${power_source} = 'Diesel' THEN 0.7 ELSE 0.0 END"
    },
    {
      "hkb_stable_id": "polar_equipment_large:hkb:3",
      "sql": "(100.0 - ${structural_load_percent}) / 100.0 * CASE WHEN ${snow_load_kg_m2} > 100.0 OR ${wind_speed_mps} > 20.0 THEN 0.5 WHEN ${snow_load_kg_m2} > 50.0 OR ${wind_speed_mps} > 10.0 THEN 0.8 ELSE 1.0 END"
    },
    {
      "hkb_stable_id": "polar_equipment_large:hkb:4",
      "sql": "CASE ${antenna_status} WHEN 'Error' THEN 0.0 WHEN 'Warning' THEN 5.0 WHEN 'Normal' THEN 10.0 ELSE 0.0 END * (1.0 - ${network_latency_ms} / 1000.0)"
    },
    {
      "hkb_stable_id": "polar_equipment_large:hkb:6",
      "sql": "CASE ${insulation_status} WHEN 'Good' THEN 0.9 - ${heat_loss_rate_kwh} / 10.0 WHEN 'Fair' THEN 0.6 - ${heat_loss_rate_kwh} / 10.0 WHEN 'Poor' THEN 0.3 - ${heat_loss_rate_kwh} / 10.0 END"
    },
    {
      "hkb_stable_id": "polar_equipment_large:hkb:7",
      "sql": "${water_level_percent} / 100.0 * ${water_quality_index} / 100.0 * (1.0 - ${waste_tank_level_percent} / 100.0)"
    },
    {
      "hkb_stable_id": "polar_equipment_large:hkb:8",
      "sql": "${measurement_accuracy_percent} * CASE ${calibration_status} WHEN 'Valid' THEN 1.0 WHEN 'Due' THEN 0.7 WHEN 'Expired' THEN 0.3 END"
    },
    {
      "hkb_stable_id": "polar_equipment_large:hkb:9",
      "sql": "CASE WHEN (${fuel_cell_output_w} + ${solar_output_w} + ${wind_output_w}) <> 0 THEN (${solar_output_w} + ${wind_output_w}) / (${fuel_cell_output_w} + ${solar_output_w} + ${wind_output_w}) * 100.0 END"
    },
    {
      "hkb_stable_id": "polar_equipment_large:hkb:12",
      "sql": "CASE WHEN ${operational_hours} > ${maintenance_cycle_hours} OR ${operational_status} = 'Repair' THEN 'Immediate Attention' WHEN ${operational_hours} > 0.8 * ${maintenance_cycle_hours} THEN 'Scheduled Service' ELSE 'Routine Maintenance' END"
    },
    {
      "hkb_stable_id": "polar_equipment_large:hkb:13",
      "sql": "CASE WHEN ${energy_sustainability_index} > 0.8 THEN 'Green' WHEN ${energy_sustainability_index} >= 0.4 AND ${energy_sustainability_index} <= 0.8 THEN 'Intermediate' WHEN ${energy_sustainability_index} < 0.4 THEN 'High Impact' END"
    },
    {
      "hkb_stable_id": "polar_equipment_large:hkb:17",
      "sql": "${cabin_temperature_c} >= 18.0 AND ${cabin_temperature_c} <= 24.0 AND ${oxygen_level_percent} > 19.5 AND ${co2_level_ppm} < 1000.0 AND ${ventilation_status} IN ('Auto', 'On') AND ${heater_status} IN ('Auto', 'On')"
    },
    {
      "hkb_stable_id": "polar_equipment_large:hkb:18",
      "sql": "${water_resource_management_index} < 0.5"
    },
    {
      "hkb_stable_id": "polar_equipment_large:hkb:25",
      "sql": "CASE WHEN ${water_quality_index} >= 91.0 THEN 'High-Quality' WHEN ${water_quality_index} >= 71.0 AND ${water_quality_index} < 91.0 THEN 'Good' WHEN ${water_quality_index} >= 51.0 AND ${water_quality_index} < 71.0 THEN 'Moderate' WHEN ${water_quality_index} >= 26.0 AND ${water_quality_index} < 51.0 THEN 'Poor' WHEN ${water_quality_index} < 26.0 THEN 'Unsafe' END"
    },
    {
      "hkb_stable_id": "polar_equipment_large:hkb:32",
      "sql": "${communication_reliability_index} * (1.0 + 0.2 * ${radio_signal_dbm} / 100.0) * (1.0 - 0.01 * (1000.0 - ${network_latency_ms}))"
    },
    {
      "hkb_stable_id": "polar_equipment_large:hkb:45",
      "sql": "CASE WHEN ${communication_reliability_index} > 0.8 AND ${base_station_communication_stability_index} > 0.85 THEN 'High Resilience' WHEN ${communication_reliability_index} > 0.6 AND ${base_station_communication_stability_index} > 0.7 THEN 'Medium Resilience' ELSE 'Low Resilience' END"
    },
    {
      "hkb_stable_id": "polar_equipment_large:hkb:53",
      "sql": "CASE WHEN ${requires_water_conservation} THEN 'Conservation Needed' WHEN ${water_resource_management_index} >= 0.5 AND ${water_resource_management_index} < 0.7 THEN 'Monitoring Advised' WHEN ${water_resource_management_index} >= 0.7 THEN 'Sustainable Management' END"
    },
    {
      "hkb_stable_id": "polar_equipment_large:hkb:54",
      "sql": "${antenna_status} IS NOT NULL AND ${network_latency_ms} IS NOT NULL AND ${radio_signal_dbm} IS NOT NULL AND ${communication_reliability_index} IS NOT NULL AND ${base_station_communication_stability_index} IS NOT NULL"
    },
    {
      "hkb_stable_id": "polar_equipment_large:hkb:57",
      "sql": "${operational_status} = 'Active' AND ${inspection_status} = 'Failed'"
    }
  ]
}
