label: Events and Club
description: Event participation records with row-level attendance semantics.
catalog: virtual_idol_large
schema: public
table_name: eventsandclub
dimensions:
  online_events:
    description: SMALLINT. Number of online events attended by the fan.
    label: Online Events
    sql: JSONB_EXTRACT_PATH_TEXT(evt_participation, 'On_Evt_Att')
  offline_events:
    description: SMALLINT. Number of offline events attended by the fan.
    label: Offline Events
    sql: JSONB_EXTRACT_PATH_TEXT(evt_participation, 'Off_Evt_Att')
  meet_and_greets:
    description: SMALLINT. Number of meet-and-greet events attended.
    label: Meet-and-Greets
    sql: JSONB_EXTRACT_PATH_TEXT(evt_participation, 'Meet_Att')
  event_participation_score:
    label: Event Participation Score (EPS)
    description: A weighted score that measures a fan's engagement with platform events, prioritizing in-person attendance.
    sql: CAST(${online_events} AS DOUBLE PRECISION) + (CAST(${offline_events} AS DOUBLE PRECISION) * 1.5) + (CAST(${meet_and_greets} AS DOUBLE PRECISION) * 2)
    ai_context: Use this modeled field for Event Participation Score (EPS); do not reconstruct its formula.
