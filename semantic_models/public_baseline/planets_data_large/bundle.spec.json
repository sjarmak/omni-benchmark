  "physical_fields": [
    {
      "schema_stable_id": "planets_data_large:column:stars:stellardist",
      "name": "stellar_distance_parsec",
      "label": "Stellar Distance (pc)"
    },
    {
      "schema_stable_id": "planets_data_large:column:stars:compcount",
      "name": "companion_count",
      "label": "Confirmed Planet Count"
    },
    {
      "schema_stable_id": "planets_data_large:structured-leaf:stars:stellarprops:k:photometry/k:Opt_Mag",
      "name": "apparent_magnitude",
      "label": "Apparent Magnitude",
      "sql": "CAST(${stellarprops} -> 'photometry' ->> 'Opt_Mag' AS DOUBLE PRECISION)",
      "omni_parser_mode": "do_not_parse"
    },
    {
      "schema_stable_id": "planets_data_large:structured-leaf:stars:stellarprops:k:physical/k:Temp_Value",
      "name": "stellar_temperature_k",
      "label": "Stellar Temperature (K)",
      "sql": "CAST(${stellarprops} -> 'physical' ->> 'Temp_Value' AS DOUBLE PRECISION)",
      "omni_parser_mode": "do_not_parse"
    },
    {
      "schema_stable_id": "planets_data_large:structured-leaf:stars:stellarprops:k:physical/k:Mass_Value",
      "name": "stellar_mass_solar",
      "label": "Stellar Mass (Solar Masses)",
      "sql": "CAST(${stellarprops} -> 'physical' ->> 'Mass_Value' AS DOUBLE PRECISION)",
      "omni_parser_mode": "do_not_parse"
    },
    {
      "schema_stable_id": "planets_data_large:structured-leaf:stars:stellarprops:k:physical/k:Radius_Value",
      "name": "stellar_radius_solar",
      "label": "Stellar Radius (Solar Radii)",
      "sql": "CAST(${stellarprops} -> 'physical' ->> 'Radius_Value' AS DOUBLE PRECISION)",
      "omni_parser_mode": "do_not_parse"
