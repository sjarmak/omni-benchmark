    {"hkb_stable_id":"solar_panel_large:hkb:18","sql":"${maintcost} / NULLIF(${revloss}, 0.0)"},
    {"hkb_stable_id":"solar_panel_large:hkb:20","sql":"${degyrrate} > 0.7"},
    {"hkb_stable_id":"solar_panel_large:hkb:21","sql":"${tracker} IN ('Error', 'Maintenance')"},
