    {"hkb_stable_id":"solar_panel_large:hkb:23","sql":"${mount} IN ('Unstable', 'Check Required')"},
    {"hkb_stable_id":"solar_panel_large:hkb:24","sql":"${maintprio} = 'High'"},
    {"hkb_stable_id":"solar_panel_large:hkb:25","sql":"${replprio} = 'High'"},
    {"hkb_stable_id":"solar_panel_large:hkb:26","sql":"${soiling_loss_index} > 15.0"},
    {"hkb_stable_id":"solar_panel_large:hkb:28","sql":"${warrstate} = 'Claimed' AND ${warrclaims} > 2"},
    {"hkb_stable_id":"solar_panel_large:hkb:29","sql":"${high_maintenance_priority} AND ${high_replacement_priority}"},
    {"hkb_stable_id":"solar_panel_large:hkb:30","sql":"${ground} = 'Failed' OR ${diode} <> 'Normal'"},
    {"hkb_stable_id":"solar_panel_large:hkb:31","sql":"${busbar} = 'Severe' AND ${delam} = 'Major' AND ${microcrack} > 5"},
    {"hkb_stable_id":"solar_panel_large:hkb:32","sql":"${performance_ratio_metric} < 0.75"},
    {"hkb_stable_id":"solar_panel_large:hkb:35","sql":"${structural_integrity_warning} AND ${tracker_malfunction}"},
    {"hkb_stable_id":"solar_panel_large:hkb:37","sql":"${result} = 'Major Issues' AND ${schedule} = 'Overdue'"}
