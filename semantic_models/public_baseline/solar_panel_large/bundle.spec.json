  "derived_fields": [
    {"hkb_stable_id":"solar_panel_large:hkb:0","sql":"${specific_yield}"},
    {"hkb_stable_id":"solar_panel_large:hkb:1","sql":"${capacity_factor}"},
    {"hkb_stable_id":"solar_panel_large:hkb:2","sql":"${soil_loss}"},
    {"hkb_stable_id":"solar_panel_large:hkb:4","sql":"${mttr} / NULLIF(${mtbf} + ${mttr}, 0.0)"},
    {"hkb_stable_id":"solar_panel_large:hkb:5","sql":"${fill_initial} - ${fill_now}"},
