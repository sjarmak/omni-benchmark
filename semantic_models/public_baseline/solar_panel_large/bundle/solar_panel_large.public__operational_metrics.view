label: Operational Metrics
description: Reliability, cost, and loss metrics.
catalog: solar_panel_large
schema: public
table_name: operational_metrics
dimensions:
  mtbf:
    description: 'REAL. Mean time between failures in hours. NULL means the encoder does not report status or data are missing. Example: 3713.0.'
    label: Mean Time Between Failures
    sql: ${mtbfh}
    ai_context: 'Mean Time Between Failures (MTBF): A reliability metric that represents the average time a system operates before a failure occurs. It is typically measured in hours. A high MTBF (e.g., >8000 hours) indicates a highly reliable system, while a low MTBF (e.g., <1000 hours) indicates a system that fails frequently.'
  mttr:
    description: 'REAL. Mean time to repair in hours. Example: 8.8.'
    label: Mean Time To Repair
    sql: ${mttrh}
  maintcost:
    description: 'REAL. Maintenance cost amount. Example: 178.82.'
    label: Maintenance Cost
  cleancost:
    description: 'REAL. Cleaning cost amount. Example: 1034.89.'
    label: Cleaning Cost
  replcost:
    description: 'REAL. Component replacement cost. Example: 31529.13.'
    label: Replacement Cost
  revloss:
    description: 'TEXT. Revenue loss amount. Example: 13375.59.'
    label: Revenue Loss
  maintenance_cost_to_revenue_impact_ratio:
    label: Maintenance Cost to Revenue Impact Ratio
    description: Compares the cost of maintenance activities to the revenue lost during downtime for those repairs.
    sql: ${maintcost} / NULLIF(${revloss}, 0.0)
    ai_context: Use this modeled field for Maintenance Cost to Revenue Impact Ratio; do not reconstruct its formula.
  system_unavailability:
    label: System Unavailability
    description: Calculates the proportion of time a system is non-operational or in a state of failure.
    sql: ${mttr} / NULLIF(${mtbf} + ${mttr}, 0.0)
    ai_context: Use this modeled field for System Unavailability; do not reconstruct its formula.
  system_availability:
    label: System Availability
    description: Calculates the proportion of time a system is operational and available to perform its required function.
    sql: 1.0 - ${system_unavailability}
    ai_context: Use this modeled field for System Availability; do not reconstruct its formula.
