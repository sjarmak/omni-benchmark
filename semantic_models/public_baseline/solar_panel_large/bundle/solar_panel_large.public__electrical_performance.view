label: Electrical Performance
description: Electrical health and energy-yield measurements.
catalog: solar_panel_large
schema: public
table_name: electrical_performance
dimensions:
  specific_yield:
    description: 'REAL. Specific yield in kWh/kWp. Example: 5.18.'
    label: Specific Yield
    sql: ${elec_perf_snapshot} -> 'energy_yield' ->> 'specific_yield_kwh_kw'
  capacity_factor:
    description: 'REAL. Capacity factor percentage. Example: 27.47.'
    label: Capacity Factor
  performance_ratio:
    description: 'REAL. Performance ratio. NULL means the encoder does not report status or data are missing. Example: 0.846.'
    label: Performance Ratio
  availability:
    description: 'REAL. System availability percentage. Example: 97.73.'
    label: Availability
  power_now:
    description: 'REAL. Current power output in watts. NULL means the encoder does not report status or data are missing. Example: 554.51.'
    label: Power Output
  power_loss:
    description: 'REAL. Power loss since installation. NULL means the encoder does not report status or data are missing. Example: 95.49.'
    label: Power Loss
  inverter_eff:
    description: 'REAL. Inverter efficiency percentage. Example: 98.43.'
    label: Inverter Efficiency
  power_factor:
    description: 'REAL. Inverter power factor. NULL means the encoder does not report status or data are missing. Example: 0.979.'
    label: Power Factor
    ai_context: 'Power Factor: A dimensionless ratio ranging from -1 to 1 that represents the ratio of real power (doing work) to apparent power (flowing in the circuit). A value of 1.0 indicates perfect efficiency, while a value of 0.95 is typical for high-efficiency systems. Lower values indicate more reactive power, which does not perform work.'
  harmonic:
    description: 'REAL. Harmonic distortion percentage. Example: 4.01.'
    label: Harmonic Distortion
    ai_context: 'Total Harmonic Distortion (THD): A measurement of the harmonic distortion present in a signal, defined as the ratio of the sum of the powers of all harmonic components to the power of the fundamental frequency. In power systems, a low THD (e.g., <5%) is desirable for good power quality, while higher values can indicate potential problems for connected equipment.'
  voc_initial:
    description: 'REAL. Initial open-circuit voltage. NULL means the encoder does not report status or data are missing. Example: 49.74.'
    label: Initial Open-Circuit Voltage
  voc_now:
    description: 'REAL. Current open-circuit voltage. Example: 43.32.'
    label: Current Open-Circuit Voltage
  isc_initial:
    description: 'REAL. Initial short-circuit current. Example: 9.09.'
    label: Initial Short-Circuit Current
  isc_now:
    description: 'REAL. Current short-circuit current. Example: 8.51.'
    label: Current Short-Circuit Current
  fill_initial:
    description: 'REAL. Initial fill factor. Example: 0.773.'
    label: Initial Fill Factor
  fill_now:
    description: 'REAL. Current fill factor. Example: 0.71.'
    label: Current Fill Factor
    ai_context: 'IV Curve Fill Factor: A measure of the ''squareness'' of the current-voltage (IV) curve, indicating the quality of the solar cell. It is the ratio of the maximum actual power to the theoretical maximum power. A higher value (e.g., >0.8) indicates a higher quality cell with low internal power losses.'
  soil_loss:
    description: 'REAL. Power loss due to soiling. Example: 13.41.'
    label: Soiling Loss
  cumulative_deg:
    description: 'REAL. Cumulative degradation percentage. Example: 14.69.'
    label: Cumulative Degradation
  specific_yield_metric:
    label: Specific Yield
    description: Measures the energy output of a solar plant relative to its rated power capacity over a period.
    sql: ${specific_yield}
    ai_context: Use this modeled field for Specific Yield; do not reconstruct its formula.
  power_capacity_factor:
    label: Power Capacity Factor
    description: Calculates the ratio of a plant's actual energy output over a period to its potential maximum output.
    sql: ${capacity_factor}
    ai_context: Use this modeled field for Power Capacity Factor; do not reconstruct its formula.
  inverter_efficiency_loss:
    label: Inverter Efficiency Loss
    description: Calculates the percentage of DC power that is lost as heat during the conversion to AC power within the inverter.
    sql: 100.0 - ${inverter_eff}
    ai_context: Use this modeled field for Inverter Efficiency Loss; do not reconstruct its formula.
  system_power_loss_ratio:
    label: System Power Loss Ratio
    description: Measures the proportion of power that is generated but lost within the system before reaching the grid.
    sql: ${power_loss} / NULLIF(${power_now} + ${power_loss}, 0.0)
    ai_context: Use this modeled field for System Power Loss Ratio; do not reconstruct its formula.
  voltage_degradation_factor:
    label: Voltage Degradation Factor
    description: Quantifies the decline in a panel's maximum power point voltage (Vmp) over time.
    sql: (${voc_initial} - ${voc_now}) / NULLIF(${voc_initial}, 0.0)
    ai_context: Use this modeled field for Voltage Degradation Factor; do not reconstruct its formula.
  current_degradation_factor:
    label: Current Degradation Factor
    description: Quantifies the decline in a panel's maximum power point current (Imp) over time.
    sql: (${isc_initial} - ${isc_now}) / NULLIF(${isc_initial}, 0.0)
    ai_context: Use this modeled field for Current Degradation Factor; do not reconstruct its formula.
  effective_power_output:
    label: Effective Power Output
    description: Calculates the net power delivered by the system after accounting for internal power losses.
    sql: ${power_now} * (1.0 - ${system_power_loss_ratio})
    ai_context: Use this modeled field for Effective Power Output; do not reconstruct its formula.
  soiling_loss_index:
    label: Soiling Loss Index
    description: Quantifies the percentage of power loss due to the accumulation of dirt, dust, and other particulates on panel surfaces.
    sql: ${soil_loss}
    ai_context: Use this modeled field for Soiling Loss Index; do not reconstruct its formula.
  severe_soiling_condition:
    label: Severe Soiling Condition
    description: Indicates that panel surfaces are heavily soiled, causing a significant loss of energy production.
    sql: ${soiling_loss_index} > 15.0
    ai_context: Use this modeled field for Severe Soiling Condition; do not reconstruct its formula.
  performance_ratio_metric:
    label: Performance Ratio (PR)
    description: Measures the overall efficiency of a solar plant by comparing its actual energy output to its theoretically possible output under given climatic conditions.
    sql: ${specific_yield_metric}
    ai_context: Use this modeled field for Performance Ratio (PR); do not reconstruct its formula.
  underperforming_asset:
    label: Underperforming Asset
    description: An asset whose energy conversion efficiency is significantly below its expected benchmark.
    sql: ${performance_ratio_metric} < 0.75
    ai_context: Use this modeled field for Underperforming Asset; do not reconstruct its formula.
  fill_factor_degradation:
    label: Fill Factor Degradation
    description: Measures the reduction in the IV curve's fill factor from its initial value, indicating a decline in solar cell quality.
    sql: ${fill_initial} - ${fill_now}
    ai_context: Use this modeled field for Fill Factor Degradation; do not reconstruct its formula.
