label: Environmental Conditions
description: Plant environmental measurements.
catalog: solar_panel_large
schema: public
table_name: environmental_conditions
dimensions:
  cell_temp:
    description: 'REAL. Solar cell temperature. NULL means the encoder does not report status or data are missing. Example: 47.3.'
    label: Cell Temperature
  uv:
    description: 'REAL. UV index measurement. Example: 1.1.'
    label: UV Index
    ai_context: 'UV Index: An international standard measurement of the strength of the sunburn-producing ultraviolet (UV) radiation at a particular place and time. The scale is open-ended, where 1-2 is Low, 3-5 is Moderate, 6-7 is High, 8-10 is Very High, and 11+ is Extreme.'
