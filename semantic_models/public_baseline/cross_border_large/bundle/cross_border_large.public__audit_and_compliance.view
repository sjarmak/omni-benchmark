label: Audit and Compliance
description: Audit rows with finding counts, data-subject request counts, response time, remediation deadlines, and same-row modeled semantics.
catalog: cross_border_large
schema: public
table_name: AuditAndCompliance
dimensions:
  critFindNum:
    description: 'BIGINT. The number of critical findings from audits. Example: 0.'
    label: Critical Findings
  FINDTALLY:
    description: 'BIGINT. The total tally of audit findings. Example: 49.'
    label: Total Findings
  AccReqNum:
    description: 'BIGINT. The number of access requests. Example: 75.'
    label: Access Requests
  DEL_REQ_NUM:
    description: 'BIGINT. The number of data deletion requests. Example: 354.'
    label: Deletion Requests
  rect_req_num:
    description: 'BIGINT. The number of data rectification requests. Example: 13.'
    label: Correction Requests
  PORTREQNUM:
    description: 'BIGINT. The number of data portability requests. Example: 50.'
    label: Transfer Requests
  resp_time_day:
    description: 'REAL. The average response time in days. Example: 16.'
    label: Response Time (days)
    ai_context: 'Response Time: Lower means faster response; higher means delays.'
  REMED_DUE:
    description: 'DATE. The due date for remediation actions. Example: 2025-04-24.'
    label: Remediation Due Date
  audit_finding_severity:
    label: Audit Finding Severity (AFS)
    description: Indicates how serious audit findings are, especially critical issues.
    sql: ${critFindNum} * 1.0 / (${FINDTALLY} + 1.0)
    ai_context: Use this modeled field for Audit Finding Severity (AFS); do not reconstruct its formula.
  is_critical_audit_issue:
    label: Critical Audit Issue
    description: Flags an audit when the severity of findings is high.
    sql: ${audit_finding_severity} > 0.5
    ai_context: Use this modeled field for Critical Audit Issue; do not reconstruct its formula.
  request_breakdown:
    label: Request Breakdown
    description: Lists the types and numbers of requests individuals made about their data.
    sql: '''access requests: '' || CAST(${AccReqNum} AS TEXT) || '', deletion requests: '' || CAST(${DEL_REQ_NUM} AS TEXT) || '', correction requests: '' || CAST(${rect_req_num} AS TEXT) || '', transfer requests: '' || CAST(${PORTREQNUM} AS TEXT)'
    ai_context: Use this modeled field for Request Breakdown; do not reconstruct its formula.
  is_slow_remediation_timeline:
    label: Slow Remediation Timeline
    description: Labels cases where the deadline to fix an issue has already passed.
    sql: CURRENT_DATE > ${REMED_DUE}
    ai_context: Use this modeled field for Slow Remediation Timeline; do not reconstruct its formula.
  is_nearing_remediation_deadline:
    label: Nearing Remediation Deadline
    description: Highlights transfers close to their fix deadline.
    sql: ${REMED_DUE} - CURRENT_DATE BETWEEN -5 AND 0
    ai_context: Use this modeled field for Nearing Remediation Deadline; do not reconstruct its formula.
  data_subject_request_load:
    label: Data Subject Request Load (DSRL)
    description: Shows how many requests people made about their own data.
    sql: ${AccReqNum} + ${DEL_REQ_NUM} + ${rect_req_num} + ${PORTREQNUM}
    ai_context: Use this modeled field for Data Subject Request Load (DSRL); do not reconstruct its formula.
