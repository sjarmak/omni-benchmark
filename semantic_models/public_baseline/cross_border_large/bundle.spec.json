  "derived_fields": [
    {
      "hkb_stable_id": "cross_border_large:hkb:5",
      "sql": "CASE WHEN ${enc_state} IS NULL OR ${acl_state} IS NULL THEN NULL WHEN ${enc_state} = 'Full' AND ${acl_state} = 'Strong' THEN 3 WHEN ${enc_state} = 'Full' OR ${acl_state} = 'Strong' THEN 2 ELSE 1 END"
    },
    {
      "hkb_stable_id": "cross_border_large:hkb:7",
      "sql": "${critFindNum} * 1.0 / (${FINDTALLY} + 1.0)"
    },
    {
      "hkb_stable_id": "cross_border_large:hkb:8",
      "sql": "${AccReqNum} + ${DEL_REQ_NUM} + ${rect_req_num} + ${PORTREQNUM}"
    },
    {
      "hkb_stable_id": "cross_border_large:hkb:11",
      "sql": "${security_robustness_score} = 3"
    },
    {
      "hkb_stable_id": "cross_border_large:hkb:12",
      "sql": "${pol_comp} = 'Non-compliant' OR ${procComp} = 'Non-compliant'"
    },
    {
      "hkb_stable_id": "cross_border_large:hkb:13",
      "sql": "${audit_finding_severity} > 0.5"
    },
    {
      "hkb_stable_id": "cross_border_large:hkb:17",
      "sql": "${Int_check} = 'Failed' OR ${CSUMVERIFY} = 'Failed'"
    },
    {
      "hkb_stable_id": "cross_border_large:hkb:71",
      "sql": "'access requests: ' || CAST(${AccReqNum} AS TEXT) || ', deletion requests: ' || CAST(${DEL_REQ_NUM} AS TEXT) || ', correction requests: ' || CAST(${rect_req_num} AS TEXT) || ', transfer requests: ' || CAST(${PORTREQNUM} AS TEXT)"
    },
    {
      "hkb_stable_id": "cross_border_large:hkb:72",
      "sql": "CASE WHEN ${Int_check} = 'Failed' THEN 1 ELSE 0 END + CASE WHEN ${CSUMVERIFY} = 'Failed' THEN 1 ELSE 0 END"
    },
    {
      "hkb_stable_id": "cross_border_large:hkb:73",
      "sql": "CASE WHEN ${Int_check} = 'Failed' AND ${CSUMVERIFY} = 'Failed' THEN 'integrity check, verification' WHEN ${Int_check} = 'Failed' THEN 'integrity check' WHEN ${CSUMVERIFY} = 'Failed' THEN 'verification' ELSE '' END"
    },
    {
      "hkb_stable_id": "cross_border_large:hkb:76",
      "sql": "CURRENT_DATE > ${REMED_DUE}"
    },
    {
      "hkb_stable_id": "cross_border_large:hkb:77",
      "sql": "${REMED_DUE} - CURRENT_DATE BETWEEN -5 AND 0"
    }
  ]
