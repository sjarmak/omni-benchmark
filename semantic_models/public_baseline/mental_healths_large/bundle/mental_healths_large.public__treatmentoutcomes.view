label: Treatment Outcomes
description: Treatment-outcome rows with response and adherence semantics.
catalog: mental_healths_large
schema: public
table_name: treatmentoutcomes
dimensions:
  treatment_response:
    description: 'Treatment response assessment. Contains values: ''Poor'', ''Partial'', ''Good'', ''Excellent''. Contains NULL when treatment response is not evaluated.'
    label: Treatment Response
    sql: ${txprogmet} ->> 'Tx_Resp'
  treatment_adherence:
    description: 'Treatment adherence level. Contains values: ''Non-compliant'', ''Medium'', ''High'', ''Compliant''.'
    label: Treatment Adherence
    sql: ${txprogmet} ->> 'Tx_Adh'
    ai_context: 'Treatment Adherence: Ranges from Non-compliant to High/Compliant. Non-compliant indicates no adherence, Low indicates occasional adherence, Medium indicates regular adherence, and High/Compliant indicates consistent adherence.'
  is_treatment_resistant_outcome:
    label: Treatment-Resistant Patient
    description: Identifies patients with poor treatment response despite adherence.
    sql: ${treatment_response} = 'Poor' AND ${treatment_adherence} IN ('Medium', 'High')
    ai_context: Use this modeled field for Treatment-Resistant Patient; do not reconstruct its formula.
