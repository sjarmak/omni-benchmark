label: Encounters
description: Encounter rows with missed-appointment context.
catalog: mental_healths_large
schema: public
table_name: encounters
dimensions:
  missed_appointment_count:
    description: Number of appointments missed by the patient prior to or following this encounter.
    label: Missed Appointment Count
    sql: ${miss_appt}
    ai_context: 'Missed Appointment Count: A numeric value indicating the number of missed appointments. A value of 0 indicates perfect attendance, while higher values (e.g., 5) indicate frequent absences.'
