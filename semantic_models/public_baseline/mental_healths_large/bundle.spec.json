  "derived_fields": [
    {
      "hkb_stable_id": "mental_healths_large:hkb:10",
      "sql": "${suicide_risk} = 'High' OR ${phq9_score} > 15 OR ${gad7_score} > 15"
    },
    {
      "hkb_stable_id": "mental_healths_large:hkb:11",
      "sql": "${treatment_response} = 'Poor' AND ${treatment_adherence} IN ('Medium', 'High')"
    },
    {
      "hkb_stable_id": "mental_healths_large:hkb:49",
      "sql": "(${phq9_score} > 19 OR ${gad7_score} > 14) AND ${suicide_risk} = 'High'"
    },
    {
      "hkb_stable_id": "mental_healths_large:hkb:66",
      "sql": "CASE WHEN ${diagnosis_duration_months} > 0 THEN ${previous_hospitalizations} / (${diagnosis_duration_months} / 12.0) END"
    },
    {
      "hkb_stable_id": "mental_healths_large:hkb:75",
      "sql": "${recovery_status} = 'Stable' AND ${diagnosis_duration_months} > 72 AND ${resilience_score} >= 8"
    },
    {
      "hkb_stable_id": "mental_healths_large:hkb:76",
      "sql": "${primary_diagnosis} = 'Bipolar' AND ${diagnosis_duration_months} >= 120 AND ${previous_hospitalizations} > 3"
    }
  ]
