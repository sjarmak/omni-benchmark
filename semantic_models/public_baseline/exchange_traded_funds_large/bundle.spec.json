  "derived_fields": [
    {"hkb_stable_id":"exchange_traded_funds_large:hkb:0","sql":"${fund_annual_return} - ${category_average_annual_return}"},
    {"hkb_stable_id":"exchange_traded_funds_large:hkb:1","sql":"${net_expense_ratio} - ${benchmark_expense_ratio}"},
    {"hkb_stable_id":"exchange_traded_funds_large:hkb:3","sql":"CASE WHEN ${net_expense_ratio} <> 0 THEN ${yield_rate} / NULLIF(${net_expense_ratio}, 0) END"},
    {"hkb_stable_id":"exchange_traded_funds_large:hkb:4","sql":"CASE WHEN ${high_52_week} <> ${low_52_week} THEN ${current_price_minus_52_week_low} / NULLIF(${high_52_week} - ${low_52_week}, 0) * 100.0 END"},
    {"hkb_stable_id":"exchange_traded_funds_large:hkb:5","sql":"${moving_average_50_day} - ${moving_average_200_day}"},
    {"hkb_stable_id":"exchange_traded_funds_large:hkb:7","sql":"CASE WHEN ${positive_return_years} + ${negative_return_years} <> 0 THEN ${positive_return_years} / NULLIF(${positive_return_years} + ${negative_return_years}, 0) * 100.0 END"},
    {"hkb_stable_id":"exchange_traded_funds_large:hkb:9","sql":"${equity_weight} <> 0 AND ${yield_rate} <> 0"},
    {"hkb_stable_id":"exchange_traded_funds_large:hkb:10","sql":"${alpha_5_year} > 0"},
    {"hkb_stable_id":"exchange_traded_funds_large:hkb:11","sql":"${r_squared_3_year_pct} > 90.0"},
