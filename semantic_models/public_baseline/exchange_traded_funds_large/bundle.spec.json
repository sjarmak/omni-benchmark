    {"hkb_stable_id":"exchange_traded_funds_large:hkb:13","sql":"${largest_holding_weight} > 0.08"},
    {"hkb_stable_id":"exchange_traded_funds_large:hkb:14","sql":"${yield_to_expense_ratio} > 15.0"},
    {"hkb_stable_id":"exchange_traded_funds_large:hkb:16","sql":"${is_market_tracking_fund} AND ${is_alpha_generator}"},
    {"hkb_stable_id":"exchange_traded_funds_large:hkb:17","sql":"${short_term_momentum} > 0"},
    {"hkb_stable_id":"exchange_traded_funds_large:hkb:37","sql":"${yield_rate} - ${relative_expense_ratio}"},
    {"hkb_stable_id":"exchange_traded_funds_large:hkb:50","sql":"CASE WHEN ${volatility_3_year} <> 0 AND 1.0 - ${r_squared_3_year_decimal} > 0 THEN ${alpha_3_year} / NULLIF(${volatility_3_year} * SQRT(1.0 - ${r_squared_3_year_decimal}), 0) END"},
    {"hkb_stable_id":"exchange_traded_funds_large:hkb:51","sql":"CASE WHEN ${price_to_earnings_ratio} <> 0 AND ${price_to_sales_ratio} <> 0 AND ${price_to_book_ratio} <> 0 AND ${price_to_cash_flow_ratio} <> 0 THEN 0.25 * (1.0 / ${price_to_earnings_ratio} + 1.0 / ${price_to_sales_ratio} + 1.0 / ${price_to_book_ratio} + 1.0 / ${price_to_cash_flow_ratio}) END"},
    {"hkb_stable_id":"exchange_traded_funds_large:hkb:57","sql":"CASE WHEN 1.0 + ${negative_return_years} <> 0 AND ${low_52_week} <> 0 THEN (1.0 / (1.0 + ${negative_return_years})) * (1.0 + ${current_price_minus_52_week_low} / ${low_52_week}) END"},
    {"hkb_stable_id":"exchange_traded_funds_large:hkb:58","sql":"CASE WHEN ${average_daily_volume_3m} <> 0 THEN (${net_worth} * ${turnover_ratio}) / NULLIF(${average_daily_volume_3m} * 252.0, 0) END"},
    {"hkb_stable_id":"exchange_traded_funds_large:hkb:59","sql":"CASE WHEN ${price_to_earnings_ratio} > 0 AND ${price_to_book_ratio} > 0 THEN LN(${price_to_earnings_ratio} / ${price_to_book_ratio}) END"},
    {"hkb_stable_id":"exchange_traded_funds_large:hkb:84","sql":"CASE WHEN ${price_to_earnings_ratio} IS NOT NULL AND ${price_to_book_ratio} IS NOT NULL THEN 'Transparent' ELSE 'Opaque' END"}
