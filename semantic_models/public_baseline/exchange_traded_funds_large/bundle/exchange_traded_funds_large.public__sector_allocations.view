label: Sector Allocations
description: Per-fund sector allocation records with public sector-weight context.
catalog: exchange_traded_funds_large
schema: public
table_name: sector_allocations
dimensions:
  sector_weight:
    description: Percentage (0-1) of the fund's assets allocated to this specific sector, must sum to 1.0 across all sectors for each fund.
    label: Sector Weight
    sql: ${weightpct}
    ai_context: 'Sector Weight: The percentage of a fund''s assets invested in a particular sector, like ''technology'' or ''healthcare''. A high value, such as 0.4 (40%), indicates a significant bet on that sector''s performance.'
