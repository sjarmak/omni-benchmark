  "derived_fields": [
    {
      "hkb_stable_id": "organ_transplant_large:hkb:3",
      "sql": "${donor_gfr}"
    },
    {
      "hkb_stable_id": "organ_transplant_large:hkb:4",
      "sql": "${hla_mismatch_count}"
    },
    {
      "hkb_stable_id": "organ_transplant_large:hkb:0",
      "sql": "CASE WHEN ${donor_height_cm} > 0 THEN ${donor_weight_kg} / POWER(${donor_height_cm} / 100.0, 2.0) END"
    },
    {
      "hkb_stable_id": "organ_transplant_large:hkb:5",
      "sql": "CAST(NULLIF(REGEXP_REPLACE(${wait_time}, '[^0-9.]', '', 'g'), '') AS DOUBLE PRECISION) / 365.0"
    },
    {
      "hkb_stable_id": "organ_transplant_large:hkb:9",
      "sql": "${estimated_glomerular_filtration_rate} - (10.0 * CAST(NULLIF(REGEXP_REPLACE(${donor_serum_creatinine}, '[^0-9.]', '', 'g'), '') AS DOUBLE PRECISION))"
    },
    {
      "hkb_stable_id": "organ_transplant_large:hkb:10",
      "sql": "(CASE WHEN ${is_abo_compatible} THEN 0.6 ELSE 0.0 END) + 0.4 * (1.0 - ${hla_mismatch_score} / 6.0)"
    },
    {
      "hkb_stable_id": "organ_transplant_large:hkb:14",
      "sql": "0.7 * ${medical_urgency_numeric_value} + 0.3 * ${recipient_wait_time_years}"
    },
    {
      "hkb_stable_id": "organ_transplant_large:hkb:15",
      "sql": "0.6 * ${center_volume_score} + 0.4 * ${center_outcomes_score}"
    },
    {
      "hkb_stable_id": "organ_transplant_large:hkb:20",
      "sql": "LOWER(TRIM(${abo_compatibility_result})) = 'compatible'"
    },
    {
      "hkb_stable_id": "organ_transplant_large:hkb:24",
      "sql": "LOWER(TRIM(${crossmatch_result})) = 'positive'"
    },
    {
      "hkb_stable_id": "organ_transplant_large:hkb:25",
      "sql": "CASE WHEN UPPER(TRIM(${medical_urgency_status})) = 'STATUS 1A' THEN 5.0 WHEN UPPER(TRIM(${medical_urgency_status})) = 'STATUS 1B' THEN 4.0 WHEN UPPER(TRIM(${medical_urgency_status})) IN ('STATUS 2', '2') THEN 3.0 WHEN UPPER(TRIM(${medical_urgency_status})) IN ('STATUS 3', '3') THEN 2.0 ELSE 1.0 END"
    }
  ]
}
