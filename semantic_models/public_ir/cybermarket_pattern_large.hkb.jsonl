{"database":"cybermarket_pattern_large","definition":"Values: Active, Closed, Suspended, Under Investigation. Label descriptions: - Active: The marketplace is online, accepting new listings and processing transactions normally.- Closed: Operators have permanently shut down the marketplace; no further log ins or transactions are possible. - Suspended: The marketplace is temporarily offline, often due to policy violations or maintenance, and may return to service. - Under Investigation: Law enforcement or compliance review is in progress; user activity is restricted or frozen.","dependency_closure_stable_ids":[],"dependency_depth":0,"dependency_ids":[],"dependency_stable_ids":[],"description":"Indicates current state of platform functionality.","hkb_id":20,"knowledge":"Platform Operational Status","provenance":{"content":"public_hkb","intervention":"mechanical_baseline_transformation","source":{"dataset":"birdsql/livesqlbench-large-v1","file":"cybermarket_pattern_large/cybermarket_pattern_large_kb.jsonl","file_sha256":"78c43b3775565e16eb02e8c7a7e48ccf59c21292dd65d95f6dd019f5de470c9d","line":21,"record_sha256":"36d23862f3a79008018bdf7b040affa30e848b2e2531b8aa70ecd992ac7c7fb6","revision":"a418e108d5cbb4cf9b783a928eff5e924ad2460d"},"transformation_class":"mechanical"},"representability":{"reason":"semantic_mapping_not_attempted","status":"unassessed"},"schema_version":1,"source_dependency_encoding":"sentinel_minus_one","source_type":"value_illustration","stable_id":"cybermarket_pattern_large:hkb:20"}
