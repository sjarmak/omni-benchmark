# Omni connection. Keep real values in an untracked .env file or secret manager.
OMNI_BASE_URL=
# Set exactly one authentication source. Profiles remain outside this repository.
OMNI_PROFILE=
OMNI_API_TOKEN=
OMNI_MODEL_ID=
OMNI_BRANCH_ID=

# Direct-SQL comparator. Pin the provider and model before the frozen run.
DIRECT_MODEL_PROVIDER=
DIRECT_MODEL_ID=
DIRECT_MODEL_API_KEY=

# PostgreSQL benchmark environment.
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGSSLMODE=prefer
