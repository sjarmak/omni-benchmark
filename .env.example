# Template only. Keep real values in an untracked .env or a secret manager.
# Every variable here is read by committed code; nothing is aspirational.

# --- Omni connection ---------------------------------------------------------
# HTTPS origin with no embedded credentials.
OMNI_BASE_URL=
# Set exactly one authentication source, never both. Profiles live outside this
# repository and are leased, not copied (see CLAUDE.md on OAuth custody).
OMNI_PROFILE=
OMNI_API_TOKEN=
OMNI_MODEL_ID=
OMNI_BRANCH_ID=

# --- PostgreSQL benchmark environment ----------------------------------------
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=prefer
# The sealed loader requires an explicit system CA. Leaving this empty is what
# broke sealed-final-v1 (D-165); the direct loader had it set and the sealed one
# did not, so the sealed run failed attestation before its first query.
PGSSLROOTCERT=/etc/ssl/certs/ca-certificates.crt
# Password for the restricted runtime role. database_postgres.py refuses to
# operate without it rather than falling back to an ambient credential.
BENCHMARK_RUNTIME_PASSWORD=

# --- Scorer database roles ---------------------------------------------------
# Two separate DSNs on purpose: the admin role clones the template database, the
# execution role runs candidate SQL under restricted privileges. Pointing both
# at one superuser DSN defeats the isolation the scorer depends on.
OMNI_BENCHMARK_SCORER_ADMIN_DSN=
OMNI_BENCHMARK_SCORER_EXECUTION_DSN=

# --- Direct-arm Claude CLI ----------------------------------------------------
# Absolute path to the reviewed Claude Code release. Leave empty to use the
# location recorded in claude_direct_transport.PINNED_CLAUDE_BINARY, which is
# correct only on the machine that constant was written on. The SHA-256 pin is
# what enforces identity, so relocating the binary does not relax anything: a
# path whose contents do not hash to PINNED_CLAUDE_BINARY_SHA256 is refused.
OMNI_BENCHMARK_CLAUDE_BINARY=

# --- Not set here ------------------------------------------------------------
# The direct arms (C1-C3) authenticate through Claude Code OAuth profile
# directories passed as repeated --claude-config-dir arguments, not through an
# API key in the environment. There is no DIRECT_MODEL_* variable; earlier
# templates carried three that no committed code ever read.
