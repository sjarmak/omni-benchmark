label: Air Quality Readings
description: Air-quality reading rows with PM2.5 conservation context.
catalog: museum_artifact_large
schema: public
table_name: AirQualityReadings
dimensions:
  pm25_ug_m3:
    description: 'REAL. Particulate Matter (PM2.5) concentration in µg/m³. Example: 16.7.'
    label: PM2.5 (µg/m³)
    sql: CAST(JSONB_EXTRACT_PATH_TEXT(air_quality_metrics, 'particulates', 'pm25_ug_m3') AS DOUBLE PRECISION)
    ai_context: 'Fine Particulate Matter Implications: Represents PM2.5 concentration. Clean museum air should be below 5 µg/m³. Values above 15 indicate potential risk, and above 30 are hazardous.'
  air_quality_metrics:
    description: JSONB column. Stores all gaseous-pollutant and particulate measurements from a single sensor snapshot so downstream analytics can ingest one JSONB blob instead of many columns.
    sql: air_quality_metrics
  aq_id:
    description: BIGSERIAL. Unique identifier for each air quality reading. PK.
    sql: aq_id
  env_link:
    description: TEXT. Reference to the environmental reading. FK to EnvironmentalReadingsCore.monitor_code.
    sql: env_link
  air_quality_metrics_air_flow_air_exchange_rate_h:
    description: 'REAL. Air exchange rate. **NULL means air exchange rate not recorded.**. Example: 6.4.'
    sql: JSONB_EXTRACT_PATH_TEXT(air_quality_metrics, 'air_flow', 'air_exchange_rate_h')
  air_quality_metrics_air_flow_air_velocity_ms:
    description: 'REAL. Air velocity in the environment. **NULL means air velocity not measured.**. Example: 0.18.'
    sql: JSONB_EXTRACT_PATH_TEXT(air_quality_metrics, 'air_flow', 'air_velocity_ms')
  air_quality_metrics_gases_ppm_ppb_co2_ppm:
    description: 'TEXT. CO2 concentration in ppm. **NULL means CO2 data not available.**. Example: 794 ppm.'
    sql: JSONB_EXTRACT_PATH_TEXT(air_quality_metrics, 'gases_ppm_ppb', 'co2_ppm')
  air_quality_metrics_gases_ppm_ppb_formaldehyde_mg_m3:
    description: 'REAL. Formaldehyde concentration in µg/m³. Example: 0.014.'
    sql: JSONB_EXTRACT_PATH_TEXT(air_quality_metrics, 'gases_ppm_ppb', 'formaldehyde_mg_m3')
  air_quality_metrics_gases_ppm_ppb_no2_ppb:
    description: 'BIGINT. Nitrogen dioxide concentration in ppb. Example: 27.'
    sql: JSONB_EXTRACT_PATH_TEXT(air_quality_metrics, 'gases_ppm_ppb', 'no2_ppb')
  air_quality_metrics_gases_ppm_ppb_ozone_ppb:
    description: 'BIGINT. Ozone concentration in ppb. Example: 11.0.'
    sql: JSONB_EXTRACT_PATH_TEXT(air_quality_metrics, 'gases_ppm_ppb', 'ozone_ppb')
  air_quality_metrics_gases_ppm_ppb_so2_ppb:
    description: 'BIGINT. Sulfur dioxide concentration in ppb. Example: 12.0.'
    sql: JSONB_EXTRACT_PATH_TEXT(air_quality_metrics, 'gases_ppm_ppb', 'so2_ppb')
  air_quality_metrics_gases_ppm_ppb_tvoc_ppb:
    description: 'BIGINT. Total Volatile Organic Compounds (TVOC) in ppb. Example: 89.0.'
    sql: JSONB_EXTRACT_PATH_TEXT(air_quality_metrics, 'gases_ppm_ppb', 'tvoc_ppb')
  air_quality_metrics_particulates_pm10_ug_m3:
    description: 'REAL. Particulate Matter (PM10) concentration in µg/m³. Example: 29.0.'
    sql: JSONB_EXTRACT_PATH_TEXT(air_quality_metrics, 'particulates', 'pm10_ug_m3')
measures:
  count:
    aggregate_type: count_distinct
    description: Count of distinct Air Quality Readings public identity values.
    label: Air Quality Readings Count
    sql: ${museum_artifact_large_public__air_quality_readings.aq_id}
