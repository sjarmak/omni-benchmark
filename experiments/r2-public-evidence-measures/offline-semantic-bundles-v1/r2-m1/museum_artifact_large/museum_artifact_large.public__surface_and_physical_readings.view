label: SurfaceAndPhysicalReadings
description: All columns of the public table SurfaceAndPhysicalReadings.
catalog: museum_artifact_large
schema: public
table_name: SurfaceAndPhysicalReadings
dimensions:
  n2_pct:
    description: 'REAL. Nitrogen percentage in the surface environment. Example: 78.75.'
    sql: '"N2_pct"'
  o2_pct:
    description: 'REAL. Oxygen percentage in the surface environment. Example: 20.8.'
    sql: '"O2_pct"'
  cond_risk:
    description: 'TEXT. Risk of damage due to environmental conditions. Possible values: High, Low, Medium.'
    sql: '"condRisk"'
  crack_note:
    description: 'TEXT. Notes about any cracks detected on the surface. Possible values: Minor Changes, No Changes, Significant Changes.'
    sql: '"crackNote"'
  deform_mm:
    description: 'REAL. Deformation in millimeters. Example: 0.08.'
    sql: deform_mm
  delta_e:
    description: 'REAL. Color difference in surface due to environmental factors. Example: 1.99.'
    sql: '"deltaE"'
  dust_mg_m2:
    description: 'REAL. Dust level in milligrams per square meter. Example: 1.74.'
    sql: '"dust_Mg_m2"'
  env_link:
    description: TEXT. Reference to the environmental reading. FK to EnvironmentalReadingsCore.monitor_code.
    sql: env_link
  metal_corr:
    description: 'REAL. Metal corrosion rate on the surface. Example: 0.04.'
    sql: '"metalCorr"'
  microbe_cfu:
    description: 'BIGINT. Microbial colony-forming units (CFU) detected. Example: 234.0.'
    sql: '"microbe_CFU"'
  moist_pct:
    description: 'REAL. Moisture percentage on the surface. Example: 10.3.'
    sql: moist_pct
  mold_idx:
    description: 'REAL. Mold index indicating the level of mold presence. Example: 0.1.'
    sql: '"moldIdx"'
  noise_d_b:
    description: 'BIGINT. Noise level measurement in decibels. Example: 47.'
    sql: '"noise_dB"'
  organic_deg:
    description: 'REAL. Organic degradation rate. Example: 0.47.'
    sql: '"organicDeg"'
  pest_activity:
    description: 'TEXT. Recorded pest activity level. **NULL means no pest activity reported.**. Possible values: High, Low, Medium.'
    sql: '"pestActivity"'
  pest_species:
    description: 'TEXT. Species of pests detected. **NULL means no species identified.**. Possible values: Beetles, Booklice, Moths, Silverfish.'
    sql: '"pestSpecies"'
  pest_trap:
    description: 'BIGINT. Number of pest traps set. Example: 10.'
    sql: '"pestTrap"'
  salt_risk:
    description: 'TEXT. Risk level due to salt exposure. Possible values: High, Low, Medium.'
    sql: '"saltRisk"'
  struct_stable:
    description: 'TEXT. Structural stability condition. **NULL means no stability data provided.**. Possible values: Major Issues, Minor Issues, Stable.'
    sql: '"structStable"'
  surf_dust:
    description: 'BIGINT. Amount of dust detected on the surface. Example: 5.7.'
    sql: '"surfDust"'
  surf_rh:
    description: 'REAL. Relative humidity on the surface. Example: 45.46.'
    sql: '"surfRH"'
  surf_temp:
    description: 'REAL. Temperature of the surface. Example: 19.11.'
    sql: '"surfTemp"'
  surf_id:
    description: BIGSERIAL. Unique identifier for each surface and physical reading. PK.
    sql: surf_id
  surface_p_h:
    description: 'REAL. pH level of the surface. Example: 6.7.'
    sql: '"surface_pH"'
  thermal_img:
    description: 'TEXT. Thermal image data of the surface. **NULL means no thermal image provided.**. Possible values: Attention Required, Critical, Normal.'
    sql: '"thermalImg"'
  vibra_mms2:
    description: 'REAL. Vibration measurements in millimeters squared. Example: 0.461.'
    sql: vibra_mms2
  wt_pct:
    description: 'REAL. Weight percentage of certain materials on the surface. Example: -0.001.'
    sql: '"wtPct"'
measures:
  count:
    aggregate_type: count_distinct
    description: Count of distinct SurfaceAndPhysicalReadings public identity values.
    label: SurfaceAndPhysicalReadings Count
    sql: ${museum_artifact_large_public__surface_and_physical_readings.surf_id}
