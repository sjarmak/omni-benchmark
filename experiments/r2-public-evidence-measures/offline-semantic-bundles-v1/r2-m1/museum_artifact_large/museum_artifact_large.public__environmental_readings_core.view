label: Environmental Readings
description: Environmental-reading rows with temperature and humidity conservation context.
catalog: museum_artifact_large
schema: public
table_name: EnvironmentalReadingsCore
dimensions:
  temperature_c:
    description: 'REAL. The recorded temperature in Celsius, extracted from the climate_metrics JSON. Possible values: 21, 18, 19, 20, 22.'
    label: Temperature (C)
    sql: '"TEMPc"'
    ai_context: 'Temperature Reading Implications: Ideal for most collections is 18-22°C. Fluctuations greater than 2°C within 24 hours can stress materials. Values outside 10-30°C may indicate control failure.'
  relative_humidity_pct:
    description: 'REAL. The recorded Relative Humidity in percent, extracted from the climate_metrics JSON. Example: 53.'
    label: Relative Humidity (%)
    sql: '"RH"'
    ai_context: 'Relative Humidity Implications: Ideal for mixed collections is 45-55%. Fluctuations greater than 5% within 24 hours are risky. Readings below 30% or above 65% indicate significant risk.'
  rhvar:
    description: 'REAL. The variance in Relative Humidity, extracted from the climate_metrics JSON. Possible values: 4, 5, 3, 0, 2, 1.'
    sql: '"RHvar"'
  air_press:
    description: 'REAL. Air pressure reading. **NULL means no air pressure data available.**. Example: 1020.0.'
    sql: air_press
  case_link:
    description: TEXT. Reference to the showcase. FK to Showcases.caseID.
    sql: case_link
  monitor_code:
    description: TEXT. Unique identifier for each environmental reading. PK.
    sql: monitor_code
  read_ts:
    description: 'TIMESTAMP. Timestamp of when the environmental reading was taken. Not NULL. Example: 2024-08-06T08:38:48.'
    sql: '"readTS"'
  temp_var24:
    description: 'REAL. The temperature variance over a 24-hour period, extracted from the climate_metrics JSON. Example: 0.35.'
    sql: '"tempVar24"'
measures:
  count:
    aggregate_type: count_distinct
    description: Count of distinct Environmental Readings public identity values.
    label: Environmental Readings Count
    sql: ${museum_artifact_large_public__environmental_readings_core.monitor_code}
