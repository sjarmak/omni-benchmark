label: Light and Radiation Readings
description: Light-reading rows with conservation-oriented lux context.
catalog: museum_artifact_large
schema: public
table_name: LightAndRadiationReadings
dimensions:
  light_intensity_lux:
    description: 'REAL. The recorded light level in lux, extracted from the radiation_exposure JSON. Example: 198.'
    label: Light Intensity (lux)
    sql: lux
    ai_context: 'Light Intensity Implications: Conservation standards recommend 50 lux for highly sensitive materials, 150-200 lux for medium sensitivity materials, and up to 300 lux for low sensitivity materials.'
  ir_w:
    description: 'REAL. The recorded Infrared radiation in watts, extracted from the radiation_exposure JSON. Example: 1.6.'
    sql: '"IR_W"'
  uv_u_w:
    description: 'REAL. The recorded Ultraviolet radiation in microwatts, extracted from the radiation_exposure JSON. Example: 7.3.'
    sql: '"UV_uW"'
  env_link:
    description: TEXT. Reference to the environmental reading. FK to EnvironmentalReadingsCore.monitor_code.
    sql: env_link
  rad_id:
    description: BIGSERIAL. Unique identifier for each light and radiation reading. PK.
    sql: rad_id
  vis_lxh:
    description: 'REAL. The recorded visible light exposure in lux-hours, extracted from the radiation_exposure JSON. Example: 72903.'
    sql: '"visLxh"'
measures:
  count:
    aggregate_type: count_distinct
    description: Count of distinct Light and Radiation Readings public identity values.
    label: Light and Radiation Readings Count
    sql: ${museum_artifact_large_public__light_and_radiation_readings.rad_id}
