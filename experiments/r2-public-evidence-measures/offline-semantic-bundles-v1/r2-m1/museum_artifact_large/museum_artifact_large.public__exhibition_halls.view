label: Exhibition Halls
description: Exhibition-hall rows with visitor-impact semantics and CCTV coverage context.
catalog: museum_artifact_large
schema: public
table_name: ExhibitionHalls
dimensions:
  average_daily_visitors:
    description: 'BIGINT. Daily visitor count for the exhibition hall. Example: 308.'
    label: Average Daily Visitors
    sql: CAST(JSONB_EXTRACT_PATH_TEXT(security_visitor_overview, 'visitor_statistics', 'avg_daily_visitors') AS DOUBLE PRECISION)
  visitor_flow:
    description: 'TEXT. Visitor flow data in the hall. Possible values: High, Low, Medium.'
    label: Visitor Flow
    sql: JSONB_EXTRACT_PATH_TEXT(security_visitor_overview, 'visitor_statistics', 'visitor_flow')
  average_dwell_minutes:
    description: 'BIGINT. Dwell time of visitors in minutes. Example: 16.'
    label: Average Dwell Time (minutes)
    sql: CAST(JSONB_EXTRACT_PATH_TEXT(security_visitor_overview, 'visitor_statistics', 'avg_dwell_minutes') AS DOUBLE PRECISION)
  cctv_coverage_level:
    description: 'TEXT. CCTV coverage status in the exhibition hall. Possible values: Full, Limited, Partial.'
    label: CCTV Coverage Level
    sql: JSONB_EXTRACT_PATH_TEXT(security_visitor_overview, 'security', 'cctv_coverage')
    ai_context: 'CCTV Coverage Levels: ''Full'' indicates 100% space coverage, ''Partial'' indicates 60-90% coverage, and ''Limited'' indicates less than 60% coverage.'
  hall_id:
    description: 'TEXT. Unique identifier for each exhibition hall. PK. Example: Hall-3.'
    sql: '"Hall_ID"'
  security_visitor_overview:
    description: JSONB column. Combines hall-level security system states with visitor statistics to support risk analysis and staffing optimisation.
    sql: security_visitor_overview
  security_visitor_overview_behaviour_notes:
    description: 'TEXT. Notes on visitor behavior in the hall. Possible values: Fair, Good, Poor.'
    sql: JSONB_EXTRACT_PATH_TEXT(security_visitor_overview, 'behaviour_notes')
  security_visitor_overview_security_access_control:
    description: 'TEXT. Access control status for the exhibition hall. Possible values: Active, Maintenance, Partial.'
    sql: JSONB_EXTRACT_PATH_TEXT(security_visitor_overview, 'security', 'access_control')
  security_visitor_overview_security_alarm_status:
    description: 'TEXT. Alarm system status in the exhibition hall. Possible values: Armed, Maintenance, Partial.'
    sql: JSONB_EXTRACT_PATH_TEXT(security_visitor_overview, 'security', 'alarm_status')
  security_visitor_overview_security_motion_detection:
    description: 'TEXT. Motion detection status in the hall. Possible values: Active, Maintenance, Partial.'
    sql: JSONB_EXTRACT_PATH_TEXT(security_visitor_overview, 'security', 'motion_detection')
  visitor_impact_risk:
    label: Visitor Impact Risk (VIR)
    description: Assesses the risk posed by visitor traffic to artifacts in exhibition halls.
    sql: (${average_daily_visitors} * CASE ${visitor_flow} WHEN 'Low' THEN 1.0 WHEN 'Medium' THEN 3.0 WHEN 'High' THEN 5.0 ELSE NULL END * ${average_dwell_minutes}) / 1000.0
    ai_context: Use this modeled field for Visitor Impact Risk (VIR); do not reconstruct its formula.
measures:
  count:
    aggregate_type: count_distinct
    description: Count of distinct Exhibition Halls public identity values.
    label: Exhibition Halls Count
    sql: ${museum_artifact_large_public__exhibition_halls.hall_id}
