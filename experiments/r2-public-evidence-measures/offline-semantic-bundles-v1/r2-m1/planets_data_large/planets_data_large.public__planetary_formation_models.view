label: planetary_formation_models
description: All columns of the public table planetary_formation_models.
catalog: planets_data_large
schema: public
table_name: planetary_formation_models
dimensions:
  atmospheric_acquisition_mechanism:
    description: 'text. Mechanism by which planet acquired its atmosphere. Possible values: Direct Collapse, Disk Instability + Accretion, Envelope Capture, Nebular Capture, Outgassing, Pebble-enhanced Accretion.'
    sql: '"AtmosphericAcquisitionMechanism"'
  current_location_au:
    description: 'real. Current orbital location in astronomical units. Possible values: 0.045, 0.38, 1.12, 1.85, 2.1, 45.8.'
    sql: '"CURRENT_LOCATION_AU"'
  core_accretion_model:
    description: 'boolean. Flag indicating use of core accretion formation model. Possible values: False, True.'
    sql: '"CoreAccretionModel"'
  formationref:
    description: 'bigint. Primary key identifier for planetary formation model records. PK. Possible values: 19001, 19002, 19003, 19004, 19005, 19006.'
    sql: '"FORMATIONREF"'
  formation_probability:
    description: 'real. Probability that this formation pathway occurred (0.0 to 1.0). Possible values: 0.65, 0.68, 0.73, 0.78, 0.85, 0.92.'
    sql: '"FORMATION_PROBABILITY"'
  formation_location_au:
    description: 'real. Predicted initial formation location in astronomical units. Possible values: 0.38, 1.12, 12.8, 45.8, 5.2, 8.5.'
    sql: '"FormationLocation_AU"'
  gravitational_instability_model:
    description: 'boolean. Flag indicating use of gravitational instability formation model. Possible values: False, True.'
    sql: '"GRAVITATIONAL_INSTABILITY_MODEL"'
  last_model_update:
    description: 'date. Date when formation model was last updated or revised. Possible values: 2023-08-14, 2023-09-22, 2023-10-30, 2023-11-15, 2023-12-08, 2024-01-20.'
    sql: '"LastModelUpdate"'
  magma_ocean_duration_myr:
    description: 'real. Duration of magma ocean phase in million years. **NULL means magma ocean phase was not modeled.**. Possible values: 450.0, 850.0.'
    sql: '"MAGMA_OCEAN_DURATION_Myr"'
  model_assumptions:
    description: 'text. Key assumptions made in the formation model. **NULL means model assumptions were not documented.**. Possible values: Core formation followed by instability, Enhanced solid accretion via pebbles, Fragmentation via gravitational instability, Rocky planet formation in inner disk, Water delivery via late heavy bombardment.'
    sql: '"MODEL_ASSUMPTIONS"'
  migration_timescale_myr:
    description: 'real. Timescale for orbital migration in million years. **NULL means migration timescale was not calculated.**. Possible values: 0.1, 2.8, 5.2, 8.9.'
    sql: '"MigrationTimescale_Myr"'
  notes:
    description: 'text. Additional notes or comments about the formation model. **NULL means no additional observations were recorded.**. Example: Active M dwarf with flares.'
    sql: '"NOTES"'
  numerical_code_used:
    description: 'text. Name or identifier of numerical code used for formation modeling. Possible values: ExoCAM, FARGO3D + MESA, MESA + REBOUNDX, N-body + Hydro, PHANTOM, REBOUND.'
    sql: '"NumericalCodeUsed"'
  protoplanetary_disk_lifetime_myr:
    description: 'real. Assumed lifetime of protoplanetary disk in million years. Possible values: 0.8, 1.8, 2.1, 3.5, 4.2, 5.8.'
    sql: '"PROTOPLANETARY_DISK_LIFETIME_Myr"'
  water_ocean_formation_time_myr:
    description: 'real. Time when water oceans first formed in million years. **NULL means water ocean formation was not modeled.**. Possible values: 125.0, 280.0, 50.0.'
    sql: '"WaterOceanFormationTime_Myr"'
  best_fit_parameters:
    description: 'text. Best-fit parameter values from model optimization. **NULL means parameter optimization was not performed.**. Possible values: {"core_mass": 10.0}, {"disk_mass": 0.01, "alpha_viscosity": 0.003}, {"disk_temp": 20, "toomre_Q": 1.2}, {"water_fraction": 0.1}.'
    sql: best_fit_parameters
  core_formation_timescale_myr:
    description: 'real. Timescale for planetary core formation in million years. **NULL means core formation timescale was not calculated.**. Possible values: 10.5, 25.8, 3.2, 5.2.'
    sql: '"core_formation_timescale_Myr"'
  disk_migration_model:
    description: 'boolean. Flag indicating inclusion of disk migration in the model. Possible values: False, True.'
    sql: disk_migration_model
  formation_model_type:
    description: 'text. Type of formation model used (core accretion, gravitational instability, hybrid). Possible values: Core Accretion, Gravitational Instability, Hybrid Model, In-situ Formation, Late Bombardment, Pebble Accretion.'
    sql: formation_model_type
  migration_distance_au:
    description: 'real. Total migration distance from formation to current location in AU. Possible values: -10.95, -5.155, -6.4, 0.0.'
    sql: '"migration_distance_AU"'
  observational_constraints:
    description: 'text. Observational constraints used to constrain the formation model. Possible values: Astrometry + Transit, Atmospheric Spectroscopy, Direct Imaging, High-precision RV, Transit + RV constraints, Transit Timing Variations.'
    sql: observational_constraints
  planet_link:
    description: 'bigint. Foreign key reference to the planet being modeled. FK to planets(planetRef). Example: 1.'
    sql: '"planetLink"'
  snow_line_location_au:
    description: 'real. Location of water snow line in the disk in astronomical units. **NULL means snow line location was not modeled.**. Possible values: 2.8.'
    sql: '"snow_line_location_AU"'
measures:
  count:
    aggregate_type: count_distinct
    description: Count of distinct planetary_formation_models public identity values.
    label: planetary_formation_models Count
    sql: ${planets_data_large_public__planetary_formation_models.formationref}
