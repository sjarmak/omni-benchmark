label: data_quality_tracking
description: All columns of the public table data_quality_tracking.
catalog: planets_data_large
schema: public
table_name: data_quality_tracking
dimensions:
  denserr1:
    description: Positive uncertainty from 'pl_denserr1' in planetary density, in g/cm³. REAL representing +1σ error in density calculation. Contains  NULL when density uncertainty cannot be calculated due to missing mass or radius uncertainties.
    sql: denserr1
  denserr2:
    description: Negative uncertainty from 'pl_denserr2' in planetary density, in g/cm³. REAL representing -1σ error in density calculation. Contains  NULL when density uncertainty cannot be calculated.
    sql: denserr2
  disterr1:
    description: Positive uncertainty from 'st_disterr1' in stellar distance, in parsecs. REAL representing +1σ error in distance measurement. Contains  NULL when stellar distance uncertainty is not available.
    sql: disterr1
  disterr2:
    description: Negative uncertainty from 'st_disterr2' in stellar distance, in parsecs. REAL representing -1σ error in distance measurement. Contains  NULL when stellar distance uncertainty is not available.
    sql: disterr2
  eccerr1:
    description: Positive uncertainty from 'pl_orbeccenerr1' in eccentricity. REAL representing +1σ error, typically small values <0.1. Contains  NULL when eccentricity uncertainty is not available or eccentricity is unconstrained.
    sql: eccerr1
  eccerr2:
    description: Negative uncertainty from 'pl_orbeccenerr2' in eccentricity. REAL representing -1σ error, often asymmetric for low-eccentricity orbits. Contains  NULL when eccentricity uncertainty is not available.
    sql: eccerr2
  inclerr1:
    description: Positive uncertainty from 'pl_orbinclerr1' in inclination, in degrees. REAL representing +1σ angular error. Contains  NULL when inclination uncertainty is not available or inclination is unconstrained.
    sql: inclerr1
  inclerr2:
    description: Negative uncertainty from 'pl_orbinclerr2' in inclination, in degrees. REAL representing -1σ angular error. Contains  NULL when inclination uncertainty is not available.
    sql: inclerr2
  limitflags:
    description: JSONB column. Consolidates all measurement limit flags indicating whether values represent actual measurements, upper limits, or lower limits for planetary and stellar parameters.
    sql: limitflags
  masserr1:
    description: Positive uncertainty from 'pl_bmassjerr1' in planetary mass, in Jupiter masses. REAL representing +1σ error in mass measurement. Contains  NULL when mass uncertainty is not available or mass is unconstrained.
    sql: masserr1
  masserr2:
    description: Negative uncertainty from 'pl_bmassjerr2' in planetary mass, in Jupiter masses. REAL representing -1σ error, often asymmetric for low-mass planets. Contains  NULL when mass uncertainty is not available.
    sql: masserr2
  masssource:
    description: 'Mass determination method from ''pl_bmassprov''. VARCHAR(50) with values: ''Msini'' (minimum mass from radial velocity, M×sin(i)), ''Mass'' (true mass from transit+RV or other methods), ''Msin(i)/sin(i)'' (mass corrected for inclination). Contains  NULL when no mass measurement is available.'
    sql: masssource
  optmagerr:
    description: Uncertainty from 'st_optmagerr' in stellar magnitude. REAL representing symmetric 1σ error in magnitude measurement. Contains  NULL when magnitude uncertainty is not available.
    sql: optmagerr
  perioderr1:
    description: Positive uncertainty from 'pl_orbpererr1' in orbital period, in days. REAL representing +1σ error. Contains  NULL when period uncertainty is not available or period itself is unknown.
    sql: perioderr1
  perioderr2:
    description: Negative uncertainty from 'pl_orbpererr2' in orbital period, in days. REAL representing -1σ error, typically stored as negative value. Contains  NULL when period uncertainty is not available.
    sql: perioderr2
  qualityref:
    description: A SERIAL primary key uniquely identifying each data quality record.
    sql: qualityref
  raderr1:
    description: Positive uncertainty from 'pl_radjerr1' in planetary radius, in Jupiter radii. REAL representing +1σ error in radius measurement. Contains  NULL when radius uncertainty is not available or radius is unconstrained.
    sql: raderr1
  raderr2:
    description: Negative uncertainty from 'pl_radjerr2' in planetary radius, in Jupiter radii. REAL representing -1σ error in radius measurement. Contains  NULL when radius uncertainty is not available.
    sql: raderr2
  semimajerr1:
    description: Positive uncertainty from 'pl_orbsmaxerr1' in semi-major axis, in AU. REAL representing +1σ error in orbital distance. Contains  NULL when semi-major axis uncertainty is not available.
    sql: semimajerr1
  semimajerr2:
    description: Negative uncertainty from 'pl_orbsmaxerr2' in semi-major axis, in AU. REAL representing -1σ error, accommodating asymmetric uncertainties. Contains  NULL when semi-major axis uncertainty is not available.
    sql: semimajerr2
  stellarmasserr1:
    description: Positive uncertainty from 'st_masserr1' in stellar mass, in solar masses. REAL representing +1σ error in stellar mass. Contains  NULL when stellar mass uncertainty is not available.
    sql: stellarmasserr1
  stellarmasserr2:
    description: Negative uncertainty from 'st_masserr2' in stellar mass, in solar masses. REAL representing -1σ error in stellar mass. Contains  NULL when stellar mass uncertainty is not available.
    sql: stellarmasserr2
  stellarraderr1:
    description: Positive uncertainty from 'st_raderr1' in stellar radius, in solar radii. REAL representing +1σ error in stellar radius. Contains  NULL when stellar radius uncertainty is not available.
    sql: stellarraderr1
  stellarraderr2:
    description: Negative uncertainty from 'st_raderr2' in stellar radius, in solar radii. REAL representing -1σ error in stellar radius. Contains  NULL when stellar radius uncertainty is not available.
    sql: stellarraderr2
  targetlink:
    description: Foreign key INTEGER referencing planets(PlanetRef), linking quality metrics to a specific planet.
    sql: targetlink
  temperr1:
    description: Positive uncertainty from 'st_tefferr1' in stellar temperature, in Kelvin. REAL representing +1σ error in temperature measurement. Contains  NULL when temperature uncertainty is not available.
    sql: temperr1
  temperr2:
    description: Negative uncertainty from 'st_tefferr2' in stellar temperature, in Kelvin. REAL representing -1σ error, accommodating larger negative uncertainties. Contains  NULL when temperature uncertainty is not available.
    sql: temperr2
  updatestamp:
    description: Data update timestamp from 'rowupdate'. DATE field in YYYY-MM-DD format tracking when the record was last updated, with dates ranging from 2014-05-14 to 2016-07-07 in current dataset.
    sql: updatestamp
  limitflags_planetary_limits_dens_lim:
    description: 'Limit flag from ''pl_denslim'' for planetary density. REAL with values: 0 (measured value), 1 (upper limit), -1 (lower limit). Contains  NULL when limit status is unknown or not applicable.'
    sql: JSONB_EXTRACT_PATH_TEXT(limitflags, 'planetary_limits', 'Dens_Lim')
  limitflags_planetary_limits_ecc_lim:
    description: 'Limit flag from ''pl_orbeccenlim'' for eccentricity. REAL with values: 0 (measured value), 1 (upper limit), -1 (lower limit). Contains  NULL when limit status is unknown or not applicable.'
    sql: JSONB_EXTRACT_PATH_TEXT(limitflags, 'planetary_limits', 'Ecc_Lim')
  limitflags_planetary_limits_incl_lim:
    description: 'Limit flag from ''pl_orbincllim'' for inclination. REAL with values: 0 (measured value), 1 (upper limit), -1 (lower limit). Contains  NULL when limit status is unknown or not applicable.'
    sql: JSONB_EXTRACT_PATH_TEXT(limitflags, 'planetary_limits', 'Incl_Lim')
  limitflags_planetary_limits_mass_lim:
    description: 'Limit flag from ''pl_bmassjlim'' for planetary mass. REAL with values: 0 (measured value), 1 (upper limit), -1 (lower limit). Contains  NULL when limit status is unknown or not applicable.'
    sql: JSONB_EXTRACT_PATH_TEXT(limitflags, 'planetary_limits', 'Mass_Lim')
  limitflags_planetary_limits_period_lim:
    description: 'Limit flag from ''pl_orbperlim'' for orbital period. REAL with values: 0 (measured value), 1 (upper limit), -1 (lower limit). Contains  NULL when limit status is unknown or not applicable.'
    sql: JSONB_EXTRACT_PATH_TEXT(limitflags, 'planetary_limits', 'Period_Lim')
  limitflags_planetary_limits_rad_lim:
    description: 'Limit flag from ''pl_radjlim'' for planetary radius. REAL with values: 0 (measured value), 1 (upper limit), -1 (lower limit). Contains  NULL when limit status is unknown or not applicable.'
    sql: JSONB_EXTRACT_PATH_TEXT(limitflags, 'planetary_limits', 'Rad_Lim')
  limitflags_planetary_limits_semimaj_lim:
    description: 'Limit flag from ''pl_orbsmaxlim'' for semi-major axis. REAL with values: 0 (measured value), 1 (upper limit), -1 (lower limit). Contains  NULL when limit status is unknown or not applicable.'
    sql: JSONB_EXTRACT_PATH_TEXT(limitflags, 'planetary_limits', 'Semimaj_Lim')
  limitflags_stellar_limits_dist_lim:
    description: 'Limit flag from ''st_distlim'' for stellar distance. REAL with values: 0 (measured value), 1 (upper limit), -1 (lower limit). Contains  NULL when limit status is unknown or not applicable.'
    sql: JSONB_EXTRACT_PATH_TEXT(limitflags, 'stellar_limits', 'Dist_Lim')
  limitflags_stellar_limits_opt_mag_lim:
    description: 'Limit flag from ''st_optmaglim'' for stellar magnitude. REAL with values: 0 (measured value), 1 (upper limit), -1 (lower limit). Contains  NULL when limit status is unknown or not applicable.'
    sql: JSONB_EXTRACT_PATH_TEXT(limitflags, 'stellar_limits', 'OptMag_Lim')
  limitflags_stellar_limits_stellar_mass_lim:
    description: 'Limit flag from ''st_masslim'' for stellar mass. REAL with values: 0 (measured value), 1 (upper limit), -1 (lower limit). Contains  NULL when limit status is unknown or not applicable.'
    sql: JSONB_EXTRACT_PATH_TEXT(limitflags, 'stellar_limits', 'StellarMass_Lim')
  limitflags_stellar_limits_stellar_rad_lim:
    description: 'Limit flag from ''st_radlim'' for stellar radius. REAL with values: 0 (measured value), 1 (upper limit), -1 (lower limit). Contains  NULL when limit status is unknown or not applicable.'
    sql: JSONB_EXTRACT_PATH_TEXT(limitflags, 'stellar_limits', 'StellarRad_Lim')
  limitflags_stellar_limits_temp_lim:
    description: 'Limit flag from ''st_tefflim'' for stellar temperature. REAL with values: 0 (measured value), 1 (upper limit), -1 (lower limit). Contains  NULL when limit status is unknown or not applicable.'
    sql: JSONB_EXTRACT_PATH_TEXT(limitflags, 'stellar_limits', 'Temp_Lim')
measures:
  count:
    aggregate_type: count_distinct
    description: Count of distinct data_quality_tracking public identity values.
    label: data_quality_tracking Count
    sql: ${planets_data_large_public__data_quality_tracking.qualityref}
