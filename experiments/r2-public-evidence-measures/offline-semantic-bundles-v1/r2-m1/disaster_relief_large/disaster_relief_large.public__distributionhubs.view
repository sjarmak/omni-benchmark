label: Distribution Hubs
description: Distribution-hub records with row-level utilization, turnover, and overload semantics.
catalog: disaster_relief_large
schema: public
table_name: distributionhubs
dimensions:
  hub_utilization_pct:
    description: 'REAL. Hub''s utilization percentage. Example: 9.4.'
    label: Hub Utilization (%)
    sql: hubutilpct
  stock_turn_rate:
    description: 'REAL. Stock turnover rate. Example: 3.31.'
    label: Stock Turnover Rate
    sql: stockturnrate
  cold_store_temp_c:
    description: 'REAL. Cold storage temperature in Celsius. **NULL means cold storage temperature not recorded.**. Example: 6.6.'
    sql: cold_store_temp_c
  coldstorecapm3:
    description: 'REAL. Cold storage capacity in cubic meters. Example: 249.'
    sql: coldstorecapm3
  hub_cap_tons:
    description: 'REAL. Hub''s capacity in tons. Example: 5101.'
    sql: hub_cap_tons
  hubregistry:
    description: VARCHAR(20). Unique distribution hub identifier. PK.
    sql: hubregistry
  invaccpct:
    description: 'REAL. Inventory acceptance percentage. Example: 91.3.'
    sql: invaccpct
  store_cap_m3:
    description: 'REAL. Hub''s storage capacity in cubic meters. Example: 93293.'
    sql: store_cap_m3
  storeavailm3:
    description: 'REAL. Available storage capacity in cubic meters. Example: 7279.'
    sql: storeavailm3
  warehouse_state:
    description: 'TEXT. Warehouse operational state. Possible values: Excellent, Fair, Good, Poor.'
    sql: warehouse_state
  is_hub_overloaded:
    label: Hub Overload
    description: A state where a distribution hub's operational metrics indicate it is under excessive strain.
    sql: (${hub_utilization_pct} / 100.0) + (${stock_turn_rate} / 10.0) > 1.5
    ai_context: Use this modeled field for Hub Overload; do not reconstruct its formula.
measures:
  count:
    aggregate_type: count_distinct
    description: Count of distinct Distribution Hubs public identity values.
    label: Distribution Hubs Count
    sql: ${disaster_relief_large_public__distributionhubs.hubregistry}
