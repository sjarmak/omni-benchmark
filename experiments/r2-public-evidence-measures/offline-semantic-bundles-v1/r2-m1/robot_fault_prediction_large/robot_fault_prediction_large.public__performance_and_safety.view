label: performance_and_safety
description: Public semantic view for performance_and_safety.
catalog: robot_fault_prediction_large
schema: public
table_name: performance_and_safety
dimensions:
  ps_emergency_stops:
    description: 'BIGINT. Count of emergency stops. Possible values: 0, 1, 2, 3, 4, 5.'
    label: PS.emergency_stops
    sql: emergencystopcount
  ps_collisions:
    description: 'BIGINT. Count of collisions. Possible values: 0, 1, 2, 3.'
    label: PS.collisions
    sql: collisioncount
  ps_zone_violations:
    description: 'BIGINT. Number of zone violations. Example: 1.'
    label: PS.zone_violations
    sql: zoneviolnum
  ps_speed_violations:
    description: 'BIGINT. Number of speed violations. Example: 5.'
    label: PS.speed_violations
    sql: speedviolnum
  ps_overloads:
    description: 'BIGINT. Count of overloads. Possible values: 0, 1, 2, 3, 4, 5.'
    label: PS.overloads
    sql: overloadcnt
  ps_condition_index:
    description: 'REAL. Condition index value of the robot. **NULL means no condition index data available.**. Example: 0.152.'
    label: PS.condition_index
    sql: conditionindexval
    ai_context: 'Condition Index Tiers: A Condition Index is ''Excellent'' if > 0.9, ''Good'' if 0.7-0.9, ''Fair'' if 0.5-0.7, or ''Poor'' if < 0.5 (significant wear or risk).'
  ps_safety_state:
    description: 'TEXT. Safety state value of the robot. Possible values: Warning, ✓ Normal, ✗ Emergency.'
    label: PS.safety_state
    sql: safetystateval
    ai_context: 'Safety State Meanings: Key safety states are: ''✓ Normal'' (normal operation), ''Protective Stop'' (database value ''Warning''), and ''✗ Emergency'' (critical stop, database value ''✗ Emergency'').'
  ps_calibration_state:
    description: 'CHAR(20). Calibration state value of the robot. Possible values: 0, N, Y.'
    label: PS.calibration_state
    sql: calibstateval
    ai_context: 'Calibration State Meanings: Calibration states are: ''Success'' (database value ''Y''), ''Failed'' (database value ''0''), or ''Pending'' (database value ''N'').'
  ps_air_pressure:
    description: 'REAL. Air pressure value in the system. Example: 6.69.'
    label: PS.air_pressure
    sql: airpressval
    ai_context: 'Air Pressure Status: Air pressure is ''Normal'' if 5.5-7.0 bar, ''Low'' if < 5.5 bar, or ''High'' if > 7.0 bar.'
  effectivenessactuation:
    description: TEXT. Foreign key to the actuation_data table (ActReg). PK, FK to actuation_data.
    sql: effectivenessactuation
  effectivenessindexval:
    description: 'REAL. Effectiveness index value of the robot. **NULL means no effectiveness index data available.**. Example: 0.603.'
    sql: effectivenessindexval
  effectivenessrobot:
    description: TEXT. Foreign key to the robot_details table (BotDetReg). FK to robot_details.
    sql: effectivenessrobot
  energyusekwhval:
    description: 'TEXT. Energy use in KWH. **NULL means no energy usage data available.**. Example: 70.54 kWh.'
    sql: energyusekwhval
  pwrfactorval:
    description: 'TEXT. Power factor value. **NULL means no power factor data available.**. Example: PF=0.82.'
    sql: pwrfactorval
  qualitymeasureval:
    description: 'REAL. Quality measure value for the robot. **NULL means no quality measure data available.**. Example: 0.337.'
    sql: qualitymeasureval
  toolchangecount:
    description: 'BIGINT. Number of tool changes. **NULL means no tool change data available.**. Example: 940.0.'
    sql: toolchangecount
  toolwearpct:
    description: TEXT. Tool wear percentage. Indicates the current wear level of the robot's end effector or machining tool, expressed as a percentage of total usable life. NULL means tool wear monitoring is inactive or data unavailable
    sql: toolwearpct
measures:
  count:
    aggregate_type: count_distinct
    description: Count of distinct performance_and_safety public identity values.
    label: performance_and_safety Count
    sql: ${robot_fault_prediction_large_public__performance_and_safety.effectivenessactuation}
