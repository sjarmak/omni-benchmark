label: qualitycontrol
description: All columns of the public table qualitycontrol.
catalog: archeology_scan_large
schema: public
table_name: qualitycontrol
dimensions:
  accucheck:
    description: 'TEXT. Accuracy assessment evaluation results. Possible values: Accuracy check not required, standard quality sufficient.'
    sql: accucheck
  archstat:
    description: 'TEXT. Archival status for long-term data preservation. **NULL means archival process not initiated or status not determined.**. Example: Verified.'
    sql: archstat
  arcref:
    description: TEXT. Reference to associated archeologys project. FK to Projects.
    sql: arcref
  copystat:
    description: 'TEXT. Copyright status and intellectual property rights. **NULL means copyright status not established or legal review pending.**. Example: Open Access.'
    sql: copystat
  crewref:
    description: TEXT. Reference to operator who performed quality control. FK to Personnel.
    sql: crewref
  ctrlstate:
    description: 'TEXT. Quality control status and validation state. Possible values: Failed, Passed, Pending.'
    sql: ctrlstate
  pubstat:
    description: 'TEXT. Publication status and dissemination readiness. Possible values: Draft status, preparation for submission.'
    sql: pubstat
  qualregistry:
    description: BIGSERIAL. Auto-generated unique identifier for quality control record. PK = QualityControl(QualRegistry).
    sql: qualregistry
  refmention:
    description: 'TEXT. Data citation format and attribution requirements. Example: Citation-8447.'
    sql: refmention
  remark:
    description: 'TEXT. Additional notes and observations for quality control. **NULL means no additional notes recorded or observations not documented.**. Example: Sell shoulder understand serious degree particular game..'
    sql: remark
  valimeth:
    description: 'TEXT. Validation method used for quality assessment. Possible values: Automated, Hybrid, Visual.'
    sql: valimeth
  valistate:
    description: 'TEXT. Validation status and completion state. Possible values: Validation rejected, data quality issues identified.'
    sql: valistate
measures:
  count:
    aggregate_type: count_distinct
    description: Count of distinct qualitycontrol public identity values.
    label: qualitycontrol Count
    sql: ${archeology_scan_large_public__qualitycontrol.qualregistry}
