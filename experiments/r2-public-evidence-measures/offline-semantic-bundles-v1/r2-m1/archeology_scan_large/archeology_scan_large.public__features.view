label: features
description: All columns of the public table features.
catalog: archeology_scan_large
schema: public
table_name: features
dimensions:
  equipref:
    description: TEXT. Reference to equipment used for feature extraction. FK to Equipment.
    sql: equipref
  feature_analysis:
    description: JSONB column. Archaeological feature analysis results including counts, material classification, and analysis completion status
    sql: feature_analysis
  traitextract:
    description: 'TEXT. Method used for feature extraction analysis. Possible values: Automatic, Manual, Semi-automatic.'
    sql: traitextract
  traitregistry:
    description: BIGSERIAL. Auto-generated unique identifier for feature analysis record. PK = Features(TraitRegistry).
    sql: traitregistry
  zoneref:
    description: TEXT. Reference to site where features were analyzed. FK to Sites.
    sql: zoneref
  feature_analysis_analysis_status_hue_study:
    description: 'TEXT. Color analysis results and classification. Possible values: Completed, Not Required, Partial.'
    sql: JSONB_EXTRACT_PATH_TEXT(feature_analysis, 'Analysis_Status', 'Hue_Study')
  feature_analysis_analysis_status_pattern_note:
    description: 'TEXT. Pattern recognition analysis and observations. Possible values: Completed, Not Required, Partial.'
    sql: JSONB_EXTRACT_PATH_TEXT(feature_analysis, 'Analysis_Status', 'Pattern_Note')
  feature_analysis_analysis_status_texture_study:
    description: 'TEXT. Texture analysis results and patterns. Possible values: Completed, Not Required, Partial.'
    sql: JSONB_EXTRACT_PATH_TEXT(feature_analysis, 'Analysis_Status', 'Texture_Study')
  feature_analysis_arti_count:
    description: 'BIGINT. Number of artifacts detected or counted. Example: 71.'
    sql: JSONB_EXTRACT_PATH_TEXT(feature_analysis, 'Arti_Count')
  feature_analysis_mat_kind:
    description: 'TEXT. Material type classification of analyzed features. Possible values: Ceramic, Metal, Mixed, Organic, Stone.'
    sql: JSONB_EXTRACT_PATH_TEXT(feature_analysis, 'Mat_Kind')
  feature_analysis_struct_kind:
    description: 'TEXT. Type of structure identified in analysis. Possible values: Artifact, Complex, Floor, Foundation, Wall.'
    sql: JSONB_EXTRACT_PATH_TEXT(feature_analysis, 'Struct_Kind')
  feature_analysis_trait_count:
    description: 'BIGINT. Number of features identified in analysis. Example: 516.'
    sql: JSONB_EXTRACT_PATH_TEXT(feature_analysis, 'Trait_Count')
measures:
  count:
    aggregate_type: count_distinct
    description: Count of distinct features public identity values.
    label: features Count
    sql: ${archeology_scan_large_public__features.traitregistry}
