label: Scan Registration
description: Registration records with row-level alignment method, accuracy, error, and quality-threshold semantics.
catalog: archeology_scan_large
schema: public
table_name: registration
dimensions:
  registration_accuracy_mm:
    description: 'REAL. Registration accuracy measurement in millimeters. Example: 0.84.'
    label: Registration Accuracy (mm)
    sql: CAST(JSONB_EXTRACT_PATH_TEXT(reg_accuracy, 'Log_Accu_Mm') AS DOUBLE PRECISION)
  error_value_mm:
    description: 'REAL. Error value measurement in millimeters. Example: 6.962.'
    label: Registration Error (mm)
    sql: CAST(JSONB_EXTRACT_PATH_TEXT(reg_accuracy, 'Err_Val_Mm') AS DOUBLE PRECISION)
  registration_method:
    description: 'TEXT. Registration method or algorithm used. Possible values: Feature-based, Hybrid, Target-based.'
    label: Registration Method
    sql: JSONB_EXTRACT_PATH_TEXT(reg_accuracy, 'Log_Method')
    ai_context: 'Registration Method: A categorization of alignment techniques with specific methodologies: ''ICP'' (Iterative Closest Point algorithm for point cloud alignment), ''Target-based'' (alignment using physical reference markers), ''Hybrid'' (combination of automatic and manual alignment), and ''SLAM'' (Simultaneous Localization and Mapping for real-time registration). Each method has distinct accuracy characteristics and use cases.'
  arcref:
    description: TEXT. Reference to associated archeologys project. FK to Projects.
    sql: arcref
  crewref:
    description: TEXT. Reference to operator who performed registration. FK to Personnel.
    sql: crewref
  logregistry:
    description: BIGSERIAL. Auto-generated unique identifier for registration record. PK = Registration(LogRegistry).
    sql: logregistry
  reg_accuracy:
    description: JSONB column. Registration accuracy metrics including reference points, error measurements, and transformation parameters
    sql: reg_accuracy
  reg_accuracy_ctrl_pts:
    description: 'TEXT. Control points used for geometric registration. Example: 73.'
    sql: JSONB_EXTRACT_PATH_TEXT(reg_accuracy, 'Ctrl_Pts')
  reg_accuracy_err_scale:
    description: 'TEXT. Error metrics and measurement standards. Possible values: Cloud-to-Cloud, Cloud-to-Mesh, RMSE.'
    sql: JSONB_EXTRACT_PATH_TEXT(reg_accuracy, 'Err_Scale')
  reg_accuracy_ref_mark:
    description: 'TEXT. Reference markers used for registration process. Example: 40.'
    sql: JSONB_EXTRACT_PATH_TEXT(reg_accuracy, 'Ref_Mark')
  reg_accuracy_transform:
    description: 'TEXT. Transformation matrix applied during registration. Example: Matrix-47.'
    sql: JSONB_EXTRACT_PATH_TEXT(reg_accuracy, 'Transform')
  meets_registration_quality_threshold:
    label: Registration Quality Threshold
    description: Defines the quality threshold for scan registration in archaeological documentation based on error propagation analysis.
    sql: ${registration_accuracy_mm} < 1.0 AND ${error_value_mm} < 2.0
    ai_context: Use this modeled field for Registration Quality Threshold; do not reconstruct its formula.
measures:
  count:
    aggregate_type: count_distinct
    description: Count of distinct Scan Registration public identity values.
    label: Scan Registration Count
    sql: ${archeology_scan_large_public__registration.logregistry}
