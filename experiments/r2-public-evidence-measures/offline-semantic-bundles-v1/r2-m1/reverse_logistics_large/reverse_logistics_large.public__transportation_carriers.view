label: transportation_carriers
description: All columns of the public table transportation_carriers.
catalog: reverse_logistics_large
schema: public
table_name: transportation_carriers
dimensions:
  account_manager_name:
    description: 'TEXT. The name of the dedicated account manager. **NULL means no dedicated manager is assigned.** Example: Manager Name 19.'
    sql: account_manager_name
  api_integration_key:
    description: 'TEXT. The API key for system integration. **NULL means API integration is not set up.** Example: JPA322BGEC5LTKSXK6IYXGJI613CH64K.'
    sql: api_integration_key
  average_cost_per_mile:
    description: 'REAL. The average cost per mile for shipping. Example: 3.96.'
    sql: average_cost_per_mile
  average_transit_time_days:
    description: 'REAL. The average transit time in days for standard shipments. Example: 5.7.'
    sql: average_transit_time_days
  billing_cycle:
    description: 'TEXT. The billing frequency. Possible values: Monthly, Bi-weekly.'
    sql: billing_cycle
  carbon_offset_program_participant:
    description: 'BOOLEAN. Indicates if the carrier participates in a carbon offset program. Possible values: True, False.'
    sql: carbon_offset_program_participant
  carrier_id:
    description: 'BIGINT. Unique identifier for the transportation carrier. PK. Example: 1.'
    sql: carrier_id
  carrier_name:
    description: 'TEXT. The name of the carrier company. Example: Carrier-1 Logistics.'
    sql: carrier_name
  contract_number:
    description: 'TEXT. The contract number with the carrier. **NULL indicates non-contractual or ad-hoc usage.** Example: CTR-D7JTHHBV.'
    sql: contract_number
  customer_satisfaction_index:
    description: 'REAL. A customer satisfaction score from 1-100. Example: 81.1.'
    sql: customer_satisfaction_index
  customer_service_phone:
    description: 'TEXT. The customer service phone number for the carrier. Example: 555-152-6470.'
    sql: customer_service_phone
  emergency_hotline:
    description: 'TEXT. An emergency contact number. Example: 555-210-1233.'
    sql: emergency_hotline
  fleet_size:
    description: Total number of vehicles in the carrier's fleet.
    sql: fleet_size
  fuel_surcharge_policy:
    description: 'TEXT. A description of the carrier''s fuel surcharge policy. **NULL means the fuel surcharge is included in the base rate.** Example: A chain of custody form is required for all secure destruction services.'
    sql: fuel_surcharge_policy
  hazardous_materials_certified:
    description: Boolean indicating if the carrier is certified to transport hazardous materials.
    sql: hazardous_materials_certified
  insurance_coverage_limit:
    description: 'BIGINT. The maximum insurance coverage limit per shipment. Example: 100000.'
    sql: insurance_coverage_limit
  is_preferred_carrier:
    description: 'BOOLEAN. Indicates if this is a preferred carrier. Possible values: True, False.'
    sql: is_preferred_carrier
  main_contact_email:
    description: 'TEXT. The main operational email contact for the carrier. Example: ops.carrier1@example.com.'
    sql: main_contact_email
  max_payload_kg:
    description: Maximum payload capacity in kilograms.
    sql: max_payload_kg
  operational_regions:
    description: 'JSONB. A JSON array of regions the carrier operates in. Example: [Europe].'
    sql: operational_regions
  pickup_scheduling_cutoff_time:
    description: 'TIME. The cutoff time for scheduling same-day pickups. Example: 17:00.'
    sql: pickup_scheduling_cutoff_time
  primary_transport_mode:
    description: Primary mode of transport (e.g., Sea, Air, Ground).
    sql: primary_transport_mode
  real_time_tracking_available:
    description: Boolean indicating if real-time tracking is available.
    sql: real_time_tracking_available
  scac_code:
    description: 'TEXT. The Standard Carrier Alpha Code for the carrier. Example: O5CV.'
    sql: scac_code
  security_protocols:
    description: 'TEXT. A brief description of security protocols. Example: Standard GPS tracking and sealed containers.'
    sql: security_protocols
  service_disruption_alerts_url:
    description: 'TEXT. A URL for service disruption alerts. **NULL means the carrier does not provide a dedicated status page.** Example: https://status.carrier1.com.'
    sql: service_disruption_alerts_url
  supported_shipping_methods:
    description: 'JSONB. A JSON array of shipping methods offered. Example: [Air, Express, Sea, Freight].'
    sql: supported_shipping_methods
  sustainability_rating:
    description: 'TEXT. An internal or third-party sustainability rating. **NULL means the carrier has not been rated.** Possible values: A, B, C, D.'
    sql: sustainability_rating
  tracking_url_template:
    description: 'TEXT. A URL template for tracking shipments. Example: https://track.carrier1.com/?id=.'
    sql: tracking_url_template
  undeliverable_package_policy:
    description: 'TEXT. A description of the policy for undeliverable packages. Example: Insurance claims must be filed within 10 days of the delivery date.'
    sql: undeliverable_package_policy
measures:
  count:
    aggregate_type: count_distinct
    description: Count of distinct transportation_carriers public identity values.
    label: transportation_carriers Count
    sql: ${reverse_logistics_large_public__transportation_carriers.carrier_id}
