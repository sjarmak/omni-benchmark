label: Return Financials
description: Return financial rows with public fee, valuation, disposal, refund, and sustainability semantics.
catalog: reverse_logistics_large
schema: public
table_name: financial_management
dimensions:
  restocking_fee:
    description: REAL. Restocking fee for the return item.
    label: Restocking Fee
    sql: CAST(JSONB_EXTRACT_PATH_TEXT(cost_breakdown, 'fees', 'restocking_fee') AS DOUBLE PRECISION)
    ai_context: 'Restocking Fee: Fee imposed to cover administrative and handling work required to make the item sellable again.'
  relabeling_cost:
    description: 'REAL. Relabeling cost for the return item. Example: 10.26.'
    label: Relabeling Cost
    sql: CAST(JSONB_EXTRACT_PATH_TEXT(cost_breakdown, 'fees', 'relabeling_cost') AS DOUBLE PRECISION)
    ai_context: 'Relabeling Cost: Direct cost of material and labor associated with correcting item labeling deficiencies.'
  disposal_cost:
    description: 'REAL. Disposal fee for the return item. Example: 83.49.'
    label: Disposal Cost
    sql: CAST(JSONB_EXTRACT_PATH_TEXT(cost_breakdown, 'disposal', 'disposal_cost') AS DOUBLE PRECISION)
    ai_context: 'Disposal Cost: Monetary cost of disposing the item through methods such as recycling, landfill, or hazardous-waste processing.'
  repair_estimate:
    description: 'REAL. Estimated repair cost for the return item. Example: 490.99.'
    label: Repair Estimate
    sql: CAST(JSONB_EXTRACT_PATH_TEXT(cost_breakdown, 'repair_costs', 'repair_estimate') AS DOUBLE PRECISION)
    ai_context: 'Repair Estimate: Estimated sum of parts, labor and overhead needed for repair work, agreed before work commences.'
  recovery_value:
    description: 'REAL. Amount recovered from the return. Example: 19.18.'
    label: Recovery Value
    sql: CAST(JSONB_EXTRACT_PATH_TEXT(cost_breakdown, 'valuation', 'recovery_value') AS DOUBLE PRECISION)
    ai_context: 'Recovery Value: Net revenue expected after processing the return, excluding initial cost.'
  carbon_footprint:
    description: 'REAL. Carbon footprint of the return item. Example: 32.28.'
    label: Carbon Footprint
    sql: CAST(JSONB_EXTRACT_PATH_TEXT(cost_breakdown, 'sustainability', 'carbon_footprint') AS DOUBLE PRECISION)
    ai_context: 'Carbon Footprint: Quantifies greenhouse-gas emissions attributable to transportation, handling, and disposal of a single return.'
  disposal_method:
    description: 'DisposalMethod_enum. Method used to dispose of the return item. Possible values: Hazardous Waste, Landfill, Recycle, Return to Vendor.'
    label: Disposal Method
    sql: JSONB_EXTRACT_PATH_TEXT(cost_breakdown, 'disposal', 'disposal_method')
    ai_context: 'Disposal Methods: ''Recycle'' for materials separated for recycling streams; ''Hazardous Waste'' for components containing batteries, chemicals, or e-waste; ''Landfill'' for non-recyclable residuals; ''Return to Vendor'' for supplier agrees to take back for specialised processing.'
  refund_method:
    description: 'RefundMethod_enum. Method used for refunding the customer. Possible values: Bank Transfer, Original Payment, Store Credit.'
    label: Refund Method
    sql: JSONB_EXTRACT_PATH_TEXT(cost_breakdown, 'refund', 'method')
    ai_context: 'Refund Methods: ''Original Payment'' is when credit card/PayPal reversal within payment gateway; ''Bank Transfer'' is when direct ACH/SEPA transfer when gateway refund blocked; ''Store Credit'' is when applied to customer account as gift card or voucher on customer request or policy.'
  casetag:
    description: VARCHAR(50). Foreign key to the returns table (CaseNum). FK to returns.
    sql: casetag
  cost_breakdown:
    description: JSONB column. Captures the financial breakdown of refund, recovery, and sustainability-related fees for a return case.
    sql: cost_breakdown
  creditref:
    description: 'TEXT. Unique identifier for the financial record. PK. Example: CM78914.'
    sql: creditref
  dispcost:
    description: 'REAL. Disposal cost for the return item. Example: $86.84.'
    sql: dispcost
  cost_breakdown_disposal_environmental_impact:
    description: 'EnvironmentalImpact_enum. Environmental impact of the disposal method. Possible values: High, Low, Medium.'
    sql: JSONB_EXTRACT_PATH_TEXT(cost_breakdown, 'disposal', 'environmental_impact')
  cost_breakdown_disposal_recycling_category:
    description: 'RecyclingCategory_enum. Category of material recycled during disposal. Possible values: Electronics, Metal, Mixed, Plastic.'
    sql: JSONB_EXTRACT_PATH_TEXT(cost_breakdown, 'disposal', 'recycling_category')
  cost_breakdown_fees_qa_fee:
    description: 'REAL. Quality assurance fee for the return item. Example: 12.33.'
    sql: JSONB_EXTRACT_PATH_TEXT(cost_breakdown, 'fees', 'qa_fee')
  cost_breakdown_fees_repackaging_cost:
    description: 'REAL. Repackaging cost for the return item. Example: $19.53.'
    sql: JSONB_EXTRACT_PATH_TEXT(cost_breakdown, 'fees', 'repackaging_cost')
  cost_breakdown_refund_processing_days:
    description: 'REAL. Number of days taken to process the refund. Example: 12.8.'
    sql: JSONB_EXTRACT_PATH_TEXT(cost_breakdown, 'refund', 'processing_days')
  cost_breakdown_refund_refund_amount:
    description: 'REAL. Refund amount for the return. Example: $1,337.51.'
    sql: JSONB_EXTRACT_PATH_TEXT(cost_breakdown, 'refund', 'refund_amount')
  cost_breakdown_refund_status:
    description: 'RefundStatus_enum. Current state of the refund. Possible values: Completed, Pending, Processed.'
    sql: JSONB_EXTRACT_PATH_TEXT(cost_breakdown, 'refund', 'status')
  cost_breakdown_repair_costs_labor_fee:
    description: 'REAL. Labor fee for the return item. Example: 85.38.'
    sql: JSONB_EXTRACT_PATH_TEXT(cost_breakdown, 'repair_costs', 'labor_fee')
  cost_breakdown_repair_costs_parts_fee:
    description: 'REAL. Parts fee for the return item. Example: 136.63.'
    sql: JSONB_EXTRACT_PATH_TEXT(cost_breakdown, 'repair_costs', 'parts_fee')
  cost_breakdown_sustainability_cost_efficiency:
    description: 'REAL. Cost efficiency score for the return item. Example: 45.4.'
    sql: JSONB_EXTRACT_PATH_TEXT(cost_breakdown, 'sustainability', 'cost_efficiency')
  cost_breakdown_sustainability_efficiency_score:
    description: 'REAL. Efficiency score for the return item. Example: 98.1.'
    sql: JSONB_EXTRACT_PATH_TEXT(cost_breakdown, 'sustainability', 'efficiency_score')
  cost_breakdown_sustainability_sustainability_score:
    description: 'REAL. Sustainability score for the return item. **NULL means no sustainability score provided.**. Example: 46.0.'
    sql: JSONB_EXTRACT_PATH_TEXT(cost_breakdown, 'sustainability', 'sustainability_score')
  cost_breakdown_valuation_value_loss_pct:
    description: 'REAL. Total value loss from the return. Example: 72.3.'
    sql: JSONB_EXTRACT_PATH_TEXT(cost_breakdown, 'valuation', 'value_loss_pct')
measures:
  count:
    aggregate_type: count_distinct
    description: Count of distinct Return Financials public identity values.
    label: Return Financials Count
    sql: ${reverse_logistics_large_public__financial_management.creditref}
