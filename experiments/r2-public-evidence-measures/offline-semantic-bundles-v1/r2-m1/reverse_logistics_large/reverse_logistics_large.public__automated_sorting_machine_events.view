label: automated_sorting_machine_events
description: All columns of the public table automated_sorting_machine_events.
catalog: reverse_logistics_large
schema: public
table_name: automated_sorting_machine_events
dimensions:
  barcode_readability_score:
    description: 'REAL. Quality score of the barcode scan (0-100). Example: 90.'
    sql: barcode_readability_score
  conveyor_belt_speed_ms:
    description: 'REAL. Speed of the conveyor belt in m/s. Example: 2.5.'
    sql: conveyor_belt_speed_ms
  divert_lane_assigned:
    description: 'INTEGER. Lane number the item was diverted to. Example: 50.'
    sql: divert_lane_assigned
  energy_draw_watts:
    description: 'REAL. Instantaneous power draw of the sorter unit. Example: 1500.'
    sql: energy_draw_watts
  event_timestamp_precise:
    description: 'TIMESTAMP. Microsecond precision timestamp of the sort. Example: 2024-01-01 12:00:00.'
    sql: event_timestamp_precise
  facility_code_ref:
    description: TEXT. Warehouse facility code.
    sql: facility_code_ref
  jam_error_code:
    description: 'TEXT. Error code if a jam occurred. Unique values: E01, E04, NONE.'
    sql: jam_error_code
  machine_code_identifier:
    description: TEXT. ID of the sorting machine.
    sql: machine_code_identifier
  measured_weight_grams:
    description: 'REAL. Weight measured by the in-line scale. Example: 500.'
    sql: measured_weight_grams
  motor_temperature_c:
    description: 'REAL. Temperature of the primary diverter motor. Example: 45.'
    sql: motor_temperature_c
  photo_capture_ref_id:
    description: TEXT. ID of the image taken during sortation.
    sql: photo_capture_ref_id
  pneumatic_pressure_psi:
    description: 'REAL. Air pressure for pneumatic diverters. Example: 90.'
    sql: pneumatic_pressure_psi
  reject_reason_code:
    description: 'TEXT. Reason code if item was rejected to hospital lane. Unique values: No Read, Overweight, Too Small, None.'
    sql: reject_reason_code
  scanned_dimensions_mm:
    description: TEXT. LxWxH dimensions scanned (e.g., 200x150x50).
    sql: scanned_dimensions_mm
  sort_accuracy_confidence:
    description: 'REAL. System confidence in the sort decision (0-1.0). Example: 0.98.'
    sql: sort_accuracy_confidence
  sort_event_ref:
    description: TEXT. Unique identifier for the sort event.
    sql: sort_event_ref
  sorted_item_ref:
    description: TEXT. Return case being sorted.
    sql: sorted_item_ref
  sorting_algorithm_ver:
    description: 'TEXT. Version of the routing logic used. Unique values: v4.1, v4.2.'
    sql: sorting_algorithm_ver
  throughput_rate_cph:
    description: 'INTEGER. System throughput (Cartons Per Hour) at event time. Example: 3000.'
    sql: throughput_rate_cph
measures:
  count:
    aggregate_type: count_distinct
    description: Count of distinct automated_sorting_machine_events public identity values.
    label: automated_sorting_machine_events Count
    sql: ${reverse_logistics_large_public__automated_sorting_machine_events.sort_event_ref}
