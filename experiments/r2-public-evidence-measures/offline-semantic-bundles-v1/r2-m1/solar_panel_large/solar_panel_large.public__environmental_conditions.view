label: Environmental Conditions
description: Plant environmental measurements.
catalog: solar_panel_large
schema: public
table_name: environmental_conditions
dimensions:
  cell_temp:
    description: 'REAL. Solar cell temperature. NULL means the encoder does not report status or data are missing. Example: 47.3.'
    label: Cell Temperature
    sql: JSONB_EXTRACT_PATH_TEXT(env_snapshot, 'temperatures', 'cell_temp_c')
  uv:
    description: 'REAL. UV index measurement. Example: 1.1.'
    label: UV Index
    sql: JSONB_EXTRACT_PATH_TEXT(env_snapshot, 'atmospheric', 'uv_index')
    ai_context: 'UV Index: An international standard measurement of the strength of the sunburn-producing ultraviolet (UV) radiation at a particular place and time. The scale is open-ended, where 1-2 is Low, 3-5 is Moderate, 6-7 is High, 8-10 is Very High, and 11+ is Extreme.'
  env_snapshot:
    description: JSONB column. Bundles ambient weather, plane-of-array irradiance and soiling/atmospheric conditions measured at the plant into one JSONB object for performance-normalisation models.
    sql: env_snapshot
  snapref:
    description: TEXT. PK & FK → plant_record.SnapKey. Links to environmental snapshot.
    sql: snapref
  env_snapshot_atmospheric_air_pressure_hpa:
    description: 'REAL. Atmospheric pressure measurement. Example: 1099.2.'
    sql: JSONB_EXTRACT_PATH_TEXT(env_snapshot, 'atmospheric', 'air_pressure_hpa')
  env_snapshot_atmospheric_cloud_cover_pct:
    description: 'REAL. Cloud cover percentage. Example: 12.4.'
    sql: JSONB_EXTRACT_PATH_TEXT(env_snapshot, 'atmospheric', 'cloud_cover_pct')
  env_snapshot_atmospheric_dust_density_kg_m3:
    description: 'REAL. Dust density measurement. Example: 0.056.'
    sql: JSONB_EXTRACT_PATH_TEXT(env_snapshot, 'atmospheric', 'dust_density_kg_m3')
  env_snapshot_atmospheric_relative_humidity_pct:
    description: 'REAL. Relative humidity percentage. Example: 76.1.'
    sql: JSONB_EXTRACT_PATH_TEXT(env_snapshot, 'atmospheric', 'relative_humidity_pct')
  env_snapshot_irradiance_dhi_w_m2:
    description: 'REAL. Diffuse irradiance measurement. Example: 44.1.'
    sql: JSONB_EXTRACT_PATH_TEXT(env_snapshot, 'irradiance', 'dhi_w_m2')
  env_snapshot_irradiance_dni_w_m2:
    description: 'REAL. Direct irradiance measurement. Example: 169.3.'
    sql: JSONB_EXTRACT_PATH_TEXT(env_snapshot, 'irradiance', 'dni_w_m2')
  env_snapshot_irradiance_ghi_w_m2:
    description: 'REAL. Solar irradiance measurement. NULL means the encoder does not report status or data are missing. Example: 530.4.'
    sql: JSONB_EXTRACT_PATH_TEXT(env_snapshot, 'irradiance', 'ghi_w_m2')
  env_snapshot_irradiance_poa_irr_w_m2:
    description: 'REAL. Plane-of-array irradiance. Example: 135.1.'
    sql: JSONB_EXTRACT_PATH_TEXT(env_snapshot, 'irradiance', 'poa_irr_w_m2')
  env_snapshot_temperatures_ambient_temp_c:
    description: 'REAL. Ambient air temperature. Example: 41.2.'
    sql: JSONB_EXTRACT_PATH_TEXT(env_snapshot, 'temperatures', 'ambient_temp_c')
  env_snapshot_wind_rain_snow_rain_mm:
    description: 'REAL. Rainfall measurement in millimeters. Example: 41.3.'
    sql: JSONB_EXTRACT_PATH_TEXT(env_snapshot, 'wind_rain_snow', 'rain_mm')
  env_snapshot_wind_rain_snow_snow_cover_pct:
    description: 'REAL. Snow cover percentage. Example: 24.8.'
    sql: JSONB_EXTRACT_PATH_TEXT(env_snapshot, 'wind_rain_snow', 'snow_cover_pct')
  env_snapshot_wind_rain_snow_wind_dir_deg:
    description: 'REAL. Wind direction in degrees. Example: 249.3.'
    sql: JSONB_EXTRACT_PATH_TEXT(env_snapshot, 'wind_rain_snow', 'wind_dir_deg')
  env_snapshot_wind_rain_snow_wind_speed_m_s:
    description: 'REAL. Wind speed measurement. Example: 11.6.'
    sql: JSONB_EXTRACT_PATH_TEXT(env_snapshot, 'wind_rain_snow', 'wind_speed_m_s')
measures:
  count:
    aggregate_type: count_distinct
    description: Count of distinct Environmental Conditions public identity values.
    label: Environmental Conditions Count
    sql: ${solar_panel_large_public__environmental_conditions.snapref}
