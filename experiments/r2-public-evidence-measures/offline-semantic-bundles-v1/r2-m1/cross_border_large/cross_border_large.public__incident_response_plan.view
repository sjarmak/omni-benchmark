label: IncidentResponsePlan
description: All columns of the public table IncidentResponsePlan.
catalog: cross_border_large
schema: public
table_name: IncidentResponsePlan
dimensions:
  action_items_total:
    description: BIGINT. Total number of action items
    sql: '"ACTION_ITEMS_TOTAL"'
  activation_time:
    description: TIMESTAMP WITHOUT TIME ZONE. When the plan was activated
    sql: '"ACTIVATION_TIME"'
  budget_allocated_usd:
    description: 'REAL. Budget allocated for response Typical range: 5000 to 500000.'
    sql: '"BUDGET_ALLOCATED_USD"'
  communication_channel:
    description: 'TEXT. Primary communication channel Possible values: War Room, Slack, Teams, Email, Phone Bridge.'
    sql: '"COMMUNICATION_CHANNEL"'
  created_at:
    description: TIMESTAMP WITHOUT TIME ZONE. Record creation timestamp
    sql: '"CREATED_AT"'
  execution_progress_pct:
    description: 'REAL. Percentage of plan completed Typical range: 0 to 100.'
    sql: '"EXECUTION_PROGRESS_PCT"'
  escalation_level:
    description: 'TEXT. Current escalation level Possible values: L1-Team, L2-Management, L3-Executive, L4-Board.'
    sql: '"EscalationLevel"'
  plan_type:
    description: 'TEXT. Type of response plan Possible values: Containment, Eradication, Recovery, Full Lifecycle.'
    sql: '"PLAN_TYPE"'
  response_plan_id:
    description: BIGINT. Primary key. Unique identifier for response plan
    sql: '"RESPONSE_PLAN_ID"'
  stakeholder_notification:
    description: JSONB. Stakeholder notification status
    sql: '"STAKEHOLDER_NOTIFICATION"'
  action_items_completed:
    description: BIGINT. Number of completed action items
    sql: action_items_completed
  actual_spend_usd:
    description: 'REAL. Actual spend so far Typical range: 0 to 500000. **NULL means Spend not yet tracked.**'
    sql: '"actual_spend_USD"'
  completion_time:
    description: TIMESTAMP WITHOUT TIME ZONE. When plan execution completed **NULL means Plan still in execution.**
    sql: completion_time
  external_firm:
    description: 'TEXT. Name of external support firm Possible values: Deloitte, PwC, KPMG, CrowdStrike, Mandiant, Palo Alto. **NULL means No external firm engaged.**'
    sql: external_firm
  external_support_engaged:
    description: BOOLEAN. Whether external consultants/vendors engaged Boolean flag (true/false).
    sql: external_support_engaged
  incident_ref:
    description: BIGINT. Foreign key referencing IncidentRegister(INCIDENT_ID). Related incident
    sql: incident_ref
  lessons_learned:
    description: TEXT. Summary of lessons learned **NULL means Lessons learned not yet documented.**
    sql: lessons_learned
  plan_owner:
    description: 'TEXT. Owner/responsible person for this plan Possible values: CISO, DPO, IT Director, Security Lead, Compliance Lead.'
    sql: '"plan_Owner"'
  plan_code:
    description: TEXT. Response plan reference code
    sql: plan_code
  priority:
    description: 'TEXT. Plan execution priority Possible values: P1-Critical, P2-High, P3-Medium, P4-Low.'
    sql: priority
  team_size:
    description: BIGINT. Number of team members assigned
    sql: team_size
measures:
  count:
    aggregate_type: count_distinct
    description: Count of distinct IncidentResponsePlan public identity values.
    label: IncidentResponsePlan Count
    sql: ${cross_border_large_public__incident_response_plan.response_plan_id}
