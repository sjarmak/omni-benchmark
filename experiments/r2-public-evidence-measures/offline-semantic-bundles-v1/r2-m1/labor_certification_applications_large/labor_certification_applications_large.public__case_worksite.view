label: case_worksite
description: All columns of the public table case_worksite.
catalog: labor_certification_applications_large
schema: public
table_name: case_worksite
dimensions:
  dockkey:
    description: 'TEXT. Case number reference. FK to cases.fileKey. PK. Example: I-200-23355-584296.'
    sql: dockkey
  wagetrack:
    description: 'TEXT. Wage tracking number reference. FK to prevailing_wage.trackNo. Example: 1.'
    sql: wagetrack
  ws_addr1:
    description: 'TEXT. Primary worksite address line. PK. Example: 2800 10th Avenue North.'
    sql: ws_addr1
  wscity:
    description: 'TEXT. Worksite city. PK. Example: Billings.'
    sql: wscity
  wsheads:
    description: 'BIGINT. Number of workers at the worksite. Possible values: 1, 3, 4, 5, 6, 10, 25, 50.'
    sql: wsheads
  wsstate:
    description: 'TEXT. Worksite state. PK. Example: MT.'
    sql: wsstate
  wszip:
    description: 'TEXT. Worksite postal code. PK. Example: 59101.'
    sql: wszip
