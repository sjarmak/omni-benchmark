label: Support and Feedback
description: Support records with row-level issue-report semantics.
catalog: virtual_idol_large
schema: public
table_name: supportandfeedback
dimensions:
  support_tickets:
    description: SMALLINT. Number of support tickets opened by the fan.
    label: Support Tickets
    sql: JSONB_EXTRACT_PATH_TEXT(feedback_data, 'Supp_Tix')
  bug_reports:
    description: SMALLINT. Number of bug reports submitted by the fan.
    label: Bug Reports
    sql: JSONB_EXTRACT_PATH_TEXT(feedback_data, 'Bug_Subs')
  technical_issue_reports:
    description: SMALLINT. Number of technical issues reported by the fan.
    label: Technical Issue Reports
    sql: JSONB_EXTRACT_PATH_TEXT(feedback_data, 'Tech_Issue_Rpt')
  nps_score:
    description: SMALLINT. Net Promoter Score value indicating likelihood to recommend platform.
    label: NPS Score
    sql: JSONB_EXTRACT_PATH_TEXT(feedback_data, 'NPS_Val')
    ai_context: 'NPS Score Tiers: Net Promoter Score (NPS) is categorized as: Promoters (score 9-10), Passives (score 7-8), and Detractors (score 0-6).'
  beta_part:
    description: TEXT. Participation status in beta testing programs.
    sql: beta_part
  feedback_data:
    description: JSONB column. Support and feedback engagement data including issue reports, submissions, and satisfaction ratings
    sql: feedback_data
  support_interact_pivot:
    description: TEXT. Reference to interaction record for support context. FK to Interactions.
    sql: support_interact_pivot
  support_pref_pivot:
    description: BIGINT. Reference to preferences record for support correlation. FK to PreferencesAndSettings.
    sql: support_pref_pivot
  support_reg:
    description: BIGSERIAL. Auto-generated unique identifier for support and feedback record. PK = SupportAndFeedback(Support_Reg).
    sql: support_reg
  surv_part:
    description: TEXT. Participation level in surveys and research studies.
    sql: surv_part
  feedback_data_fb_subs:
    description: SMALLINT. Number of feedback submissions made by the fan.
    sql: JSONB_EXTRACT_PATH_TEXT(feedback_data, 'Fb_Subs')
  feedback_data_feat_req_subs:
    description: SMALLINT. Number of feature requests submitted by the fan.
    sql: JSONB_EXTRACT_PATH_TEXT(feedback_data, 'Feat_Req_Subs')
  feedback_data_sat_rate:
    description: REAL. Overall satisfaction rating provided by the fan.
    sql: JSONB_EXTRACT_PATH_TEXT(feedback_data, 'Sat_Rate')
  support_load_score:
    label: Support Load Score (SLS)
    description: Quantifies the amount of support resources a fan utilizes, based on their submission of tickets and issue reports.
    sql: CAST(${support_tickets} AS DOUBLE PRECISION) + CAST(${bug_reports} AS DOUBLE PRECISION) + CAST(${technical_issue_reports} AS DOUBLE PRECISION)
    ai_context: Use this modeled field for Support Load Score (SLS); do not reconstruct its formula.
measures:
  count:
    aggregate_type: count_distinct
    description: Count of distinct Support and Feedback public identity values.
    label: Support and Feedback Count
    sql: ${virtual_idol_large_public__supportandfeedback.support_reg}
