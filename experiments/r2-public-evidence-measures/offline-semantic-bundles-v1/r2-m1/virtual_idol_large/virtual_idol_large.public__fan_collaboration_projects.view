label: fan_collaboration_projects
description: All columns of the public table fan_collaboration_projects.
catalog: virtual_idol_large
schema: public
table_name: fan_collaboration_projects
dimensions:
  associated_idol_record:
    description: 'TEXT. Foreign key referencing the idol the project is associated with. FK to virtualidols(entity_reg). Example: VI1044.'
    sql: '"Associated_Idol_Record"'
  community_impact_score:
    description: 'REAL. A score representing the project''s impact on the community. **NULL means the impact has not been scored yet.** Example: 3.5.'
    sql: '"COMMUNITY_IMPACT_SCORE"'
  completion_criteria:
    description: 'TEXT. The criteria that must be met for the project to be considered complete. Example: Final product is released publicly on all announced platforms..'
    sql: '"COMPLETION_CRITERIA"'
  content_license:
    description: 'TEXT. The license under which the project''s content is released. Example: All Rights Reserved by Creators.'
    sql: '"CONTENT_LICENSE"'
  creation_timestamp:
    description: 'TIMESTAMP. The timestamp when the project was created. Example: 2025-08-22 17:52:44.'
    sql: '"CREATION_TIMESTAMP"'
  final_product_link:
    description: 'TEXT. The URL to the final product or outcome of the project. **NULL means the project is not complete or has no single linkable product.** Example: https://fan-content.example.com/releases/76b49bd5-4299-40be-bd3f-7bee42f4b88d.'
    sql: '"FinalProductLink"'
  funding_source:
    description: 'TEXT. The source of the project''s funding. Possible values: Self-Funded, Community Donations, Sponsor-Backed. Example: Self-Funded.'
    sql: '"FundingSource"'
  legal_disclaimer:
    description: 'TEXT. The legal disclaimer associated with the project. Example: This project is not officially endorsed but made with love by fans..'
    sql: '"LegalDisclaimer"'
  moderator_fan_id:
    description: 'TEXT. Foreign key referencing the fan who moderates the project. FK to fans(user_registry). Example: FAN96410.'
    sql: '"Moderator_Fan_ID"'
  number_of_participants:
    description: 'BIGINT. The number of fans participating in the project. Example: 31.'
    sql: '"NUMBER_OF_PARTICIPANTS"'
  project_id:
    description: 'BIGINT. Unique identifier for the fan collaboration project. PK. Example: 9001.'
    sql: '"PROJECT_ID"'
  project_rules:
    description: 'TEXT. The rules and guidelines for participating in the project. Example: All contributions must be original work or properly sourced..'
    sql: '"PROJECT_RULES"'
  project_url:
    description: 'TEXT. The URL for the project''s main page or repository. Example: https://fan-content.example.com/projects/214f9758-9ae7-4cf4-9aa3-2b67c60ebae4.'
    sql: '"PROJECT_URL"'
  project_logo_url:
    description: 'TEXT. The URL for the project''s logo image. Example: https://fan-content.example.com/logos/7a0e59b1-b58c-439d-ac32-eaf5d96e4f20.'
    sql: '"ProjectLogoURL"'
  project_name:
    description: 'TEXT. The name of the project. Example: Idol1035 Anniversary Project 2025.'
    sql: '"ProjectName"'
  project_status:
    description: 'TEXT. The current status of the project. Possible values: Completed, On Hold, In Progress, Planning. Example: Completed.'
    sql: '"ProjectStatus"'
  project_lead_fan_id:
    description: 'TEXT. Foreign key referencing the fan leading the project. FK to fans(user_registry). Example: FAN32968.'
    sql: '"Project_Lead_Fan_ID"'
  related_event_id:
    description: 'BIGINT. Identifier for a related official event. **NULL means the project is not tied to a specific event.** Example: 48.0.'
    sql: '"RELATED_EVENT_ID"'
  required_skills:
    description: 'TEXT ARRAY. A list of skills required for the project. Example: {Creative Writing,Translation (JP-EN)}.'
    sql: '"RequiredSkills"'
  revenue_sharing_plan:
    description: 'TEXT. The plan for sharing any revenue generated by the project. **NULL means there is no revenue sharing plan.** Example: 60/40 revenue split among participants, weighted by contribution hours..'
    sql: '"RevenueSharingPlan"'
  start_date:
    description: 'DATE. The start date of the project. Example: 2025-08-22.'
    sql: '"START_DATE"'
  tags:
    description: 'TEXT ARRAY. A list of tags for categorizing the project. Example: {event,anniversary}.'
    sql: '"Tags"'
  budget_dollar:
    description: 'REAL. The project''s budget in USD. Example: 3998.67.'
    sql: budget_dollar
  communication_channel:
    description: 'TEXT. The primary platform used for project communication. Example: Telegram.'
    sql: communication_channel
  end_date:
    description: 'DATE. The end date of the project. **NULL means the project is ongoing.** Example: 2025-08-30.'
    sql: end_date
  is_monetized:
    description: 'BOOLEAN. A flag indicating if the project is monetized. Example: false.'
    sql: is_monetized
  last_update_timestamp:
    description: 'TIMESTAMP. The timestamp of the last update to the project details. Example: 2025-08-24 16:34:46.'
    sql: last_update_timestamp
  milestones:
    description: 'JSONB. A JSON object outlining the project''s milestones. Example: {"Phase 1": "Concept & Planning", "Phase 2": "Development & Production", "Phase 3": "Release & Promotion"}.'
    sql: milestones
  participant_feedback_summary:
    description: 'TEXT. A summary of feedback from project participants. **NULL means feedback has not been collected.** Example: The entire process was smooth and well-organized. I would gladly participate in another project like this..'
    sql: participant_feedback_summary
  project_description:
    description: 'TEXT. A detailed description of the project. Example: Developing a small, non-commercial visual novel game in Ren''Py, based on the idol''s official backstory..'
    sql: project_description
  visibility:
    description: 'TEXT. The visibility setting for the project. Possible values: Private, Public, Invite Only. Example: Private.'
    sql: visibility
measures:
  count:
    aggregate_type: count_distinct
    description: Count of distinct fan_collaboration_projects public identity values.
    label: fan_collaboration_projects Count
    sql: ${virtual_idol_large_public__fan_collaboration_projects.project_id}
