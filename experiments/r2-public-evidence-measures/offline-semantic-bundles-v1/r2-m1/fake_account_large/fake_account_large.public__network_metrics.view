label: Network Metrics
description: Account-level network metrics with row-local growth semantics.
catalog: fake_account_large
schema: public
table_name: network_metrics
dimensions:
  follower_growth_rate:
    description: 'REAL. Follower growth rate. Example: 0.697.'
    label: Follower Growth Rate
    sql: '"FollGrow"'
  following_growth_rate:
    description: 'REAL. Following growth rate. Example: 0.899.'
    label: Following Growth Rate
    sql: '"FingGrow"'
  com_rt:
    description: 'REAL. Comment rate score. **NULL means comment rate not recorded.**. Example: 0.282.'
    sql: '"ComRt"'
  conn_grow_ptn:
    description: 'TEXT. Connection growth pattern. Possible values: Bot-like, Burst, Organic, Suspicious.'
    sql: '"ConnGrowPtn"'
  conn_qual:
    description: 'REAL. Connection quality score. Example: 0.819.'
    sql: '"ConnQual"'
  eng_auth:
    description: 'REAL. Engagement authority score. Example: 0.954.'
    sql: '"EngAuth"'
  eng_rate:
    description: 'REAL. Engagement rate. Example: 0.132.'
    sql: '"EngRate"'
  foll_ratio:
    description: 'REAL. Follower-followee ratio. Example: 5.162.'
    sql: '"FollRatio"'
  follow_num:
    description: 'BIGINT. Number of followers. Example: 32353.'
    sql: '"FollowNum"'
  followg_num:
    description: 'BIGINT. Number of followees. Example: 53330.'
    sql: '"FollowgNum"'
  int_div:
    description: 'REAL. Interaction diversity score. Example: 0.681.'
    sql: '"IntDiv"'
  int_recip:
    description: 'REAL. Interaction reciprocity score. Example: 0.817.'
    sql: '"IntRecip"'
  like_rt:
    description: 'REAL. Like rate score. Example: 0.738.'
    sql: '"LikeRt"'
  mut_conn:
    description: 'REAL. Mutual connections count. Example: 0.964.'
    sql: '"MutConn"'
  share_rt:
    description: 'REAL. Share rate score. Example: 0.696.'
    sql: '"ShareRt"'
  temp_int_ptn:
    description: 'TEXT. Temporary interaction pattern. Possible values: Automated, Natural, Periodic, Random.'
    sql: '"TempIntPtn"'
  acct_node:
    description: TEXT. Account reference for network metrics. PK. FK to accounts.
    sql: acct_node
  network_growth_velocity:
    label: Network Growth Velocity (NGV)
    description: Measures the rate of network growth considering both followers and following.
    sql: SQRT(POWER(${follower_growth_rate}, 2.0) + POWER(${following_growth_rate}, 2.0))
    ai_context: Use this modeled field for Network Growth Velocity (NGV); do not reconstruct its formula.
measures:
  count:
    aggregate_type: count_distinct
    description: Count of distinct Network Metrics public identity values.
    label: Network Metrics Count
    sql: ${fake_account_large_public__network_metrics.acct_node}
