label: moderation_appeals_process
description: All columns of the public table moderation_appeals_process.
catalog: fake_account_large
schema: public
table_name: moderation_appeals_process
dimensions:
  appeal_code:
    description: TEXT. Unique identifier for the appeal process.
    sql: '"Appeal_CODE"'
  appeal_category_selected:
    description: 'TEXT. User''s categorization of the error (e.g., Satire, Context). Unique values: SATIRE, CONTEXT, NOT_ME, ERROR.'
    sql: appeal_category_selected
  appeal_submission_device:
    description: 'TEXT. Device used to submit appeal. Unique values: MOBILE, DESKTOP.'
    sql: appeal_submission_device
  appeal_submission_text_len:
    description: 'INTEGER. Length of the user''s defense statement. Example: 200.'
    sql: appeal_submission_text_len
  auto_reject_score:
    description: 'REAL. AI score predicting likelihood of frivolous appeal. Example: 50.0.'
    sql: auto_reject_score
  case_file_ref:
    description: TEXT. Reference to the original moderation case.
    sql: case_file_ref
  compensation_credits_granted:
    description: 'INTEGER. Credits given if ban was erroneous. Unique values: 0, 100, 500.'
    sql: compensation_credits_granted
  escalation_tier_required:
    description: 'INTEGER. Level of moderator authority needed (1-3). Unique values: 1, 2, 3.'
    sql: escalation_tier_required
  final_verdict_status:
    description: 'TEXT. Outcome (Restored, Upheld, Modified). Unique values: RESTORED, UPHELD, MODIFIED.'
    sql: final_verdict_status
  legal_review_required_flag:
    description: 'BOOLEAN. True if lawyers must review (e.g., copyright, defamation). Possible values: True, False.'
    sql: legal_review_required_flag
  panel_vote_count_no:
    description: 'INTEGER. Votes to UPKEEP the ban. **NULL means Single reviewer decision.** Example: 50.'
    sql: panel_vote_count_no
  panel_vote_count_yes:
    description: 'INTEGER. Votes to OVERTURN the ban. **NULL means Single reviewer decision.** Example: 50.'
    sql: panel_vote_count_yes
  policy_clarification_sent:
    description: 'BOOLEAN. True if user was sent educational material. Possible values: True, False.'
    sql: policy_clarification_sent
  previous_successful_appeals:
    description: 'INTEGER. Count of prior successful appeals by user. Example: 50.'
    sql: previous_successful_appeals
  process_duration_hours:
    description: 'REAL. Time taken to reach a verdict. Example: 48.'
    sql: process_duration_hours
  recidivism_risk_score:
    description: 'REAL. Predicted risk of repeat offense post-appeal. Example: 50.0.'
    sql: recidivism_risk_score
  regional_policy_check_code:
    description: 'TEXT. Specific regional law code checked (e.g., GDPR, NetzDG). Unique values: GDPR, NETZDG, CCPA, NONE.'
    sql: regional_policy_check_code
  user_apology_score:
    description: 'REAL. NLP score indicating contrition in appeal text. Example: 0.5.'
    sql: user_apology_score
measures:
  count:
    aggregate_type: count_distinct
    description: Count of distinct moderation_appeals_process public identity values.
    label: moderation_appeals_process Count
    sql: ${fake_account_large_public__moderation_appeals_process.appeal_code}
