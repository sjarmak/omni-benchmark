label: property_valuations
description: All columns of the public table property_valuations.
catalog: residential_data_large
schema: public
table_name: property_valuations
dimensions:
  appreciation_rate_percent:
    description: 'REAL. Annual property value appreciation rate as percentage. **NULL means appreciation trends not analyzed.**. Possible values: 2.8, 2.9, 3.6, 3.8, 4.2, 5.1.'
    sql: '"APPRECIATION_rate_percent"'
  assessed_value_brl:
    description: 'REAL. Government assessed value for tax purposes in Brazilian Real. **NULL means tax assessment not available.**. Possible values: 380000.9, 425000.5, 650000.8.'
    sql: '"ASSESSED_value_brl"'
  built_area_m2:
    description: 'REAL. Built-up area of structures in square meters. **NULL means construction area not measured.**. Possible values: 110.2, 128.6, 156.8, 85.4, 95.8, 98.5.'
    sql: '"BUILT_area_m2"'
  created_at:
    description: 'DATE. Record creation timestamp. Possible values: 2024-01-15, 2024-01-16, 2024-01-17, 2024-01-18, 2024-01-19, 2024-01-20, 2024-01-21, 2025-07-15, 2025-08-01, 2025-08-05.'
    sql: '"CREATED_at"'
  green_space_proximity_km:
    description: 'REAL. Distance to nearest green space in kilometers. **NULL means green space access not assessed.**. Possible values: 0.4, 0.8, 1.2, 1.5.'
    sql: '"GREEN_space_proximity_km"'
  hospital_proximity_km:
    description: 'REAL. Distance to nearest hospital in kilometers. **NULL means hospital distance not measured.**. Possible values: 0.5, 0.7, 0.9, 1.5.'
    sql: '"Hospital_Proximity_KM"'
  lot_size_m2:
    description: 'REAL. Total lot size in square meters. **NULL means lot measurements not surveyed.**. Possible values: 120.5, 125.0, 140.2, 180.5.'
    sql: '"Lot_Size_M2"'
  market_value_brl:
    description: 'REAL. Current market value of property in Brazilian Real. **NULL means market valuation not completed.**. Possible values: 395000.6, 450000.75, 520000.4, 680000.25.'
    sql: '"Market_Value_BRL"'
  monthly_maintenance_cost_brl:
    description: 'REAL. Average monthly maintenance costs in Brazilian Real. **NULL means maintenance costs not tracked.**. Possible values: 580.25, 650.8, 720.5, 820.9.'
    sql: '"Monthly_Maintenance_Cost_BRL"'
  property_tax_annual_brl:
    description: 'REAL. Annual property tax amount in Brazilian Real. **NULL means tax information not available.**. Possible values: 4500.6, 4800.3, 6200.35, 8100.45.'
    sql: '"PROPERTY_tax_annual_brl"'
  public_transport_access_score:
    description: 'BIGINT. Rating of public transportation accessibility. **NULL means transit access not evaluated.**. Possible values: 65.0, 75.0, 82.0, 85.0, 88.0, 92.0.'
    sql: '"PUBLIC_transport_access_score"'
  renovation_year:
    description: 'BIGINT. Year of most recent major renovation. **NULL means no renovations or renovation date unknown.**. Possible values: 2018.0, 2019.0, 2020.0.'
    sql: '"Renovation_Year"'
  rental_potential_brl:
    description: 'REAL. Estimated monthly rental income potential in Brazilian Real. **NULL means rental assessment not performed.**. Possible values: 2200.3, 2800.75, 2900.4, 3500.9, 4200.8.'
    sql: '"Rental_Potential_BRL"'
  structural_condition_score:
    description: 'BIGINT. Rating of structural condition on numerical scale. **NULL means structural assessment not performed.**. Possible values: 70.0, 78.0, 85.0, 88.0, 92.0.'
    sql: '"STRUCTURAL_condition_score"'
  school_district_rating:
    description: 'BIGINT. Quality rating of local school district. Possible values: 5, 6, 7, 8, 9.'
    sql: '"School_District_Rating"'
  valuation_property_key:
    description: 'BIGINT. Reference to property being valued. FK to properties(propref). Possible values: 19, 20, 21, 22, 23, 24, 25.'
    sql: '"Valuation_Property_Key"'
  commercial_proximity_km:
    description: 'REAL. Distance to nearest commercial center in kilometers. Possible values: 0.7, 0.8, 0.9, 1.1, 1.2, 1.8, 2.1.'
    sql: '"commercial_proximity_KM"'
  construction_year:
    description: 'BIGINT. Year when property was originally constructed. **NULL means construction date not recorded.**. Possible values: 1985.0, 1992.0, 1998.0, 2005.0, 2010.0.'
    sql: '"construction_YEAR"'
  energy_efficiency_rating:
    description: 'TEXT. Energy efficiency rating classification. **NULL means energy assessment not conducted.**. Possible values: A, B, C, D.'
    sql: '"energy_efficiency_RATING"'
  insurance_annual_brl:
    description: 'REAL. Annual property insurance cost in Brazilian Real. **NULL means insurance costs not documented.**. Possible values: 1800.0, 2800.4, 2950.75, 3200.75, 3600.2, 950.0.'
    sql: '"insurance_annual_BRL"'
  price_per_m2_brl:
    description: 'REAL. Property value per square meter in Brazilian Real. **NULL means per-unit pricing not calculated.**. Possible values: 2900.6, 3800.9, 4200.15.'
    sql: '"price_per_M2_brl"'
  risk_assessment_profile:
    description: JSONB column. Consolidates all risk factors and environmental hazards that affect property safety and insurability.
    sql: risk_assessment_profile
  updated_at:
    description: 'DATE. Record last update timestamp. Possible values: 2024-01-15, 2024-01-16, 2024-01-17, 2024-01-18, 2024-01-19, 2024-01-20, 2024-01-21, 2025-08-10, 2025-08-15, 2025-08-20.'
    sql: '"updated_AT"'
  valuation_id:
    description: 'BIGSERIAL. Primary key identifier for property valuation record. PK. Possible values: 1, 2, 3, 4, 5, 6, 7.'
    sql: '"valuation_ID"'
  walkability_score:
    description: 'BIGINT. Walkability rating for property neighborhood. **NULL means walkability not assessed.**. Possible values: 68.0, 75.0, 79.0, 82.0.'
    sql: '"walkability_SCORE"'
  risk_assessment_profile_crime_risk_score:
    description: 'BIGINT. Crime risk rating for property location. **NULL means crime risk not evaluated.**. Possible values: 12.0, 15.0, 25.0, 42.0.'
    sql: JSONB_EXTRACT_PATH_TEXT(risk_assessment_profile, 'CRIME_risk_score')
  risk_assessment_profile_environmental_quality_air_quality_index:
    description: 'BIGINT. Air quality index rating for property location. **NULL means air quality not monitored.**. Possible values: 105.0, 78.0, 88.0, 92.0.'
    sql: JSONB_EXTRACT_PATH_TEXT(risk_assessment_profile, 'environmental_quality', 'Air_Quality_Index')
  risk_assessment_profile_environmental_quality_noise_pollution_level_db:
    description: 'REAL. Ambient noise pollution level in decibels. **NULL means noise assessment not conducted.**. Possible values: 48.9, 52.3, 58.5, 65.2, 65.7.'
    sql: JSONB_EXTRACT_PATH_TEXT(risk_assessment_profile, 'environmental_quality', 'noise_pollution_LEVEL_db')
  risk_assessment_profile_natural_risks_earthquake_risk_level:
    description: 'BIGINT. Seismic risk assessment score. **NULL means earthquake risk not assessed.**. Possible values: 1.0, 2.0.'
    sql: JSONB_EXTRACT_PATH_TEXT(risk_assessment_profile, 'natural_risks', 'Earthquake_Risk_Level')
  risk_assessment_profile_natural_risks_flood_risk_level:
    description: 'BIGINT. Flood risk assessment score. **NULL means flood risk not evaluated.**. Possible values: 1.0, 2.0, 3.0, 4.0.'
    sql: JSONB_EXTRACT_PATH_TEXT(risk_assessment_profile, 'natural_risks', 'flood_risk_LEVEL')
measures:
  count:
    aggregate_type: count_distinct
    description: Count of distinct property_valuations public identity values.
    label: property_valuations Count
    sql: ${residential_data_large_public__property_valuations.valuation_id}
