label: exchanges
description: All columns of the public table exchanges.
catalog: exchange_traded_funds_large
schema: public
table_name: exchanges
dimensions:
  exchangetime:
    description: Local timezone identifier for the exchange's trading hours and time zone (e.g., 'America/NYC', 'New York', 'ny').
    sql: exchangetime
  marketcode:
    description: Unique abbreviated code for the exchange (e.g., 'NYSE', 'NASDAQ', 'LSE'). Must be unique across all records.
    sql: marketcode
  tradingvenue:
    description: Full official name of the stock exchange or trading venue where funds are listed and traded.
    sql: tradingvenue
  xchgnum:
    description: A SERIAL primary key uniquely identifying each stock exchange or trading venue in the database.
    sql: xchgnum
measures:
  count:
    aggregate_type: count_distinct
    description: Count of distinct exchanges public identity values.
    label: exchanges Count
    sql: ${exchange_traded_funds_large_public__exchanges.xchgnum}
