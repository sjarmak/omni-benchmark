label: Products
description: Product listing records with public product-category context.
catalog: cybermarket_pattern_large
schema: public
table_name: products
dimensions:
  product_category:
    description: 'TEXT. High-level product category. PK (composite). Possible values: Data, Digital, Physical, Service.'
    label: Product Category
    sql: '"ProdCat"'
    ai_context: 'Product Categories: Values: Data, Digital, Physical, Service. Label descriptions: - Data: Digital information assets such as credential dumps, personal records, or proprietary databases. - Digital: Intangible goods like software licenses, media subscriptions, or downloadable files. - Physical: Tangible merchandise shipped to the buyer, including hardware devices or printed documents. - Service: Intangible labor or expertise, e.g., penetration testing, content creation, or laundering assistance.'
  listing_age:
    description: 'BIGINT. Age of the listing in days. PK (composite). Example: 155.'
    sql: '"ListingAge"'
  seller_pointer:
    description: TEXT. Identifier for the vendor offering the listing. PK (composite). FK to vendors(SellerKey).
    sql: '"SellerPointer"'
  subcategory:
    description: 'TEXT. Specific product subcategory. PK (composite). Possible values: Type_A, Type_B, Type_C, Type_D.'
    sql: '"Subcategory"'
  product_availability:
    description: JSONB column. Stores product-related metrics, including availability, price, and listing age.
    sql: product_availability
  product_availability_price_amt:
    description: 'REAL. Listing price amount. Example: 1166.46.'
    sql: JSONB_EXTRACT_PATH_TEXT(product_availability, 'price_amt')
  product_availability_qty_avail:
    description: BIGINT. Quantity available for sale in this listing.
    sql: JSONB_EXTRACT_PATH_TEXT(product_availability, 'qty_avail')
