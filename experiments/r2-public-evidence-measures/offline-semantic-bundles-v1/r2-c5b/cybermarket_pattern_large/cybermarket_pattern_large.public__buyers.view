label: Buyers
description: Buyer records with public authentication and spending-pattern context.
catalog: cybermarket_pattern_large
schema: public
table_name: buyers
dimensions:
  authentication_level:
    description: 'TEXT. Authentication level attained by the buyer. **NULL means authentication level has not been determined.**. Possible values: Advanced, Basic.'
    label: Authentication Level
    sql: '"AuthLevel"'
    ai_context: 'Buyer Authentication Levels: Values: Advanced, Basic. Label descriptions: - Advanced: Account protected by multi factor authentication or hardware-backed credentials, offering high assurance. - Basic: Account relies on single factor authentication such as a password, with no secondary verification.'
  spend_pattern:
    description: 'TEXT. Categorised spending pattern for the buyer. Possible values: High, Low, Medium, Variable.'
    label: Spend Pattern
    sql: JSONB_EXTRACT_PATH_TEXT(buyer_risk_profile, 'spend_pattern')
    ai_context: 'Spend Pattern Categories: Values: High, Low, Medium, Variable.

      Label descriptions:

      - High: Frequent, high value purchases indicative of heavy marketplace engagement.

      - Low: Infrequent, low value purchases typical of casual or opportunistic buyers.

      - Medium: Steady purchasing cadence with moderate transaction amounts.

      - Variable: Irregular bursts of spending with no predictable pattern.'
  acq_code:
    description: TEXT. Unique identifier for a buyer (acquirer) account. PK.
    sql: '"AcqCode"'
  profile_age:
    description: 'BIGINT. Age of the buyer’s profile in days. Example: 326.'
    sql: '"ProfileAge"'
  purchase_count:
    description: 'BIGINT. Number of purchases made by the buyer. Example: 10.'
    sql: '"PurchaseCount"'
  buyer_risk_profile:
    description: JSONB column. Contains the buyer’s risk-related metrics, including risk score, behavior consistency, and purchase pattern.
    sql: buyer_risk_profile
  buyer_risk_profile_behavior_consistency_scr:
    description: 'REAL. Behaviour-consistency score across sessions. **NULL means behavioural-consistency metric not available.**. Example: 83.4.'
    sql: JSONB_EXTRACT_PATH_TEXT(buyer_risk_profile, 'behavior_consistency_scr')
  buyer_risk_profile_purchase_freq:
    description: 'TEXT. Buying-frequency classification (e.g., low, medium, high). Possible values: Heavy, Occasional, One-time, Regular.'
    sql: JSONB_EXTRACT_PATH_TEXT(buyer_risk_profile, 'purchase_freq')
  buyer_risk_profile_risk_dollar_ratio:
    description: 'text. The risk indicator associated with each buyer, calculated as the ratio of buyer risk score to payment amount in USD. Example: 0.1079 RiskScore/USD.'
    sql: JSONB_EXTRACT_PATH_TEXT(buyer_risk_profile, 'risk_dollar_ratio')
  buyer_risk_profile_risk_metric_scr:
    description: 'REAL. Risk metric assigned to the buyer based on behaviour. **NULL means risk metric has not been calculated.**. Example: 29.5.'
    sql: JSONB_EXTRACT_PATH_TEXT(buyer_risk_profile, 'risk_metric_scr')
