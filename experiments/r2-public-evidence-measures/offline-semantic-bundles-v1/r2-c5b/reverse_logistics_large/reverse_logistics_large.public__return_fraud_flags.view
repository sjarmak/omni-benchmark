label: return_fraud_flags
description: All columns of the public table return_fraud_flags.
catalog: reverse_logistics_large
schema: public
table_name: return_fraud_flags
dimensions:
  case_priority:
    description: 'TEXT. The priority level for the investigation. Possible values: High, Medium.'
    sql: case_priority
  contributing_data_points:
    description: 'JSONB. A JSON object showing the data points that caused the rule to trigger. Example: {user_return_rate: 0.8, item_value: 999.99}.'
    sql: contributing_data_points
  customer_account_action_taken:
    description: 'TEXT. The action taken on the customer''s account as a result. **NULL means no action was taken or the investigation is ongoing.** Example: Account Suspended.'
    sql: customer_account_action_taken
  financial_loss_prevented:
    description: 'REAL. The estimated financial loss that was prevented by this action. **NULL or 0.0 means it was a false positive or the investigation is ongoing.** Example: 1821.17.'
    sql: financial_loss_prevented
  flag_instance_id:
    description: 'BIGINT. Unique identifier for the fraud flag instance. PK. Example: 11000.'
    sql: flag_instance_id
  flagged_return_case:
    description: 'TEXT. The case number of the return that was flagged. FK to returns.casenum. Example: RL971661.'
    sql: flagged_return_case
  investigation_notes:
    description: 'TEXT. Notes from the investigator. **NULL means the investigation is still in progress.** Example: User has a high rate of returns for high-value items..'
    sql: investigation_notes
  investigator_employee_id:
    description: 'BIGINT. The employee ID of the investigator assigned to this case. FK to employees.EMPLOYEE_ID. Example: 1035.'
    sql: investigator_employee_id
  is_part_of_larger_ring:
    description: 'BOOLEAN. Indicates if this case is suspected to be part of a larger fraud ring. Example: False.'
    sql: is_part_of_larger_ring
  resolution_date:
    description: 'DATE. The date the investigation was resolved. **NULL means the investigation is still in progress.** Example: 2025-07-08.'
    sql: resolution_date
  review_deadline:
    description: 'DATE. The deadline for reviewing this flag. **NULL means no formal deadline was set.** Example: 2025-09-11.'
    sql: review_deadline
  status:
    description: 'TEXT. The current status of the fraud investigation. Possible values: Investigating, Confirmed Fraud, False Positive.'
    sql: status
  system_generated_score:
    description: 'REAL. A fraud score generated by the system, from 0.0 to 1.0. **NULL means the rule is a binary trigger, not score-based.** Example: 0.95.'
    sql: system_generated_score
  timestamp_triggered:
    description: 'TIMESTAMP. The exact date and time the fraud alert was triggered. Example: 2025-09-04 23:31:35.'
    sql: timestamp_triggered
  triggered_fraud_alert_rule:
    description: 'TEXT. The ID of the fraud rule that was triggered. FK to fraud_detection_rules.RULE_ID. Example: RULE-0023.'
    sql: triggered_fraud_alert_rule
