label: orders
description: All columns of the public table orders.
catalog: reverse_logistics_large
schema: public
table_name: orders
dimensions:
  buyerlink:
    description: 'TEXT. Link to the buyer''s account or details. Example: CUS00181.'
    sql: buyerlink
  transaction_value:
    description: REAL. Total value of the order transaction.
    sql: transaction_value
  txndate:
    description: 'TEXT. Date when the transaction was made. Example: Feb 16, 2025.'
    sql: txndate
  txnnum:
    description: VARCHAR(50). Unique identifier for the order transaction. PK.
    sql: txnnum
