label: Return Processing
description: Processing rows with public priority and approval semantics.
catalog: reverse_logistics_large
schema: public
table_name: return_processing
dimensions:
  approval_level:
    description: 'ApprovalLevel_enum. Level of approval required for processing the return. Possible values: Automatic, Manager, Supervisor.'
    label: Approval Level
    sql: apprlevel
    ai_context: 'Approval Levels: There 3 levels: ''Automatic'', ''Manager'' and ''Supervisor''.'
  processing_priority:
    description: 'VARCHAR(50). Processing priority for the return. Possible values: Bulk, Express, Standard.'
    label: Processing Priority
    sql: procprio
    ai_context: 'Processing Priorities: Use ''Bulk'' for palletised or batch returns processed during low-demand periods; ''Standard'' for default SLA (e.g., 3-5 days); ''Express'' for expedited for VIP customers, high resale value, or paid premium.'
  dispaction:
    description: 'TEXT. Disposition action for the return item. Possible values: Refurbish, Repair, Resell, Scrap.'
    sql: dispaction
  dispreason:
    description: 'DispositionReason_enum. Reason for the return disposition. **NULL means no disposition reason provided.**. Possible values: Good Condition, Repairable, Too Costly, Unsalvageable.'
    sql: dispreason
  estrepairhrs:
    description: 'REAL. Estimated hours required for repair. Example: 39.8.'
    sql: estrepairhrs
  exceptmade:
    description: 'VARCHAR(20). Indicates if an exception was made for the return. Possible values: No, Yes.'
    sql: exceptmade
  excepttype:
    description: 'ExceptionReason_enum. Type of exception for the return. **NULL means no exception type provided.**. Possible values: Customer Value, Error, Goodwill.'
    sql: excepttype
  handling_notes:
    description: TEXT. Notes related to the handling of the return item.
    sql: handling_notes
  handreq:
    description: 'HandlingRequirements_enum. Handling requirements for the return. Possible values: Fragile, Hazardous, Special, Standard.'
    sql: handreq
  loccode:
    description: 'VARCHAR(50). Location code for the return processing. PK. Example: LOC008.'
    sql: loccode
  needsquar:
    description: 'VARCHAR(20). Indicates if quarantine is needed for the return. Possible values: No, Yes.'
    sql: needsquar
  needsrelabel:
    description: 'TEXT. Indicates if relabeling is required for the return item. Possible values: 0, 1, F, False, N, NO, P, True, Y, YES.'
    sql: needsrelabel
  partsavail:
    description: 'PartsAvailability_enum. Availability of parts for repairing the return item. Possible values: Available, Partial, Unavailable.'
    sql: partsavail
  policycomp:
    description: 'TEXT. Policy compliance status of the return item. Possible values: Compliant, Non-compliant.'
    sql: policycomp
  procstate:
    description: 'ProcessingStatus_enum. Current state of the return processing. Possible values: Completed, Inspecting, Processing, Received.'
    sql: procstate
  proctime:
    description: 'REAL. Time taken for processing the return. Example: 15.0.'
    sql: proctime
  quardays:
    description: 'BIGINT. Number of days the return item will be quarantined. Example: 14.'
    sql: quardays
  repairfeas:
    description: 'RepairFeasibility_enum. Feasibility of repairing the return item. Possible values: High, Low, Medium, Not Feasible.'
    sql: repairfeas
