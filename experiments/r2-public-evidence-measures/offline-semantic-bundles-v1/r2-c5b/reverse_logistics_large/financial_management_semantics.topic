base_view: reverse_logistics_large_public__financial_management
label: Return Financials
description: Return financial rows with public fee, valuation, disposal, refund, and sustainability semantics.
fields:
- reverse_logistics_large_public__financial_management.*
- reverse_logistics_large_public__orders.*
- reverse_logistics_large_public__products.*
- reverse_logistics_large_public__returns.*
joins:
  reverse_logistics_large_public__returns:
    reverse_logistics_large_public__orders: {}
    reverse_logistics_large_public__products: {}
ai_context: 'Reach related views through the declared joins on this topic instead of re-deriving relationships.

  Domain definitions for this topic:

  - Return Profit Impact (RPI): $$RPI = R_v - TRC$$ where $R_v$ is Recovery Value and $TRC$ is Total Return Cost.

  - Sustainability-Adjusted Loss (SAL): $$SAL = TRC + 0.5 \times C_f - R_v$$ where $C_f$ is Carbon Footprint.'
