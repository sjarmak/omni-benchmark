label: return_packaging_inventory
description: All columns of the public table return_packaging_inventory.
catalog: reverse_logistics_large
schema: public
table_name: return_packaging_inventory
dimensions:
  biodegradable_flag:
    description: BOOLEAN. If the material is certified biodegradable.
    sql: biodegradable_flag
  branding_print_status:
    description: 'TEXT. Print status (Plain, Branded Logo). Unique values: Plain, Branded Logo, Custom.'
    sql: branding_print_status
  cost_per_unit_val:
    description: 'REAL. Cost per single unit of packaging. Example: 1.5.'
    sql: cost_per_unit_val
  current_quantity_cnt:
    description: 'INTEGER. Current quantity in stock. Example: 50.'
    sql: current_quantity_cnt
  daily_consumption_avg:
    description: 'REAL. Average daily usage rate. Example: 20.'
    sql: daily_consumption_avg
  dimensions_desc_str:
    description: TEXT. Dimensions string (e.g., 10x10x10 in).
    sql: dimensions_desc_str
  last_audit_date:
    description: TIMESTAMP. Date of last inventory count.
    sql: last_audit_date
  material_sku_code:
    description: TEXT. SKU for the packaging material.
    sql: material_sku_code
  material_type_cat:
    description: 'TEXT. Category (e.g., Cardboard Box, Bubble Wrap). Unique values: Cardboard Box, Poly Mailer, Bubble Wrap, Packing Tape.'
    sql: material_type_cat
  moisture_resistance_rating:
    description: 'INTEGER. Resistance to moisture (1-10). Example: 50.'
    sql: moisture_resistance_rating
  recycled_content_pct:
    description: 'REAL. Percentage of recycled material. Example: 50.0.'
    sql: recycled_content_pct
  reorder_point_threshold:
    description: 'INTEGER. Stock level to trigger reorder. Example: 50.'
    sql: reorder_point_threshold
  shelf_life_days:
    description: 'INTEGER. Shelf life if applicable (e.g. tape adhesive). **NULL means Indefinite.** Example: 365.'
    sql: shelf_life_days
  storage_bin_code:
    description: TEXT. Location code within the warehouse.
    sql: storage_bin_code
  strength_rating_val:
    description: 'TEXT. Strength rating (e.g., ECT-32, 200#). Unique values: ECT-32, ECT-44, 200# Test, N/A.'
    sql: strength_rating_val
  supplier_lead_time_days:
    description: 'INTEGER. Days to receive new stock. Example: 50.'
    sql: supplier_lead_time_days
  supplier_source_ref:
    description: 'INTEGER. Supplier of the packaging material. Example: 50.'
    sql: supplier_source_ref
  unit_weight_grams:
    description: 'REAL. Weight of one unit of packaging. Example: 150.'
    sql: unit_weight_grams
  warehouse_loc_ref:
    description: TEXT. Warehouse where packaging is stocked.
    sql: warehouse_loc_ref
