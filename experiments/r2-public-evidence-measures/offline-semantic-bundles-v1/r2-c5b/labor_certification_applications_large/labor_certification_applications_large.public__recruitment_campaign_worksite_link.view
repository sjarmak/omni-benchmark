label: recruitment_campaign_worksite_link
description: All columns of the public table recruitment_campaign_worksite_link.
catalog: labor_certification_applications_large
schema: public
table_name: recruitment_campaign_worksite_link
dimensions:
  applicant_ct:
    description: 'BIGINT. Applicants for this worksite posting. Example: 69.'
    sql: applicant_ct
  avg_wage_offer_usd:
    description: 'REAL. Average wage offered, USD. **NULL when offers not finalized.** Example: 108 229.'
    sql: '"avgWageOffer_USD"'
  camp_code_ref:
    description: 'TEXT. FK to recruitment_campaign.CAMP_code. Example: CAMP00001.'
    sql: camp_code_ref
  expire_date:
    description: 'DATE. Posting expiration date. Example: 2020-02-07.'
    sql: '"expireDate"'
  foot_traffic:
    description: 'TEXT. Commuter/transit descriptor. Example: 23 min walk to transit.'
    sql: '"footTraffic"'
  hire_ct:
    description: 'BIGINT. Hires from this posting. **NULL when hiring still open or data missing.** Example: 35.'
    sql: hire_ct
  post_day:
    description: 'DATE. Posting live date. Example: 2020-01-01.'
    sql: '"postDAY"'
  posting_url:
    description: 'TEXT. Public job-posting URL. **NULL if posting was internal only or link not recorded.** Example: https://jobs.example.com/a001454c-817a-4e0d-9b....'
    sql: '"postingURL"'
  reasoning_col:
    description: 'TEXT. Analyst note for this link. **NULL when autogenerated without comment.** Example: Link auto-generated.'
    sql: '"reasoningCOL"'
  travel_note:
    description: 'TEXT. Work arrangement note (Hybrid / Remote / Onsite). **NULL if not specified.** Example: Hybrid.'
    sql: '"travelNote"'
  ws_addr_ref:
    description: 'TEXT. Worksite street address. Example: 653 Oak Glen.'
    sql: ws_addr_ref
  ws_city_ref:
    description: 'TEXT. Worksite city. Example: Irvine.'
    sql: ws_city_ref
  ws_state_ref:
    description: 'TEXT. Worksite state. Example: CA.'
    sql: ws_state_ref
  ws_zip_ref:
    description: 'TEXT. Worksite ZIP. Example: 92618.'
    sql: ws_zip_ref
