label: Prevailing Wage Determinations
description: Prevailing-wage records with public structured wage-unit context.
catalog: labor_certification_applications_large
schema: public
table_name: prevailing_wage
dimensions:
  prevailing_wage_unit:
    description: 'enum_pw_unit_of_pay. Unit of pay for the prevailing wage. Possible values: Hour, Month, Week, Year.'
    label: Prevailing Wage Unit
    sql: JSONB_EXTRACT_PATH_TEXT(wage_details, 'prevailing_wage', 'unit')
    ai_context: 'Wage Payment Units: Wage payment units indicate how wages are calculated and paid, with common units including: Hour (payment calculated per working hour), Week (payment calculated as a weekly salary), Month (payment calculated as a monthly salary), and Year (payment calculated as an annual salary). Different units may be used depending on industry norms and position types. Wage unit information is included in the wage determination data.'
  trackno:
    description: TEXT. Unique tracking number for the prevailing wage record. PK.
    sql: trackno
  wage_details:
    description: JSONB column. Summarizes offered and prevailing wage details including ranges, units, and source information.
    sql: wage_details
  wage_details_alternate_source_publisher:
    description: 'TEXT. Name of the prevailing wage survey publisher. Example: Willis Towers Watson.'
    sql: JSONB_EXTRACT_PATH_TEXT(wage_details, 'alternate_source', 'publisher')
  wage_details_alternate_source_source_type:
    description: 'enum_pw_other_source. Source of the prevailing wage information. Possible values: CBA, Survey.'
    sql: JSONB_EXTRACT_PATH_TEXT(wage_details, 'alternate_source', 'source_type')
  wage_details_alternate_source_source_year:
    description: 'BIGINT. Year of the alternative wage source. **NULL means no year specified.**. Possible values: 2016.0, 2017.0, 2022.0, 2023.0.'
    sql: JSONB_EXTRACT_PATH_TEXT(wage_details, 'alternate_source', 'source_year')
  wage_details_alternate_source_survey_title:
    description: 'TEXT. Title of the prevailing wage survey. Example: Gen. Industry Professional (Technical and Operations) Report.'
    sql: JSONB_EXTRACT_PATH_TEXT(wage_details, 'alternate_source', 'survey_title')
  wage_details_offered_wage_from:
    description: 'TEXT. Minimum wage rate of pay from. Example: $35.42.'
    sql: JSONB_EXTRACT_PATH_TEXT(wage_details, 'offered_wage', 'from')
  wage_details_offered_wage_to:
    description: 'REAL. Maximum wage rate of pay to. **NULL means maximum wage not provided.**. Example: 150000.0.'
    sql: JSONB_EXTRACT_PATH_TEXT(wage_details, 'offered_wage', 'to')
  wage_details_offered_wage_unit:
    description: 'enum_wage_unit_of_pay. Unit of pay for the wage rate (e.g., Hour, Week, Year). Possible values: Hour, Week, Year.'
    sql: JSONB_EXTRACT_PATH_TEXT(wage_details, 'offered_wage', 'unit')
  wage_details_prevailing_wage_level:
    description: 'enum_pw_wage_level. Wage level classification for the position. Possible values: I, II, III, IV.'
    sql: JSONB_EXTRACT_PATH_TEXT(wage_details, 'prevailing_wage', 'level')
  wage_details_prevailing_wage_oes_year:
    description: 'TEXT. OES year for the prevailing wage survey. **NULL means no OES span provided.**. Possible values: 7/1/2023 - 6/30/2024.'
    sql: JSONB_EXTRACT_PATH_TEXT(wage_details, 'prevailing_wage', 'oes_year')
  wage_details_prevailing_wage_value:
    description: 'TEXT. Prevailing wage value. Example: USD 35.42.'
    sql: JSONB_EXTRACT_PATH_TEXT(wage_details, 'prevailing_wage', 'value')
