label: Healthcare_Power_Resilience
description: All columns of the public table Healthcare_Power_Resilience.
catalog: residential_data_large
schema: public
table_name: Healthcare_Power_Resilience
dimensions:
  inventory_tracker_fk:
    description: TEXT. Link to the primary facility equipment and infrastructure.
    sql: '"Inventory_Tracker_FK"'
  power_resilience_pk:
    description: 'TEXT. Primary key for healthcare facility power system audit. Example: HPR-1A2B3C.'
    sql: '"Power_Resilience_PK"'
  ats_switch_count_monthly:
    description: 'INTEGER. Number of Automatic Transfer Switch cycles performed. Example: 2.'
    sql: ats_switch_count_monthly
  cooling_system_power_draw_kw:
    description: 'REAL. Energy consumed by data center and MRI chillers. Example: 45.'
    sql: cooling_system_power_draw_kw
  critical_load_demand_kva:
    description: 'REAL. Power requirement of life-support and surgery circuits. Example: 120.'
    sql: critical_load_demand_kva
  diesel_fuel_degradation_index:
    description: 'REAL. Chemical stability measure of stored backup fuel. **NULL means Natural gas generator used.** Example: 50.0.'
    sql: diesel_fuel_degradation_index
  emergency_lighting_circuit_current:
    description: 'REAL. Draw on the dedicated emergency egress lighting loop. Example: 18.'
    sql: emergency_lighting_circuit_current
  energy_storage_system_capacity_mwh:
    description: 'REAL. Total energy capacity of the battery storage system. **NULL means No large-scale battery storage.** Example: 50.0.'
    sql: energy_storage_system_capacity_mwh
  facility_sq_meters_conditioned:
    description: 'INTEGER. Total floor area covered by the backup power scheme. Example: 50.'
    sql: facility_sq_meters_conditioned
  generator_startup_latency_sec:
    description: 'REAL. Time from grid failure to backup power stabilization. Example: 8.5.'
    sql: generator_startup_latency_sec
  grid_voltage_harmonic_distortion:
    description: 'REAL. Total harmonic distortion of incoming utility power. **NULL means Power quality analyzer offline.** Example: 50.0.'
    sql: grid_voltage_harmonic_distortion
  grounding_resistance_ohms:
    description: 'REAL. Electrical resistance to the earth ground. **NULL means Maintenance in progress.** Example: 3.5.'
    sql: grounding_resistance_ohms
  maintenance_staff_on_call_count:
    description: 'INTEGER. Number of certified electricians available for immediate response. Unique values: 1, 2, 3, 4.'
    sql: maintenance_staff_on_call_count
  microgrid_controller_status:
    description: 'TEXT. Current operating mode of the facility energy network. Unique values: Grid_Tied, Islanded, Battery_Discharge, Load_Shedding.'
    sql: microgrid_controller_status
  peak_shaving_rebate_accrued_brl:
    description: 'REAL. Financial savings from utility demand-response programs. **NULL means Not enrolled in demand response.** Example: 50.0.'
    sql: peak_shaving_rebate_accrued_brl
  power_factor_efficiency:
    description: 'REAL. Ratio of real power to apparent power. Example: 50.0.'
    sql: power_factor_efficiency
  solar_photovoltaic_yield_kwh:
    description: 'REAL. Energy generated by rooftop solar arrays. **NULL means No solar installation.** Example: 50.0.'
    sql: solar_photovoltaic_yield_kwh
  surge_protection_event_count:
    description: 'INTEGER. Detected transient overvoltage events suppressed. Example: 1.'
    sql: surge_protection_event_count
  transformer_oil_temperature_c:
    description: 'REAL. Core temperature of the main step-down transformer. Example: 65.'
    sql: transformer_oil_temperature_c
  ups_battery_health_percent:
    description: 'REAL. Average state of health for Uninterruptible Power Supplies. Example: 88.'
    sql: ups_battery_health_percent
