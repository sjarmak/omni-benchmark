label: Transportation Assets
description: Public household transportation asset records with vehicle context.
catalog: residential_data_large
schema: public
table_name: transportation_assets
dimensions:
  newest_vehicle_year:
    description: Year of manufacture for the newest vehicle in the household's transportation fleet, stored as text to accommodate various date formats and null values. Contains NULL when no vehicles are owned, vehicle age information is not available, or vehicles are too old to have reliable manufacture date records. EX.2012 To 2013, Not applicable, 2014 or newer
    label: Newest Vehicle Year
    sql: JSONB_EXTRACT_PATH_TEXT(vehicleinventory, 'Newest_Year')
    ai_context: 'Vehicle Year Range: Text ranges like ''1995 to 1999'', ''2005 to 2009'', or ''2010 to 2013''. Null indicates no vehicles or unknown age.'
  vehicle_type_distribution:
    description: JSONB column. Aggregates transportation assets owned by household including counts of different vehicle types and age information for mobility analysis.
    label: Vehicle Type Distribution
    sql: vehicleinventory
    ai_context: 'Vehicle Type Distribution: An array of counts representing vehicle types. Null indicates unknown or unverified ownership.'
  housetag:
    description: Foreign key referencing households.HouseNum with unique constraint, ensuring 1:1 relationship for transportation assets per household. EX.3,4,7
    sql: housetag
  transref:
    description: A SERIAL primary key uniquely identifying each transportation asset record for households. EX. 1,2,3
    sql: transref
  vehicleinventory_vehicle_counts_auto_count:
    description: Number of passenger vehicles owned by the household, defaulting to 0 if no vehicles are owned. Contains NULL when vehicle ownership status is unknown or verification is pending. ex.0
    sql: JSONB_EXTRACT_PATH_TEXT(vehicleinventory, 'vehicle_counts', 'Auto_Count')
  vehicleinventory_vehicle_counts_bike_count:
    description: Number of bicycles owned by the household for transportation and recreation, defaulting to 0 if none are owned. Contains NULL when bicycle ownership information is not available or not tracked. ex.0,1
    sql: JSONB_EXTRACT_PATH_TEXT(vehicleinventory, 'vehicle_counts', 'Bike_Count')
  vehicleinventory_vehicle_counts_motor_count:
    description: Number of motorcycles, scooters, or motorized two-wheelers owned by the household, defaulting to 0 if none are owned. Contains NULL when motorcycle ownership information is not available or not applicable. EX.0,1,2
    sql: JSONB_EXTRACT_PATH_TEXT(vehicleinventory, 'vehicle_counts', 'Motor_Count')
