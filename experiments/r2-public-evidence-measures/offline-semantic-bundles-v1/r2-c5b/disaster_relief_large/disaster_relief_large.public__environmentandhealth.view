label: environmentandhealth
description: All columns of the public table environmentandhealth.
catalog: disaster_relief_large
schema: public
table_name: environmentandhealth
dimensions:
  env_dist_ref:
    description: VARCHAR(20). Disaster event reference. FK to DisasterEvents.
    sql: env_dist_ref
  envhealthregistry:
    description: VARCHAR(20). Unique environment and health registry identifier. PK.
    sql: envhealthregistry
  health_environment_profile:
    description: JSONB column. Summarizes environmental and health conditions during the disaster response.
    sql: health_environment_profile
  health_environment_profile_environment_carbon_tons:
    description: 'REAL. Carbon emissions in tons. **NULL means carbon data not recorded.**. Example: 793.5.'
    sql: JSONB_EXTRACT_PATH_TEXT(health_environment_profile, 'environment', 'carbon_tons')
  health_environment_profile_environment_impact_rate:
    description: 'TEXT. Environmental impact rate. Possible values: High, Low, Medium.'
    sql: JSONB_EXTRACT_PATH_TEXT(health_environment_profile, 'environment', 'impact_rate')
  health_environment_profile_environment_recycling_pct:
    description: 'REAL. Recycling percentage. Example: 68.4.'
    sql: JSONB_EXTRACT_PATH_TEXT(health_environment_profile, 'environment', 'recycling_pct')
  health_environment_profile_environment_renewable_energy_pct:
    description: 'REAL. Renewable energy percentage. Example: 43.3.'
    sql: JSONB_EXTRACT_PATH_TEXT(health_environment_profile, 'environment', 'renewable_energy_pct')
  health_environment_profile_environment_sanitation_coverage:
    description: 'REAL. Sanitation coverage percentage. Example: 53.5.'
    sql: JSONB_EXTRACT_PATH_TEXT(health_environment_profile, 'environment', 'sanitation_coverage')
  health_environment_profile_environment_waste_management:
    description: 'TEXT. Waste management status. Possible values: Adequate, Critical, Limited.'
    sql: JSONB_EXTRACT_PATH_TEXT(health_environment_profile, 'environment', 'waste_management')
  health_environment_profile_environment_water_quality_index:
    description: 'TEXT. Water quality index. Example: 85.6 WQI.'
    sql: JSONB_EXTRACT_PATH_TEXT(health_environment_profile, 'environment', 'water_quality_index')
  health_environment_profile_health_disease_risk:
    description: 'DiseaseRisk_enum. Disease risk level. Possible values: High, Low, Medium.'
    sql: JSONB_EXTRACT_PATH_TEXT(health_environment_profile, 'health', 'disease_risk')
  health_environment_profile_health_medical_capacity:
    description: 'MedicalEmergencyCapacity_enum. Medical emergency capacity level. Possible values: Adequate, Critical, Limited.'
    sql: JSONB_EXTRACT_PATH_TEXT(health_environment_profile, 'health', 'medical_capacity')
  health_environment_profile_health_mental_health_aid:
    description: 'TEXT. Mental health aid status. Possible values: Available, Limited.'
    sql: JSONB_EXTRACT_PATH_TEXT(health_environment_profile, 'health', 'mental_health_aid')
  health_environment_profile_health_vaccination_coverage:
    description: 'REAL. Vaccination coverage percentage. **NULL means vaccination coverage not recorded.**. Example: 14.8.'
    sql: JSONB_EXTRACT_PATH_TEXT(health_environment_profile, 'health', 'vaccination_coverage')
