label: Artifact Security and Access
description: Artifact security-access rows with insurance-value rarity and valuation semantics.
catalog: museum_artifact_large
schema: public
table_name: ArtifactSecurityAccess
dimensions:
  insurance_value_usd:
    description: 'REAL. Insurance value in USD for the artifact. Example: 968368.'
    label: Insurance Value (USD)
    sql: '"insUSD"'
  sec_level:
    description: 'TEXT. Security level for the artifact. Possible values: Level 1, Level 2, Level 3.'
    sql: '"SEC_LEVEL"'
  access_restrict:
    description: 'TEXT. Restrictions on access to the artifact. Possible values: Limited, Public, Restricted.'
    sql: access_restrict
  cond_report:
    description: 'TEXT. The condition report for the artifact, extracted from the documentation_status_profile JSON. Possible values: Due, Current.'
    sql: cond_report
  conserve_rec:
    description: 'TEXT. Conservation recommendations for the artifact, extracted from the documentation_status_profile JSON. Possible values: Review Required, Updated, Pending.'
    sql: conserve_rec
  digital_rec:
    description: 'TEXT. The status of the digital record, extracted from the documentation_status_profile JSON. Possible values: In Progress, Complete, Partial.'
    sql: digital_rec
  docu_stat:
    description: 'TEXT. The documentation status, extracted from the documentation_status_profile JSON. Possible values: Partial, Updating.'
    sql: docu_stat
  loan_stat:
    description: 'TEXT. Loan status of the artifact. PK. Possible values: Available, Not Available, On Loan.'
    sql: loan_stat
  photo_docu:
    description: 'TEXT. The status of photo documentation, extracted from the documentation_status_profile JSON. Possible values: Required, Outdated.'
    sql: photo_docu
  research_access:
    description: 'TEXT. Research access status for the artifact. Possible values: Available, Limited, Restricted.'
    sql: research_access
  is_high_rarity_and_valuation:
    label: Artifact Rarity & Valuation (ARV)
    description: Establishes criteria for identifying artifacts of exceptional rarity and valuation.
    sql: ${insurance_value_usd} > 1000000.0
    ai_context: Use this modeled field for Artifact Rarity & Valuation (ARV); do not reconstruct its formula.
