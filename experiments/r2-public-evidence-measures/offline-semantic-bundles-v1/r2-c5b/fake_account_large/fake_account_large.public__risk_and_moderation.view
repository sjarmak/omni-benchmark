label: Risk and Moderation
description: Account-level risk and moderation data with row-local risk semantics and score context.
catalog: fake_account_large
schema: public
table_name: risk_and_moderation
dimensions:
  risk_value:
    description: 'REAL. Risk value score. **NULL means risk value not assigned.**. Example: 0.155.'
    label: Risk Value
    sql: CAST(JSONB_EXTRACT_PATH_TEXT(risk_profile, 'risk_scores', 'risk_value') AS DOUBLE PRECISION)
  trust_value:
    description: 'REAL. Trust value score. Example: 0.353.'
    label: Trust Value
    sql: CAST(JSONB_EXTRACT_PATH_TEXT(risk_profile, 'risk_scores', 'trust_score') AS DOUBLE PRECISION)
    ai_context: 'trust value: Ranges from 0 to 1. Values above 0.7 indicate highly trusted accounts, while values below 0.3 suggest untrusted or suspicious accounts.'
  impact_value:
    description: 'REAL. Impact value score. Example: 0.544.'
    label: Impact Value
    sql: CAST(JSONB_EXTRACT_PATH_TEXT(risk_profile, 'risk_scores', 'impact_score') AS DOUBLE PRECISION)
    ai_context: 'impact value: Ranges from 0 to 1. Values above 0.7 indicate high-impact violations requiring immediate attention, while values below 0.3 suggest low-priority issues.'
  acct_risk:
    description: TEXT. Account reference for risk and moderation data. PK. FK to accounts.
    sql: acct_risk
  risk_profile:
    description: JSONB column. Bundles risk, authenticity / credibility, violation history and overall reputation into one JSONB field for faster trust-and-safety look-ups and enforcement rules.
    sql: risk_profile
  risk_profile_risk_scores_authenticity_score:
    description: 'REAL. Authorization score. Example: 0.15.'
    sql: JSONB_EXTRACT_PATH_TEXT(risk_profile, 'risk_scores', 'authenticity_score')
  risk_profile_risk_scores_credibility_score:
    description: 'REAL. Credit score. Example: 0.441.'
    sql: JSONB_EXTRACT_PATH_TEXT(risk_profile, 'risk_scores', 'credibility_score')
  risk_profile_risk_scores_reputation_score:
    description: 'REAL. Reputation score. Example: 0.23.'
    sql: JSONB_EXTRACT_PATH_TEXT(risk_profile, 'risk_scores', 'reputation_score')
  risk_profile_risk_scores_threat_level:
    description: 'TEXT. Threat level description. Possible values: Critical, High, Low, Medium.'
    sql: JSONB_EXTRACT_PATH_TEXT(risk_profile, 'risk_scores', 'threat_level')
  risk_profile_violation_history_abuse_count:
    description: 'BIGINT. Abuse count against the account. Example: 24.'
    sql: JSONB_EXTRACT_PATH_TEXT(risk_profile, 'violation_history', 'abuse_count')
  risk_profile_violation_history_appeal_count:
    description: 'BIGINT. Appeal count. Possible values: 0, 1, 2, 3, 4, 5.'
    sql: JSONB_EXTRACT_PATH_TEXT(risk_profile, 'violation_history', 'appeal_count')
  risk_profile_violation_history_suspension_history_json:
    description: 'JSONB. Suspension history data. Possible values: 0, 1, 2, 3, 4, 5.'
    sql: JSONB_EXTRACT_PATH_TEXT(risk_profile, 'violation_history', 'suspension_history_json')
  risk_profile_violation_history_violation_distribution_json:
    description: 'JSONB. Violations distribution details. Example: {''Spam'': 0.9353273606557855, ''Fake'': 0.4490233249279981, ''Abuse'': 0.08219689664928109}.'
    sql: JSONB_EXTRACT_PATH_TEXT(risk_profile, 'violation_history', 'violation_distribution_json')
  risk_profile_violation_history_warning_count:
    description: 'BIGINT. Warning count. Example: 0.'
    sql: JSONB_EXTRACT_PATH_TEXT(risk_profile, 'violation_history', 'warning_count')
  security_risk_score:
    label: Security Risk Score (SRS)
    description: Calculates overall security risk based on multiple factors.
    sql: 0.4 * ${risk_value} + 0.3 * (1.0 - ${trust_value}) + 0.3 * ${impact_value}
    ai_context: Use this modeled field for Security Risk Score (SRS); do not reconstruct its formula.
