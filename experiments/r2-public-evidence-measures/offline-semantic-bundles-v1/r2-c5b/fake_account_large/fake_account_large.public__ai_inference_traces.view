label: ai_inference_traces
description: All columns of the public table ai_inference_traces.
catalog: fake_account_large
schema: public
table_name: ai_inference_traces
dimensions:
  trace_code:
    description: TEXT. Unique identifier for the AI model inference execution.
    sql: '"Trace_CODE"'
  bias_check_score:
    description: 'REAL. Score indicating potential demographic bias in output. Example: 0.05.'
    sql: bias_check_score
  cache_hit_flag:
    description: 'BOOLEAN. True if result was served from semantic cache. Possible values: True, False.'
    sql: cache_hit_flag
  compute_cost_micro_usd:
    description: 'INTEGER. Estimated cost of the inference call in micros. Example: 500.'
    sql: compute_cost_micro_usd
  drift_magnitude:
    description: 'REAL. Distance of input from training distribution baseline. **NULL means Drift monitoring disabled.** Example: 50.0.'
    sql: drift_magnitude
  fallback_model_used:
    description: 'BOOLEAN. True if primary model failed and smaller model was used. Possible values: True, False.'
    sql: fallback_model_used
  feature_vector_hash:
    description: TEXT. Hash of the input feature vector for reproducibility.
    sql: feature_vector_hash
  gpu_memory_peak_mb:
    description: 'INTEGER. Peak VRAM usage during inference. Example: 4096.'
    sql: gpu_memory_peak_mb
  inference_latency_ms:
    description: 'REAL. Time taken for the model to return a prediction. Example: 150.'
    sql: inference_latency_ms
  input_token_usage:
    description: 'INTEGER. Number of tokens in the input prompt. Example: 50.'
    sql: input_token_usage
  model_confidence_score:
    description: 'REAL. Probability score (0.0-1.0) returned by the model. Example: 50.0.'
    sql: model_confidence_score
  model_version_tag:
    description: 'TEXT. Semantic version of the ML model used. Unique values: v2.4.1, v2.5.0, v3.0.0-rc.'
    sql: model_version_tag
  output_token_usage:
    description: 'INTEGER. Number of tokens generated in the response. Example: 50.'
    sql: output_token_usage
  prompt_template_ref:
    description: 'TEXT. Code referring to the prompt engineering template used. Unique values: RISK_V1, FRAUD_GEN2.'
    sql: prompt_template_ref
  risk_event_ref:
    description: TEXT. Reference to the risk event that triggered this inference.
    sql: risk_event_ref
  stop_reason_code:
    description: 'TEXT. Reason generation halted (length, token, filter). Unique values: EOS, LENGTH, FILTER.'
    sql: stop_reason_code
  temperature_param:
    description: 'REAL. Creativity parameter setting used for the model. Unique values: 0.0, 0.7, 1.0.'
    sql: temperature_param
  toxicity_filter_triggered:
    description: 'BOOLEAN. True if output triggered safety guardrails. Possible values: True, False.'
    sql: toxicity_filter_triggered
  vector_db_latency_ms:
    description: 'REAL. Time spent retrieving context from vector store. **NULL means No RAG context used.** Example: 15.'
    sql: vector_db_latency_ms
