label: plant_record
description: All columns of the public table plant_record.
catalog: solar_panel_large
schema: public
table_name: plant_record
dimensions:
  sitetie:
    description: TEXT. FK → plants.SiteKey. Links to parent solar plant.
    sql: sitetie
  snapkey:
    description: 'TEXT. Snapshot identifier. Unique ID for performance snapshot. Example: PV937101.'
    sql: snapkey
  snapts:
    description: 'TIMESTAMP. Timestamp when snapshot was taken. Example: 43315.51482.'
    sql: snapts
