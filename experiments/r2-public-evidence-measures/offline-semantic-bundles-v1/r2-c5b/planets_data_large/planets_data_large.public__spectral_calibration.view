label: SpectralCalibration
description: All columns of the public table SpectralCalibration.
catalog: planets_data_large
schema: public
table_name: SpectralCalibration
dimensions:
  calibration_frames:
    description: BIGINT. Number of calibration frames used
    sql: '"CALIBRATION_FRAMES"'
  calibration_id:
    description: BIGINT. Primary key. Unique calibration record identifier
    sql: '"CALIBRATION_ID"'
  calibration_source:
    description: 'TEXT. Source used for calibration Possible values: ThAr Lamp, Fabry-Perot, Sky Lines, Standard Star, Flat Lamp, Laser Frequency Comb.'
    sql: '"CALIBRATION_SOURCE"'
  calibration_type:
    description: 'TEXT. Type of calibration Possible values: Wavelength, Flux, Flat Field, Bias, Dark, Throughput, PSF.'
    sql: '"CALIBRATION_TYPE"'
  quality_score:
    description: 'REAL. Calibration quality score Typical range: 0 to 100.'
    sql: '"QUALITY_SCORE"'
  status:
    description: 'TEXT. Calibration status Possible values: Applied, Pending, Failed, Superseded.'
    sql: '"STATUS"'
  temperature_k:
    description: 'REAL. Instrument temperature during calibration Typical range: 6 to 300.'
    sql: '"TEMPERATURE_K"'
  updated_at:
    description: TIMESTAMP WITHOUT TIME ZONE. Last update timestamp
    sql: '"UPDATED_AT"'
  wavelength_rms_nm:
    description: 'REAL. Wavelength calibration RMS in nm Typical range: 0.0001 to 0.5. **NULL means Not a wavelength calibration.**'
    sql: '"WAVELENGTH_RMS_nm"'
  automated:
    description: BOOLEAN. Whether calibration was automated Boolean flag (true/false).
    sql: automated
  calibration_code:
    description: TEXT. Calibration reference code
    sql: calibration_code
  calibration_date:
    description: TIMESTAMP WITHOUT TIME ZONE. Date of calibration
    sql: calibration_date
  calibration_file_url:
    description: TEXT. URL to calibration file
    sql: calibration_file_url
  created_at:
    description: TIMESTAMP WITHOUT TIME ZONE. Record creation timestamp
    sql: created_at
  exposure_time_s:
    description: 'REAL. Exposure time for calibration frames Typical range: 0.1 to 600.'
    sql: exposure_time_s
  flux_accuracy_pct:
    description: 'REAL. Flux calibration accuracy (%) Typical range: 0.1 to 20. **NULL means Not a flux calibration.**'
    sql: flux_accuracy_pct
  instrument_ref:
    description: BIGINT. Foreign key referencing instruments_surveys(instrumentref). Related instrument
    sql: instrument_ref
  software_version:
    description: 'TEXT. Calibration software version Possible values: v1.0, v2.0, v2.3, v3.1.'
    sql: software_version
