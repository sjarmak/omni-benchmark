label: Virtual Idols
description: Virtual idol records with row-level type semantics.
catalog: virtual_idol_large
schema: public
table_name: virtualidols
dimensions:
  idol_type:
    description: TEXT. Type or category classification of the virtual_idol idol (e.g., vtuber, AI idol).
    label: Idol Type
    sql: kind_tag
    ai_context: 'Idol Type Classification: Describes the nature of the virtual idol. ''2D'' refers to traditionally animated characters. ''3D'' refers to computer-generated models. ''AI Generated'' refers to idols created and/or operated by artificial intelligence.'
  assoc_group:
    description: TEXT. Associated agency, company, or group managing the virtual_idol idol.
    sql: assoc_group
  deb_date:
    description: TEXT. Official debut date when the virtual_idol idol first appeared publicly.
    sql: deb_date
  entity_reg:
    description: TEXT. Unique identifier for virtual_idol idol entity registration. PK = virtual_idolIdols(Entity_Reg).
    sql: entity_reg
  genre_tag:
    description: TEXT. Primary genre or content category the virtual_idol idol specializes in.
    sql: genre_tag
  name_tag:
    description: TEXT. Official name or stage name of the virtual_idol idol character.
    sql: name_tag
  prim_lang:
    description: TEXT. Primary language used by the virtual_idol idol for content and communication.
    sql: prim_lang
