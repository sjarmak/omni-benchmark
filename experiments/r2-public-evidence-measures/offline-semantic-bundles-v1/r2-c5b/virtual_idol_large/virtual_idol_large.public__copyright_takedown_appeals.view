label: CopyrightTakedownAppeals
description: All columns of the public table CopyrightTakedownAppeals.
catalog: virtual_idol_large
schema: public
table_name: CopyrightTakedownAppeals
dimensions:
  admin_fee_paid_usd:
    description: 'REAL. Fee for processing (if any). Example: 50.0.'
    sql: admin_fee_paid_usd
  appeal_date:
    description: TIMESTAMP. Date appeal filed.
    sql: appeal_date
  appeal_id:
    description: TEXT. Unique ID for the counter-notification.
    sql: appeal_id
  appellant_name:
    description: TEXT. Legal name of person appealing.
    sql: appellant_name
  attachment_proof_url:
    description: TEXT. Link to license PDF etc. **NULL means No proof attached.**
    sql: attachment_proof_url
  automated_screening_score:
    description: 'REAL. AI pre-check validity score (0-1). Example: 0.4.'
    sql: automated_screening_score
  contact_email:
    description: TEXT. Email for correspondence.
    sql: contact_email
  escalation_level:
    description: 'INTEGER. Tier of review (1-3). Example: 50.'
    sql: escalation_level
  final_decision_date:
    description: TIMESTAMP. When decision was made. **NULL means Pending.**
    sql: final_decision_date
  is_successful:
    description: 'BOOLEAN. True if content was restored. **NULL means Pending.** Possible values: True, False.'
    sql: is_successful
  jurisdiction_code:
    description: 'TEXT. Country code for legal context. Unique values: US, JP, EU, CN.'
    sql: jurisdiction_code
  justification_text:
    description: TEXT. Reason for appeal (Fair Use, etc.).
    sql: justification_text
  legal_basis_category:
    description: 'TEXT. Legal argument used. Unique values: Fair Use, Misidentification, License Owned, Public Domain.'
    sql: legal_basis_category
  original_takedown_id_ref:
    description: TEXT. Reference code from DMCA notice.
    sql: original_takedown_id_ref
  report_ref:
    description: TEXT. FK to CopyrightInfringementReports.
    sql: report_ref
  reviewer_notes:
    description: TEXT. Internal legal team notes. **NULL means data unavailable.**
    sql: reviewer_notes
  status:
    description: 'TEXT. Current status of appeal. Unique values: Pending, Approved, Rejected.'
    sql: status
  user_trust_score:
    description: 'INTEGER. Internal reputation score of appellant. Example: 50.'
    sql: user_trust_score
