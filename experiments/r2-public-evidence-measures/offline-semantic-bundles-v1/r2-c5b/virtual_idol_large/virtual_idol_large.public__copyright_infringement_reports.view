label: CopyrightInfringementReports
description: All columns of the public table CopyrightInfringementReports.
catalog: virtual_idol_large
schema: public
table_name: CopyrightInfringementReports
dimensions:
  ai_probability_score:
    description: 'REAL. Likelihood content was AI-generated (0-1). Example: 50.0.'
    sql: ai_probability_score
  claimant_legal_entity:
    description: 'TEXT. Agency or firm filing the report. Unique values: IdolAgency Legal, BrandProtect Inc, AutoScanner Bot.'
    sql: claimant_legal_entity
  content_type:
    description: 'TEXT. Type of IP misused. Unique values: Music Audio, Character Model, Voice Deepfake, Merch Design.'
    sql: content_type
  detection_timestamp:
    description: 'TIMESTAMP. When the infringement was detected. Example: 2024-01-01 12:00:00.'
    sql: detection_timestamp
  evidence_screenshot_url:
    description: TEXT. Proof of infringement.
    sql: evidence_screenshot_url
  idol_entity_ref:
    description: TEXT. The idol whose IP was infringed.
    sql: idol_entity_ref
  infringer_username:
    description: TEXT. Account name of the uploader.
    sql: infringer_username
  infringing_url:
    description: TEXT. Link to the unauthorized content.
    sql: infringing_url
  is_repeat_offender:
    description: 'BOOLEAN. True if user has prior strikes. Possible values: True, False.'
    sql: is_repeat_offender
  legal_action_taken:
    description: 'BOOLEAN. True if lawsuit was filed. Possible values: True, False.'
    sql: legal_action_taken
  manual_review_notes:
    description: TEXT. Analyst comments. **NULL means data unavailable.**
    sql: manual_review_notes
  monetization_flag:
    description: 'BOOLEAN. True if infringer was making money. Possible values: True, False.'
    sql: monetization_flag
  platform_ref:
    description: 'TEXT. FK to platforms.platform_id where content was found. Unique values: PLT-01, PLT-02, PLT-05.'
    sql: platform_ref
  platform_response_time_hours:
    description: 'REAL. Hours taken by platform to comply. **NULL means No response.** Example: 24.'
    sql: platform_response_time_hours
  report_id:
    description: TEXT. Unique ID for the copyright claim.
    sql: report_id
  resolution_date:
    description: TIMESTAMP. Date case was closed. **NULL means Still open.**
    sql: resolution_date
  severity_score:
    description: 'INTEGER. Impact assessment (1-5). Example: 50.'
    sql: severity_score
  takedown_status:
    description: 'TEXT. Current status of the takedown request. Unique values: Detected, Notice Sent, Removed, Counter-Claimed, Ignored.'
    sql: takedown_status
  view_count_at_detection:
    description: 'INTEGER. Number of views before detection. Example: 1000.'
    sql: view_count_at_detection
