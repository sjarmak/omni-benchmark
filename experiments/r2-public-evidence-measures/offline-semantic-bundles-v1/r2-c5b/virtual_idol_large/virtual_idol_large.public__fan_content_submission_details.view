label: fan_content_submission_details
description: All columns of the public table fan_content_submission_details.
catalog: virtual_idol_large
schema: public
table_name: fan_content_submission_details
dimensions:
  associated_event_id:
    description: 'BIGINT. Identifier for an event the submission is related to. **NULL means it is not associated with any event.** Example: 8.0.'
    sql: '"ASSOCIATED_EVENT_ID"'
  associated_idol_ref:
    description: 'TEXT. Foreign key referencing the idol the submission is about. FK to virtualidols(entity_reg). Example: VI1057.'
    sql: '"Associated_Idol_Ref"'
  community_rating:
    description: Average rating given by the community (1-5 scale).
    sql: '"COMMUNITY_RATING"'
  comment_count:
    description: Total number of comments on the submission.
    sql: '"CommentCount"'
  content_language:
    description: 'TEXT. The primary language of the content. Example: Japanese.'
    sql: '"ContentLanguage"'
  fan_identifier:
    description: 'TEXT. Foreign key referencing the fan who made the submission. FK to fans(user_registry). Example: FAN78978.'
    sql: '"Fan_Identifier"'
  geographic_origin:
    description: 'TEXT. The geographic origin of the submitter. Example: Brazil.'
    sql: '"GEOGRAPHIC_ORIGIN"'
  like_count:
    description: Total number of likes received.
    sql: '"LIKE_COUNT"'
  moderator_id:
    description: 'BIGINT. The identifier of the moderator who reviewed the submission. **NULL means the submission is pending review.** Example: 7.0.'
    sql: '"MODERATOR_ID"'
  moderation_status:
    description: 'TEXT. The moderation status of the submission. Possible values: Approved, Rejected, Pending. Example: Approved.'
    sql: '"ModerationStatus"'
  monetization_status:
    description: 'TEXT. The monetization status of the submission. Possible values: Not Monetized, Monetized. Example: Not Monetized.'
    sql: '"MonetizationStatus"'
  privacy_setting:
    description: 'TEXT. The privacy setting for the submission. Possible values: Followers Only, Private, Public. Example: Followers Only.'
    sql: '"PRIVACY_SETTING"'
  plagiarism_score_percent:
    description: 'REAL. The plagiarism score from an automated check. **NULL means a check was not performed.** Example: 9.58.'
    sql: '"PlagiarismScore_percent"'
  revenue_generated_dollar:
    description: 'REAL. The total revenue generated by the submission in USD. **NULL means the content is not monetized or has not generated revenue.** Example: 620.28.'
    sql: '"REVENUE_GENERATED_dollar"'
  submission_description:
    description: 'TEXT. A description of the submitted content. Example: I wrote a short story exploring the lore behind her new costume, focusing on her backstory..'
    sql: '"SUBMISSION_DESCRIPTION"'
  submission_id:
    description: 'BIGINT. Unique identifier for the fan content submission. PK. Example: 10001.'
    sql: '"SUBMISSION_ID"'
  submission_timestamp:
    description: 'TIMESTAMP. The timestamp when the content was submitted. Example: 2024-03-31 02:39:05.'
    sql: '"SubmissionTimestamp"'
  submission_title:
    description: 'TEXT. The title of the submission. Example: My Tribute to Idol1098.'
    sql: '"SubmissionTitle"'
  update_timestamp:
    description: 'TIMESTAMP. The timestamp of the last update to the submission''s details. Example: 2024-05-24 14:29:56.'
    sql: '"UPDATE_TIMESTAMP"'
  view_count:
    description: Total number of views received.
    sql: '"ViewCount"'
  content_type:
    description: 'TEXT. The type of content submitted. Possible values: Short Story, Fan Art, Music Cover, Video Edit, Meme, Cosplay Photo. Example: Short Story.'
    sql: content_type
  copyright_check_status:
    description: 'TEXT. The status of the automated copyright check. Possible values: In Progress, Passed, Flagged. Example: In Progress.'
    sql: copyright_check_status
  dislike_count:
    description: Total number of dislikes received.
    sql: dislike_count
  file_format:
    description: 'TEXT. The file format of the submission. Example: MP3.'
    sql: file_format
  file_size_mb:
    description: 'REAL. The file size of the submission in megabytes. Example: 232.62.'
    sql: file_size_mb
  is_anonymous_submission:
    description: 'BOOLEAN. A flag indicating if the submission was made anonymously. Example: true.'
    sql: is_anonymous_submission
  is_featured:
    description: 'BOOLEAN. A flag indicating if the submission is featured. Example: false.'
    sql: is_featured
  last_viewed_timestamp:
    description: 'TIMESTAMP. The timestamp of the last time the submission was viewed. Example: 2024-12-03 21:21:37.'
    sql: last_viewed_timestamp
  moderation_notes:
    description: 'TEXT. Notes left by the moderator. **NULL means no notes were provided.** Example: Contains unapproved commercial advertising..'
    sql: moderation_notes
  submission_url:
    description: 'TEXT. The URL to view the submission. Example: https://fan-content.example.com/submissions/543d17f5-31ea-460a-be5b-2999e217de6a.'
    sql: submission_url
  tags:
    description: 'TEXT ARRAY. A list of tags for the submission. Example: {guide,collaboration}.'
    sql: tags
