label: MarketSentimentScores
description: All columns of the public table MarketSentimentScores.
catalog: exchange_traded_funds_large
schema: public
table_name: MarketSentimentScores
dimensions:
  market_sentiment_scores_id:
    description: 'TEXT. Unique identifier for the sentiment record. Example: XX-1A2B3C.'
    sql: '"MarketSentimentScores_id"'
  aggregate_polarity_score:
    description: 'REAL. Overall sentiment polarity (-1 to 1). Example: 0.1.'
    sql: aggregate_polarity_score
  analysis_timestamp:
    description: 'TIMESTAMP. Date and time of the sentiment analysis. Example: 2024-01-01 12:00:00.'
    sql: analysis_timestamp
  analyst_report_mentions:
    description: 'INTEGER. Count of official analyst notes released. Example: 50.'
    sql: analyst_report_mentions
  bot_activity_ratio:
    description: 'REAL. Estimated percentage of social volume from bots. Example: 0.15.'
    sql: bot_activity_ratio
  data_completeness_flag:
    description: 'BOOLEAN. Flag indicating if all feeds were operational. Possible values: True, False.'
    sql: data_completeness_flag
  fear_index_score:
    description: 'REAL. NLP derived fear emotion score (0-100). Example: 50.0.'
    sql: fear_index_score
  headline_impact_score:
    description: 'REAL. Estimated market impact of headlines alone. Example: 50.0.'
    sql: headline_impact_score
  language_scope_code:
    description: 'TEXT. Language of the analyzed corpus. Unique values: EN, CN, JP, DE, FR.'
    sql: language_scope_code
  news_volume_count:
    description: 'INTEGER. Number of news articles processed. Example: 50.'
    sql: news_volume_count
  primary_topic_tag:
    description: 'TEXT. Dominant topic in the coverage. Unique values: Earnings, Litigation, Product Launch, M&A, Executive Change, Macro.'
    sql: primary_topic_tag
  security_ref:
    description: 'INTEGER. Reference to the analyzed security. Example: 50.'
    sql: security_ref
  sentiment_momentum_1d:
    description: 'REAL. Change in sentiment score over 24h. Example: 0.0.'
    sql: sentiment_momentum_1d
  sentiment_volatility_7d:
    description: 'REAL. Standard deviation of sentiment over 7 days. **NULL means Insufficient history.** Example: 50.0.'
    sql: sentiment_volatility_7d
  social_buzz_volume:
    description: 'INTEGER. Number of social media mentions. Example: 5000.'
    sql: social_buzz_volume
  source_diversity_score:
    description: 'REAL. Metric indicating variety of news sources. **NULL means Insufficient source data.** Example: 50.0.'
    sql: source_diversity_score
  subjectivity_index:
    description: 'REAL. Measure of subjective vs objective language. Example: 0.4.'
    sql: subjectivity_index
  trust_index_score:
    description: 'REAL. NLP derived trust emotion score (0-100). Example: 50.0.'
    sql: trust_index_score
