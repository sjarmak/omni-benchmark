label: expense_evolution_history
description: All columns of the public table expense_evolution_history.
catalog: exchange_traded_funds_large
schema: public
table_name: expense_evolution_history
dimensions:
  administration_fee:
    description: 'TEXT. Administration fee with unit notation. Examples: 1.5 bps/year, 3.5 bps/year, 1.8 bps/year.'
    sql: administration_fee
  announcement_date:
    description: 'DATE. Date of expense change announcement. Examples: 2023-12-15, 2024-01-15, 2024-02-20.'
    sql: announcement_date
  audit_fee:
    description: 'TEXT. Audit fee with unit notation. Possible values: 0.3 bps/year, 0.4 bps/year, 0.5 bps/year, 0.8 bps/year, 1.0 bps/year, 1.5 bps/year.'
    sql: audit_fee
  board_fee:
    description: 'TEXT. Board of directors fee with unit notation. Possible values: 0.1 bps/year, 0.2 bps/year, 0.3 bps/year, 0.4 bps/year, 0.5 bps/year.'
    sql: board_fee
  category_average_expense:
    description: 'TEXT. Category average expense ratio with unit notation. Possible values: 0.26%/year, 0.29%/year, 0.39%/year, 0.47%/year, 0.54%/year, 0.81%/year, 0.87%/year, 0.92%/year.'
    sql: category_average_expense
  change_reason:
    description: 'TEXT. Reason for expense change. Examples: Fee Reduction Program, Administrative Cost Increase, No Change.'
    sql: change_reason
  competitive_position:
    description: 'TEXT. Competitive position (Below Average, Average, Above Average). Possible values: Above Average, Below Average.'
    sql: competitive_position
  competitor_response:
    description: 'TEXT. Competitor response to expense changes. Examples: Matched Reduction, No Response, Considering Reduction.'
    sql: competitor_response
  custody_fee:
    description: 'TEXT. Custody fee with unit notation. Examples: 0.5 bps/year, 0.8 bps/year, 0.6 bps/year.'
    sql: custody_fee
  data_source:
    description: 'TEXT. Source of the expense data. **NULL means data source is not recorded or unknown.**. Possible values: BLOOMBERG TERMINAL, Bloomberg Terminal, REUTERS FEED, Reuters Feed, bloomberg terminal, reuters feed.'
    sql: data_source
  effective_date:
    description: 'DATE. Effective date of expense change. Examples: 2024-01-01, 2024-02-01, 2024-03-01.'
    sql: effective_date
  expense_change_from_previous:
    description: 'TEXT. Change from previous expense level with unit notation. Examples: -0.5 bps/change, 1.5 bps/change, 0.0 bps/change.'
    sql: expense_change_from_previous
  expense_change_percent:
    description: 'TEXT. Percentage change in expenses with unit notation. Examples: -3.2%/change, 3.4%/change, 0.0%/change.'
    sql: expense_change_percent
  expense_history_id:
    description: 'BIGSERIAL. Primary key identifier for expense evolution record. PK. Examples: 1, 2, 3.'
    sql: expense_history_id
  expense_impact_on_returns:
    description: 'TEXT. Impact of expenses on returns with unit notation. Examples: -0.02%/returns, -0.045%/returns, -0.025%/returns.'
    sql: expense_impact_on_returns
  expense_reimbursement:
    description: 'TEXT. Expense reimbursement amount with unit notation. Examples: 1.8 bps/year, 5.4 bps/year, 2.5 bps/year.'
    sql: expense_reimbursement
  flow_impact_estimate:
    description: 'TEXT. Estimated impact on fund flows with unit notation. Examples: 2.5%/flows, -1.8%/flows, 1.2%/flows.'
    sql: flow_impact_estimate
  fund_ticker:
    description: 'TEXT. Fund ticker symbol identifier. Examples: AVMU, QQD, FALN.'
    sql: fund_ticker
  gross_expense_ratio:
    description: 'TEXT. Gross expense ratio with unit notation. Examples: 0.17%/year, 0.51%/year, 0.278%/year.'
    sql: gross_expense_ratio
  last_updated:
    description: 'TEXT. Timestamp of last data update. Examples: 2024-01-01 09:00:00 AKST-9, 2024-02-01 10:30:00 AKST-9, 2024-03-01 14:15:00 AKST-9.'
    sql: last_updated
  legal_fee:
    description: 'TEXT. Legal fee with unit notation. Possible values: 0.2 bps/year, 0.3 bps/year, 0.5 bps/year, 0.6 bps/year, 0.8 bps/year.'
    sql: legal_fee
  management_fee:
    description: 'TEXT. Management fee with unit notation. Examples: 12.5 bps/year, 40.0 bps/year, 22.5 bps/year.'
    sql: management_fee
  management_fee_breakpoints:
    description: 'TEXT. Management fee breakpoint structure with unit notation. Examples: 0.125%/first $1B; 0.10%/next $4B, 0.40%/first $500M; 0.35%/over $500M, 0.225%/all assets.'
    sql: management_fee_breakpoints
  management_fee_waiver:
    description: 'TEXT. Management fee waiver amount with unit notation. Possible values: 0.2 bps/year, 0.3 bps/year, 0.4 bps/year, 0.6 bps/year, 1.0 bps/year, 1.8 bps/year, 8.3 bps/year.'
    sql: management_fee_waiver
  net_expense_ratio:
    description: 'TEXT. Net expense ratio with unit notation. Examples: 0.15%/year, 0.45%/year, 0.25%/year.'
    sql: net_expense_ratio
  other_expenses:
    description: 'TEXT. Other miscellaneous expenses with unit notation. Examples: 1.1 bps/year, 1.5 bps/year, 1.3 bps/year.'
    sql: other_expenses
  percentile_rank:
    description: 'TEXT. Percentile ranking of expenses with unit notation. Examples: 25 rank/100, 65 rank/100, 15 rank/100.'
    sql: percentile_rank
  performance_fee_rate:
    description: 'TEXT. Performance fee rate with unit notation. Possible values: 0 %/excess, 0.2 %/excess.'
    sql: performance_fee_rate
  performance_fee_threshold:
    description: 'TEXT. Performance fee threshold with unit notation. Possible values: 0 %/benchmark, 5.0 %/benchmark.'
    sql: performance_fee_threshold
  prospectus_disclosure:
    description: 'TEXT. Prospectus disclosure information. Examples: Updated fee disclosure, Standard disclosure language, Contractual fee waiver.'
    sql: prospectus_disclosure
  regulatory_requirement:
    description: 'TEXT. Regulatory requirements related to expense change. **NULL means no specific regulatory requirement applies.**. Examples: SEC Rule 30e-3, Investment Company Act, Expense Cap Agreement.'
    sql: regulatory_requirement
  sec_filing_date:
    description: 'DATE. SEC filing date for expense change. Examples: 2023-12-20, 2024-01-20, 2024-02-25.'
    sql: sec_filing_date
  total_expense_ratio:
    description: 'TEXT. Total expense ratio with unit notation. Examples: 0.15%/year, 0.45%/year, 0.25%/year.'
    sql: total_expense_ratio
  total_waivers:
    description: 'TEXT. Total fee waivers with unit notation. Examples: 2.0 bps/year, 6.0 bps/year, 2.8 bps/year.'
    sql: total_waivers
  transfer_agent_fee:
    description: 'TEXT. Transfer agent fee with unit notation. Examples: 0.8 bps/year, 1.2 bps/year, 0.9 bps/year.'
    sql: transfer_agent_fee
  waiver_expiration_date:
    description: 'DATE. Expiration date of fee waivers. Possible values: 2024-12-31, 2025-03-31, 2025-06-30, 2025-12-31, 2026-12-31.'
    sql: waiver_expiration_date
